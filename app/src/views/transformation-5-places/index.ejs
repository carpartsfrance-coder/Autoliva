<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%# Landing « Transformation 2 → 5 places » — voir controllers/transformation5PlacesController.js.
    Version simplifiée (16/11/2026) : formulaire court dans le haut de page (plaque, nom,
    téléphone ou e-mail) avec le prix de base, puis 4 blocs seulement. Styles limités à .t5p
    dans /css/transformation-5-places.css. Aucun téléphone : WhatsApp seulement.
    Qualification UTAC : confirmée par Killian le 15/11/2026. %>
<link rel="stylesheet" href="/css/transformation-5-places.css?v=6">
<script type="application/ld+json"><%- faqJsonLd %></script>

<% var fmt = function (n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' '); }; %>
<% var arrow = '<svg class="icon" aria-hidden="true"><use href="#t5p-arrow"/></svg>'; %>
<% var check = '<svg class="icon" aria-hidden="true"><use href="#t5p-check"/></svg>'; %>
<% var waIcon = '<svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.16-.17.2-.34.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.64-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.91-2.2-.24-.58-.49-.5-.66-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.8h-.01a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.72.98 1-3.63-.24-.37a9.78 9.78 0 0 1-1.5-5.22c0-5.41 4.41-9.82 9.83-9.82a9.76 9.76 0 0 1 6.95 2.88 9.76 9.76 0 0 1 2.87 6.95c0 5.42-4.41 9.81-9.82 9.81zm8.36-18.17A11.75 11.75 0 0 0 12.05.17C5.5.17.16 5.5.16 12.05c0 2.1.55 4.14 1.59 5.94L.06 24l6.16-1.62a11.84 11.84 0 0 0 5.83 1.48h.01c6.55 0 11.89-5.33 11.89-11.89 0-3.18-1.24-6.17-3.48-8.41z"/></svg>'; %>
<% var contactValue = form.contact || form.phone || form.email || ''; %>

<div class="t5p">
<svg class="svg-defs" aria-hidden="true"><defs><symbol id="t5p-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol><symbol id="t5p-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol><symbol id="t5p-pin" viewBox="0 0 24 24"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol><symbol id="t5p-shield" viewBox="0 0 24 24"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></symbol></defs></svg>

<main id="contenu">
<!-- 1. Haut de page : le message + le formulaire (fond sombre, photo assombrie) -->
<section class="hero hero-dark">
<div class="wrap breadcrumb"><a href="/">Accueil</a><span>›</span><span>Nos services</span><span>›</span><strong>Transformation 2 → 5 places</strong></div>
<div class="wrap hero-inner">
<div class="hero-copy">
<p class="service-tag"><span></span> TRANSFORMATION 2 → 5 PLACES · ROGNAC (13)</p>
<h1>Votre voiture<br>en 5 places.<br><span>À Rognac (13340).</span></h1>
<p class="hero-intro">Votre voiture de société est en 2 places ? On remonte la banquette et les ceintures, et on s’occupe de la carte grise.</p>
<div class="hero-price"><div><span>PRIX DE BASE</span><strong><%= fmt(pricing.unitTtc) %> € <small>TTC</small></strong></div><p>soit <%= fmt(pricing.unitHt) %> € HT<br>tout compris, hors taxes carte grise</p></div>
<ul class="hero-points">
<li><%- check %>Pièces d’origine, montage et dossier carte grise</li>
<li><%- check %>Atelier qualifié UTAC</li>
<li><%- check %>Réponse sous 24 h ouvrées</li>
</ul>
<p class="hero-location"><svg class="icon" aria-hidden="true"><use href="#t5p-pin"/></svg> <span><strong>Rognac · 13340</strong> — pour Vitrolles, Marignane, Aix, Marseille, Salon, Martigues et alentours</span></p>
</div>

<div class="form-card hero-form" id="formulaire">
<% if (successMessage) { %>
<div class="form-success" id="form-success" tabindex="-1">
<span class="success-icon"><%- check %></span>
<h3>Votre demande est envoyée.</h3>
<p><%= successMessage %></p>
<div class="success-box">Pour aller plus vite, envoyez-nous une photo de votre carte grise (recto) : c’est elle qui dit si la voiture peut repasser en 5 places.</div>
<a class="button whatsapp full" href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-wa-click="success"><%- waIcon %> Envoyer ma carte grise sur WhatsApp</a>
</div>
<% } else { %>
<form id="t5p-form" action="<%= formAction %>" method="post">
<input type="text" name="website" value="" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true">
<input type="hidden" name="profile" value="<%= form.profile %>" data-profile>
<input type="hidden" name="fleetSize" value="<%= form.fleetSize %>" data-fleet>
<fieldset>
<legend>Votre devis gratuit</legend>
<p class="form-subtitle">3 informations, et on vous répond sous 24 h ouvrées.</p>
<% if (errorMessage) { %><p class="form-error" role="alert" style="margin:16px 0 0"><%= errorMessage %></p><% } %>
<p class="form-error" data-pro-note <%= form.profile === 'pro' ? '' : 'hidden' %> style="margin:16px 0 0;background:#f7f8fa;border-color:#e6e9ee;color:#18212f">Demande professionnelle<span data-fleet-label><%= form.fleetSize && fleetSizes[form.fleetSize] ? ' · ' + fleetSizes[form.fleetSize] : '' %></span></p>
<label class="full-field">Plaque d’immatriculation<input id="t5p-plate" name="plate" required minlength="4" maxlength="17" placeholder="AB-123-CD" autocomplete="off" style="text-transform:uppercase" value="<%= form.plate %>"></label>
<label class="full-field">Votre nom<input id="t5p-name" name="fullName" autocomplete="name" maxlength="120" placeholder="Prénom et nom" value="<%= form.fullName %>"></label>
<label class="full-field">Téléphone ou e-mail<input id="t5p-contact" name="contact" required maxlength="160" autocomplete="on" placeholder="06 12 34 56 78 ou vous@exemple.fr" value="<%= contactValue %>"></label>
<div class="form-price"><strong><%= fmt(pricing.unitTtc) %> € TTC</strong> par véhicule (<%= fmt(pricing.unitHt) %> € HT)<br>Pièces d’origine d’occasion, montage et dossier carte grise compris. Taxes de carte grise en plus. Tarifs dégressifs pour les pros.</div>
<button type="submit" class="button orange full">Recevoir mon devis <%- arrow %></button>
<p class="form-caption">Gratuit et sans engagement. Vos coordonnées servent uniquement à vous répondre. <a href="/legal/confidentialite" style="text-decoration:underline">Confidentialité</a></p>
<p class="form-wa">Vous préférez écrire ? <a href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-wa-click="form">WhatsApp</a></p>
</fieldset>
</form>
<% } %>
</div>
</div></section>

<!-- 2. Ce qui est compris -->
<section class="section wrap" id="offre">
<div class="split">
<figure class="workshop-photo"><img src="/images/transformation-5-places/banquette-arriere.webp" width="1920" height="1288" alt="Banquette arrière trois places d’une citadine, photo d’illustration" loading="lazy" style="object-position:62% 50%"><figcaption>Photo d’illustration</figcaption></figure>
<div>
<div class="section-title"><h2>Ce qui est compris<br><span>dans le prix.</span></h2></div>
<article class="incl-row"><span><%- check %></span><div><h3>La banquette et les ceintures</h3><p>Banquette, ceintures et fixations adaptées à votre modèle. Pièces d’origine d’occasion.</p></div></article>
<article class="incl-row"><span><%- check %></span><div><h3>Le montage</h3><p>Installation et contrôles dans notre atelier de Rognac.</p></div></article>
<article class="incl-row"><span><%- check %></span><div><h3>La carte grise</h3><p>On prépare le dossier de conformité et on vous accompagne jusqu’à la nouvelle carte grise en 5 places.</p></div></article>
<div class="offer-total"><div><span>Prix de base</span><strong><%= fmt(pricing.unitTtc) %> € TTC <small>soit <%= fmt(pricing.unitHt) %> € HT</small></strong></div><a class="circle-link" href="#formulaire" aria-label="Demander mon devis"><%- arrow %></a></div>
<p class="fineprint">Prix final selon le véhicule et les pièces disponibles, écrit sur votre devis. Taxes et redevances de carte grise en plus.</p>
</div>
</div>
</section>

<!-- 3. Comment ça se passe -->
<section class="section bg-light" id="etapes"><div class="wrap">
<div class="split reverse">
<figure class="workshop-photo"><img src="/images/transformation-5-places/technicien-banquette.webp" width="1000" height="1491" alt="Technicien installant une banquette arrière, photo d’illustration" loading="lazy"><figcaption>Photo d’illustration</figcaption></figure>
<div>
<div class="section-title"><h2>Comment<br><span>ça se passe.</span></h2></div>
<article class="offer-row"><span>1</span><div><h3>Vous envoyez votre plaque</h3><p>On vérifie que votre voiture peut repasser en 5 places.</p></div></article>
<article class="offer-row"><span>2</span><div><h3>Vous recevez le devis</h3><p>Le prix, le délai et la référence de notre qualification UTAC.</p></div></article>
<article class="offer-row"><span>3</span><div><h3>On transforme, on s’occupe de la carte grise</h3><p>Vous repartez avec une voiture en 5 places et les papiers à jour.</p></div></article>
<div class="utac-line"><svg class="icon" aria-hidden="true"><use href="#t5p-shield"/></svg><div><strong>Atelier qualifié UTAC</strong><p>Nous réalisons la transformation et établissons les documents de conformité.</p></div><a href="https://www.utac.com/fr-fr/operateurs-qualifies" target="_blank" rel="noopener">Répertoire UTAC <%- arrow %></a></div>
</div>
</div>
</div></section>

<!-- 4. Professionnels -->
<section class="section pro-section" id="professionnels"><div class="wrap">
<div class="section-heading"><div><p class="eyebrow accent">GARAGES · NÉGOCIANTS · GESTIONNAIRES DE PARC</p><h2>Plusieurs véhicules ?<br><span>Le prix baisse.</span></h2></div><div class="pro-intro"><p>Prix par véhicule, pour un lot commandé ensemble. Chaque lot fait l’objet d’un devis détaillé.</p></div></div>
<div class="pricing-grid">
<% var tierButtons = { ponctuel: ['btn-outline', 'Demander un devis', '1-2'], lot: ['orange', 'Chiffrer mon lot', '3-5'], volume: ['btn-outline', 'Demander mon tarif', '6+'] }; %>
<% pricing.tiers.forEach(function (tier) { var b = tierButtons[tier.key] || ['btn-outline', 'Demander un devis', '']; %>
<article class="price-card<%= tier.featured ? ' featured' : '' %>"><% if (tier.featured) { %><span class="tier-ribbon">TARIF PAR LOT</span><% } %><h3><%= tier.range %></h3><p class="tier-price"><%= fmt(tier.ht) %> € <span>HT / véhicule</span></p><p class="tier-ttc"><%= fmt(tier.ttc) %> € TTC par véhicule</p><div class="tier-rule"></div><% if (tier.saving) { %><p><strong><%= tier.saving %></strong></p><% } else { %><p>Le tarif normal, sans remise.</p><% } %><a class="button <%= b[0] %>" href="?profil=pro#formulaire" data-pro-volume="<%= b[2] %>"><%= b[1] %> <%- arrow %></a></article>
<% }) %>
</div>
<div class="pro-bottom"><p>Sous réserve d’éligibilité et de disponibilité des pièces. TVA 20 %. Taxes de carte grise en plus.</p><a class="text-link" href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-wa-click="pro">Un besoin régulier ? WhatsApp <%- arrow %></a></div>
</div></section>

<!-- 5. Questions -->
<section class="faq-section" style="background:#fff"><div class="wrap faq-grid">
<div><h2>Vos questions.</h2></div>
<div class="faq-list"><% faq.forEach(function (item) { %><details><summary><%= item.q %><span>+</span></summary><p><%= item.a %></p></details><% }) %></div>
</div></section>

<section class="final-cta"><div class="wrap"><div><h2>Votre devis en 3 informations.</h2></div><div class="final-actions"><a class="button orange" href="#formulaire">Demander mon devis <%- arrow %></a><a class="button whatsapp" href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-wa-click="bottom"><%- waIcon %> WhatsApp</a></div></div></section>
</main>

<div class="mobile-cta"><div><span>Prix de base</span><strong><%= fmt(pricing.unitTtc) %> € <small>TTC</small></strong></div><a class="button orange" href="#formulaire">Mon devis gratuit <%- arrow %></a></div>
</div>

<script>
(function () {
  function q(sel) { return document.querySelector(sel); }
  var form = q('#t5p-form');
  var fleetLabels = <%- JSON.stringify(fleetSizes).replace(/</g, '\\u003c') %>;

  // Boutons des cartes pro : la demande part en « professionnel » avec le volume choisi.
  document.querySelectorAll('[data-pro-volume]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      if (!form) return;
      e.preventDefault();
      var v = a.getAttribute('data-pro-volume');
      q('[data-profile]').value = 'pro';
      q('[data-fleet]').value = v || '';
      var note = q('[data-pro-note]'); if (note) note.hidden = false;
      var lbl = q('[data-fleet-label]'); if (lbl) lbl.textContent = v && fleetLabels[v] ? ' · ' + fleetLabels[v] : '';
      q('#formulaire').scrollIntoView({ behavior: 'smooth' });
      var plate = q('#t5p-plate'); if (plate) plate.focus({ preventScroll: true });
    });
  });

  // Suivi des clics WhatsApp (événement dédié à ce test).
  document.querySelectorAll('[data-wa-click]').forEach(function (a) {
    a.addEventListener('click', function () {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'whatsapp_click_5places', placement: a.getAttribute('data-wa-click'), page_path: window.location.pathname });
    });
  });

  var ok = q('#form-success');
  if (ok) { ok.scrollIntoView({ block: 'center' }); }
  var err = form && form.querySelector('[role="alert"]');
  if (err) { q('#formulaire').scrollIntoView({ block: 'center' }); }
})();
</script>

<% if (successMessage && conversion && conversion.ref) { %>
<script>
(function () {
  var c = <%- JSON.stringify(conversion).replace(/</g, '\\u003c') %>;
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: 'lead_transformation_5places', lead_ref: c.ref, lead_profile: c.profile || '', page_path: window.location.pathname });
  var sendTo = <%- JSON.stringify(adsConversionSendTo || '').replace(/</g, '\\u003c') %>;
  if (sendTo && typeof gtag === 'function') {
    if (c.email || c.phone) {
      gtag('set', 'user_data', { email: c.email || undefined, phone_number: c.phone || undefined });
    }
    gtag('event', 'conversion', { send_to: sendTo, value: 1.0, currency: 'EUR', transaction_id: c.ref });
  }
})();
</script>
<% } %>

<%- include('../partials/footer') %>

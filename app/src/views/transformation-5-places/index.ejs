<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%# Landing « Transformation 2 → 5 places » — voir controllers/transformation5PlacesController.js.
    Style volontairement sobre (« comme un garage ») : fond clair, texte simple,
    vraies photos du site, pas de slogans ni d'effets. Aucun téléphone : WhatsApp seulement. %>
<script type="application/ld+json"><%- faqJsonLd %></script>

<style>
  @media (max-width: 1023px) {
    input:not([type="radio"]):not([type="checkbox"]), select, textarea { font-size: 16px !important; }
  }
  .t5p-faq summary::-webkit-details-marker { display: none; }
  .t5p-faq details[open] .t5p-chevron { transform: rotate(180deg); }
</style>

<% var fmt = function (n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' '); }; %>
<% var waIcon = '<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.16-.17.2-.34.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.64-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.91-2.2-.24-.58-.49-.5-.66-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.8h-.01a9.8 9.8 0 0 1-5-1.37l-.36-.21-3.72.98 1-3.63-.24-.37a9.78 9.78 0 0 1-1.5-5.22c0-5.41 4.41-9.82 9.83-9.82a9.76 9.76 0 0 1 6.95 2.88 9.76 9.76 0 0 1 2.87 6.95c0 5.42-4.41 9.81-9.82 9.81zm8.36-18.17A11.75 11.75 0 0 0 12.05.17C5.5.17.16 5.5.16 12.05c0 2.1.55 4.14 1.59 5.94L.06 24l6.16-1.62a11.84 11.84 0 0 0 5.83 1.48h.01c6.55 0 11.89-5.33 11.89-11.89 0-3.18-1.24-6.17-3.48-8.41z"/></svg>'; %>

<main class="bg-white text-slate-800">

<!-- En-tête de page + formulaire -->
<section class="border-b border-slate-200">
<div class="max-w-[1200px] mx-auto px-5 py-8 lg:py-12 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">

<div class="lg:col-span-7">
<nav class="text-xs text-slate-500 mb-4" aria-label="Fil d’Ariane"><a href="/" class="hover:underline">Accueil</a> › Passage 2 places → 5 places</nav>
<h1 class="text-3xl lg:text-4xl font-bold text-slate-900 leading-tight mb-4">Passage de 2 à 5 places pour voitures de société</h1>
<p class="text-base lg:text-lg text-slate-700 mb-4">Votre voiture est immatriculée en 2 places (carte grise <strong>dérivé VP</strong>, <strong>VASP</strong> ou <strong>CTTE</strong>) ? On remonte la banquette arrière et les ceintures, et on prépare le dossier pour passer la carte grise en 5 places.</p>
<p class="text-slate-700 mb-6">On est à Rognac (13), entre Marseille, Aix et Salon.</p>

<div class="border border-slate-200 rounded-md p-4 mb-6 max-w-xl">
<p class="text-slate-900"><span class="text-2xl font-bold"><%= fmt(pricing.unitTtc) %> € TTC</span> <span class="text-slate-500">(<%= fmt(pricing.unitHt) %> € HT)</span></p>
<p class="text-sm text-slate-600 mt-1">Pièces d’origine d’occasion, montage et dossier carte grise compris. Les taxes de la carte grise sont en plus. Prix pros dégressifs <a href="#pro" class="underline">plus bas</a>.</p>
</div>

<p class="text-sm text-slate-600">Une question avant de demander un devis ? <a href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-wa-click="intro" class="inline-flex items-center gap-1 font-semibold text-[#128C7E] hover:underline"><%- waIcon %> Écrivez-nous sur WhatsApp</a></p>

<figure class="mt-8 hidden lg:block">
<img src="/images/temoignages/installation-sun-motors.webp" alt="Un technicien Autoliva avec une pièce dans un garage" class="w-full h-72 object-cover rounded-md" width="1200" height="900">
<figcaption class="text-xs text-slate-500 mt-2">Un de nos techniciens sur une installation.</figcaption>
</figure>
</div>

<div id="devis" class="lg:col-span-5 scroll-mt-28">
<div class="border border-slate-300 rounded-md p-5 sm:p-6 bg-slate-50">

<% if (successMessage) { %>
<h2 class="text-xl font-bold text-slate-900 mb-3">Demande envoyée</h2>
<p class="text-sm text-slate-700 bg-white border border-emerald-300 rounded-md p-3"><%= successMessage %></p>
<p class="text-sm text-slate-700 mt-4">Pour aller plus vite, envoyez-nous une photo de votre carte grise (recto) : c’est elle qui dit si la voiture peut repasser en 5 places.</p>
<a href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-wa-click="success" class="mt-4 w-full inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1ebe5b] text-white font-semibold px-5 py-3 rounded-md"><%- waIcon %> Envoyer ma carte grise sur WhatsApp</a>
<% } else { %>

<h2 class="text-xl font-bold text-slate-900 mb-1">Demander un devis</h2>
<p class="text-sm text-slate-600 mb-5">Gratuit et sans engagement. On vous répond sous 24 h ouvrées.</p>

<% if (errorMessage) { %>
<p class="rounded-md bg-red-50 border border-red-200 p-3 mb-4 text-red-800 text-sm" role="alert"><%= errorMessage %></p>
<% } %>

<form action="<%= formAction %>" method="post" class="space-y-4" id="t5p-form">
<input type="text" name="website" value="" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true">

<fieldset>
<legend class="block text-sm font-medium text-slate-700 mb-1">Vous êtes</legend>
<div class="flex gap-5">
<% Object.keys(profiles).forEach(function (key) { %>
<label class="inline-flex items-center gap-2 text-sm"><input type="radio" name="profile" value="<%= key %>" class="text-slate-900 focus:ring-slate-500" <%= form.profile === key ? 'checked' : '' %>> <%= profiles[key] %></label>
<% }) %>
</div>
</fieldset>

<div data-pro-only class="<%= form.profile === 'pro' ? '' : 'hidden' %>">
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-fleet">Nombre de véhicules</label>
<select id="t5p-fleet" name="fleetSize" class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500">
<option value="">Choisir</option>
<% Object.keys(fleetSizes).forEach(function (key) { %><option value="<%= key %>" <%= form.fleetSize === key ? 'selected' : '' %>><%= fleetSizes[key] %></option><% }) %>
</select>
</div>

<div class="grid grid-cols-2 gap-3">
<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-make">Marque *</label>
<select id="t5p-make" name="make" required class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500">
<option value="">Choisir</option>
<% makes.forEach(function (m) { %><option value="<%= m %>" <%= form.make === m ? 'selected' : '' %>><%= m %></option><% }) %>
</select>
</div>
<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-model">Modèle *</label>
<input id="t5p-model" type="text" name="model" required maxlength="60" value="<%= form.model %>" placeholder="ex. Clio 5" class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500">
</div>
<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-year">Année</label>
<input id="t5p-year" type="text" inputmode="numeric" name="year" maxlength="4" value="<%= form.year %>" placeholder="ex. 2021" class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500">
</div>
<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-reg">Carte grise</label>
<select id="t5p-reg" name="regType" class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500">
<option value="">Choisir</option>
<% Object.keys(regTypes).forEach(function (key) { %><option value="<%= key %>" <%= form.regType === key ? 'selected' : '' %>><%= regTypes[key] %></option><% }) %>
</select>
</div>
<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-plate">Immatriculation</label>
<input id="t5p-plate" type="text" name="plate" maxlength="17" value="<%= form.plate %>" placeholder="AB-123-CD" class="w-full border-slate-300 rounded-md text-sm uppercase focus:ring-slate-500 focus:border-slate-500">
</div>
<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-cp">Code postal</label>
<input id="t5p-cp" type="text" inputmode="numeric" name="postcode" maxlength="5" value="<%= form.postcode %>" placeholder="13340" class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500">
</div>
</div>

<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-timing">Pour quand ?</label>
<select id="t5p-timing" name="timing" class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500">
<option value="">Choisir</option>
<% Object.keys(timings).forEach(function (key) { %><option value="<%= key %>" <%= form.timing === key ? 'selected' : '' %>><%= timings[key] %></option><% }) %>
</select>
</div>

<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-name">Nom</label>
<input id="t5p-name" type="text" name="fullName" maxlength="120" autocomplete="name" value="<%= form.fullName %>" class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500">
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-phone">Mobile *</label>
<input id="t5p-phone" type="tel" name="phone" required maxlength="24" autocomplete="tel" value="<%= form.phone %>" placeholder="06 12 34 56 78" class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500">
<p class="text-xs text-slate-500 mt-1">On vous répond par WhatsApp ou SMS.</p>
</div>
<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-email">E-mail</label>
<input id="t5p-email" type="email" name="email" maxlength="160" autocomplete="email" value="<%= form.email %>" class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500">
</div>
</div>
<div>
<label class="block text-sm font-medium text-slate-700 mb-1" for="t5p-msg">Autre chose à nous dire ?</label>
<textarea id="t5p-msg" name="message" rows="2" maxlength="1500" class="w-full border-slate-300 rounded-md text-sm focus:ring-slate-500 focus:border-slate-500"><%= form.message %></textarea>
</div>

<button type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-semibold py-3 rounded-md">Envoyer ma demande</button>
<p class="text-xs text-slate-500">Vos coordonnées servent uniquement à répondre à cette demande. <a class="underline" href="/legal/confidentialite">Confidentialité</a>.</p>
</form>
<% } %>
</div>
</div>

</div>
</section>

<!-- Contenu -->
<section>
<div class="max-w-[800px] mx-auto px-5 py-10 lg:py-14 space-y-12">

<div>
<h2 class="text-2xl font-bold text-slate-900 mb-4">Ce qui est compris dans le prix</h2>
<ul class="list-disc pl-5 space-y-2 text-slate-700">
<li>La banquette arrière, les ceintures et les fixations pour votre modèle (pièces d’origine, d’occasion).</li>
<li>Le montage et les contrôles.</li>
<li>Le dossier pour mettre à jour la carte grise en 5 places.</li>
</ul>
<p class="text-sm text-slate-600 mt-4">Pas compris : les taxes et redevances de la carte grise, qui sont payées à l’administration.</p>
</div>

<div>
<h2 class="text-2xl font-bold text-slate-900 mb-4">Comment ça se passe</h2>
<ol class="list-decimal pl-5 space-y-3 text-slate-700">
<li><strong>Vous nous envoyez votre demande</strong> avec le modèle, et si possible une photo de la carte grise. On vérifie que la voiture peut repasser en 5 places.</li>
<li><strong>On vous envoie le devis</strong> avec le prix, le délai et le nom de l’aménageur partenaire qui atteste la transformation.</li>
<li><strong>On fait la transformation</strong>, puis on s’occupe du dossier pour la carte grise.</li>
</ol>
<p class="text-sm text-slate-600 mt-4">Pourquoi la carte grise compte : si elle indique toujours 2 places, la voiture reste une 2 places pour l’assurance et le contrôle technique, même avec une banquette.</p>
</div>

<div id="pro" class="scroll-mt-28">
<h2 class="text-2xl font-bold text-slate-900 mb-2">Prix pour les professionnels</h2>
<p class="text-slate-700 mb-4">Garages, marchands VO, gestionnaires de parc : le prix baisse quand vous nous confiez plusieurs véhicules en même temps.</p>
<div class="overflow-x-auto">
<table class="w-full text-sm border border-slate-200">
<thead class="bg-slate-50 text-slate-700">
<tr><th class="text-left font-semibold px-4 py-3 border-b border-slate-200">Nombre de véhicules</th><th class="text-right font-semibold px-4 py-3 border-b border-slate-200">Prix par véhicule HT</th><th class="text-right font-semibold px-4 py-3 border-b border-slate-200">TTC</th></tr>
</thead>
<tbody>
<% pricing.tiers.forEach(function (tier) { %>
<tr class="border-b border-slate-200 last:border-0"><td class="px-4 py-3"><%= tier.range %></td><td class="px-4 py-3 text-right font-semibold text-slate-900"><%= fmt(tier.ht) %> €</td><td class="px-4 py-3 text-right text-slate-600"><%= fmt(tier.ttc) %> €</td></tr>
<% }) %>
</tbody>
</table>
</div>
<p class="text-sm text-slate-600 mt-3">Prix pour des véhicules confiés ensemble, selon le modèle et les pièces disponibles. Taxes de carte grise en plus. <a href="?profil=pro#devis" data-set-pro class="underline font-semibold text-slate-900">Demander un devis pro</a></p>
</div>

<div>
<h2 class="text-2xl font-bold text-slate-900 mb-4">Qui on est</h2>
<p class="text-slate-700 mb-5">Autoliva vend des pièces auto reconditionnées (moteurs, boîtes de vitesses, ponts, mécatroniques), depuis Rognac. Le passage en 5 places, c’est le même principe : les bonnes pièces pour votre modèle, bien montées, avec les papiers en règle.</p>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
<figure>
<img src="/images/temoignages/chargement-camion-autoliva.webp" alt="Un technicien Autoliva charge une pièce sur le camion" class="w-full h-56 object-cover rounded-md" loading="lazy" width="1200" height="900">
<figcaption class="text-xs text-slate-500 mt-2">Chargement d’une pièce chez Autoliva.</figcaption>
</figure>
<figure>
<img src="/images/hero-home.jpg" alt="Les locaux d’Autoliva" class="w-full h-56 object-cover rounded-md" loading="lazy" width="1360" height="765">
<figcaption class="text-xs text-slate-500 mt-2">Nos locaux.</figcaption>
</figure>
</div>
<p class="text-sm text-slate-600 mt-4">On intervient pour les clients de Rognac, Vitrolles, Marignane, Berre-l’Étang, Aix-en-Provence, Marseille, Salon-de-Provence, Martigues et alentours.</p>
</div>

<div class="t5p-faq">
<h2 class="text-2xl font-bold text-slate-900 mb-4">Questions fréquentes</h2>
<div class="border-t border-slate-200">
<% faq.forEach(function (item) { %>
<details class="border-b border-slate-200 py-4">
<summary class="flex items-center justify-between gap-4 cursor-pointer font-semibold text-slate-900 list-none"><span><%= item.q %></span><svg class="t5p-chevron w-4 h-4 shrink-0 text-slate-500 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06z" clip-rule="evenodd"/></svg></summary>
<p class="text-slate-700 mt-3"><%= item.a %></p>
</details>
<% }) %>
</div>
</div>

<div class="border border-slate-200 rounded-md p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
<p class="text-slate-800">Envoyez-nous le modèle de votre voiture, on vous répond sous 24 h ouvrées.</p>
<div class="flex gap-3">
<a href="#devis" class="inline-flex items-center justify-center whitespace-nowrap bg-primary hover:bg-primary-hover text-white font-semibold px-5 py-3 rounded-md">Demander un devis</a>
<a href="<%= whatsappUrl %>" target="_blank" rel="noopener" data-wa-click="bottom" class="inline-flex items-center justify-center gap-2 whitespace-nowrap border border-slate-300 hover:bg-slate-50 text-slate-800 font-semibold px-5 py-3 rounded-md"><%- waIcon %> WhatsApp</a>
</div>
</div>

</div>
</section>
</main>

<script>
(function () {
  // « Nombre de véhicules » seulement pour les professionnels.
  var form = document.getElementById('t5p-form');
  function syncPro() {
    if (!form) return;
    var pro = form.querySelector('input[name="profile"][value="pro"]');
    var box = form.querySelector('[data-pro-only]');
    if (box && pro) box.classList.toggle('hidden', !pro.checked);
  }
  if (form) form.addEventListener('change', function (e) { if (e.target && e.target.name === 'profile') syncPro(); });
  document.querySelectorAll('[data-set-pro]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      if (!form) return;
      var pro = form.querySelector('input[name="profile"][value="pro"]');
      if (pro) { e.preventDefault(); pro.checked = true; syncPro(); document.getElementById('devis').scrollIntoView({ behavior: 'smooth' }); }
    });
  });
  // Suivi des clics WhatsApp (événement dédié à ce test).
  document.querySelectorAll('[data-wa-click]').forEach(function (a) {
    a.addEventListener('click', function () {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'whatsapp_click_5places', placement: a.getAttribute('data-wa-click'), page_path: window.location.pathname });
    });
  });
})();
</script>

<% if (successMessage && conversion && conversion.ref) { %>
<script>
(function () {
  var c = <%- JSON.stringify(conversion).replace(/</g, '\\u003c') %>;
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: 'lead_transformation_5places', lead_ref: c.ref, lead_profile: c.profile || '', page_path: window.location.pathname });
  var sendTo = <%- JSON.stringify(adsConversionSendTo || '').replace(/</g, '\\u003c') %>;
  if (sendTo && typeof gtag === 'function') {
    if (c.email || c.phone) {
      gtag('set', 'user_data', { email: c.email || undefined, phone_number: c.phone || undefined });
    }
    gtag('event', 'conversion', { send_to: sendTo, value: 1.0, currency: 'EUR', transaction_id: c.ref });
  }
})();
</script>
<% } %>

<%- include('../partials/footer') %>

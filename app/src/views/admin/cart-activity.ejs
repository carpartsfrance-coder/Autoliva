<%- include('./partials/head') %>

<%- include('./partials/sidebar', { active: 'cart-activity' }) %>

<main class="flex-1 min-w-0">
  <div class="px-4 sm:px-6 lg:px-10 py-6 lg:py-8 max-w-[1400px]">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
      <div>
        <%- include('./partials/breadcrumb', { breadcrumbs: [{label: 'Leads à traiter'}] }) %>
        <h1 class="text-2xl md:text-3xl font-semibold text-slate-900">Leads à traiter</h1>
        <p class="mt-1 text-sm text-slate-500">Toutes les demandes clients au même endroit. Traite de haut en bas : la page te dit quoi faire et quand.</p>
      </div>
      <div class="flex flex-wrap gap-2 shrink-0">
        <button type="button" id="leads-help-btn" class="inline-flex items-center gap-1.5 rounded-xl px-3 py-2 text-xs font-semibold border border-slate-200 bg-white text-slate-600 hover:bg-slate-50">
          <span class="material-symbols-outlined text-base text-primary">school</span>Comment ça marche
        </button>
        <a href="/admin/parametres/modeles-messages" class="inline-flex items-center gap-1.5 rounded-xl px-3 py-2 text-xs font-semibold border border-slate-200 bg-white text-slate-600 hover:bg-slate-50" title="Personnaliser les textes des SMS et emails">
          <span class="material-symbols-outlined text-base text-primary">edit_note</span>Modèles de messages
        </a>
      </div>
    </div>

    <% if (view === 'todo' && bandeau) { %>
      <!-- Bandeau : l'état de la file en 4 chiffres (vue patron) -->
      <div class="mt-5 grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="rounded-2xl border <%= bandeau.enRetard ? 'border-red-200 bg-red-50' : 'border-slate-200 bg-white' %> p-4" title="Dossiers dont l'échéance est passée (y compris les anciens)">
          <div class="text-[11px] uppercase tracking-widest font-semibold <%= bandeau.enRetard ? 'text-red-600' : 'text-slate-400' %>">En retard</div>
          <div class="mt-1 text-2xl font-bold <%= bandeau.enRetard ? 'text-red-700' : 'text-slate-900' %>"><%= bandeau.enRetard %></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4" title="Demandes ouvertes sur lesquelles personne n'a encore appelé ni écrit (les messages automatiques ne comptent pas)">
          <div class="text-[11px] uppercase tracking-widest font-semibold text-slate-400">Jamais contactés</div>
          <div class="mt-1 text-2xl font-bold text-slate-900"><%= bandeau.jamaisPris %></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4" title="Nouvelles demandes, rappels et devis prévus aujourd'hui (hors retards)">
          <div class="text-[11px] uppercase tracking-widest font-semibold text-slate-400">À faire aujourd'hui</div>
          <div class="mt-1 text-2xl font-bold text-slate-900"><%= bandeau.duJour %></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4" title="Temps entre la demande du client et le premier appel ou message d'un commercial, en heures d'ouverture, sur les 30 derniers jours">
          <div class="text-[11px] uppercase tracking-widest font-semibold text-slate-400">1re réponse (30 j)</div>
          <% var dl = bandeau.delai || {}; var med = dl.mediane; %>
          <div class="mt-1 text-2xl font-bold text-slate-900">
            <% if (med === null || med === undefined) { %>—<% } else if (med < 60) { %><%= med %> min<% } else { %><%= Math.floor(med / 60) %> h <%= String(med % 60).padStart(2, '0') %><% } %>
          </div>
          <% if (dl.pctDansLHeure !== null && dl.pctDansLHeure !== undefined) { %><div class="text-xs text-slate-500"><%= dl.pctDansLHeure %> % rappelés dans l'heure</div><% } %>
        </div>
      </div>
      <% if (bandeau.parPersonne && bandeau.parPersonne.length) { %>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-slate-500">
          <span>Retards par personne :</span>
          <% bandeau.parPersonne.forEach(function (p) { %>
            <span class="inline-flex items-center rounded-full bg-white border border-slate-200 px-2 py-0.5"><strong class="text-slate-700 mr-1"><%= p.nom %></strong><%= p.n %></span>
          <% }) %>
        </div>
      <% } %>
    <% } else { %>
      <!-- Chiffres des 30 derniers jours (hors dossiers devis et robots) -->
      <div class="mt-5 grid grid-cols-2 lg:grid-cols-5 gap-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-4"><div class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold">Leads (30 j)</div><div class="mt-1 text-2xl font-bold text-slate-900"><%= kpis.total %></div></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4"><div class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold">Jamais contactés</div><div class="mt-1 text-2xl font-bold text-slate-900"><%= kpis.uncontacted %></div></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4"><div class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold">Contactés</div><div class="mt-1 text-2xl font-bold text-slate-900"><%= kpis.contacted %></div></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4"><div class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold">Convertis</div><div class="mt-1 text-2xl font-bold text-green-700"><%= kpis.converted %> <span class="text-sm font-medium">(<%= kpis.recoveryRate %> %)</span></div></div>
        <div class="rounded-2xl border border-slate-200 bg-white p-4" title="Somme des paniers non convertis — indicatif"><div class="text-[11px] uppercase tracking-widest text-slate-400 font-semibold">Paniers en attente</div><div class="mt-1 text-2xl font-bold text-slate-900"><%= kpis.pendingValue || '0,00 €' %></div></div>
      </div>
    <% } %>

    <!-- Onglets -->
    <div class="mt-5 flex flex-wrap items-center gap-2">
      <a href="<%= tabs.todoUrl %>" class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold border <%= view === 'todo' ? 'bg-slate-900 text-white border-slate-900' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
        À traiter
        <span class="inline-flex items-center justify-center rounded-full px-2 py-0.5 text-[11px] font-bold <%= view === 'todo' ? 'bg-white/20 text-white' : 'bg-red-50 text-red-700' %>"><%= tabs.todoCount %></span>
      </a>
      <a href="<%= tabs.allUrl %>" class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold border <%= view === 'all' ? 'bg-slate-900 text-white border-slate-900' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
        Tous les leads
        <span class="inline-flex items-center justify-center rounded-full px-2 py-0.5 text-[11px] font-bold <%= view === 'all' ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-600' %>"><%= tabs.allCount %></span>
      </a>
      <span class="text-xs text-slate-400 hidden md:inline">
        <% if (view === 'todo') { %>Les vraies demandes ouvertes, y compris les devis moteurs, boîtes et ponts. Les simples paniers et la newsletter sont dans « Tous les leads ».<% } else { %>Tout l'historique : paniers, newsletter, gagnés, perdus.<% } %>
      </span>
    </div>

    <% if (view === 'todo') { %>
      <!-- Filtres rapides de la file -->
      <form action="/admin/activite-panier" method="GET" class="mt-3 flex flex-col md:flex-row md:items-center gap-2 rounded-2xl border border-slate-200 bg-white p-3">
        <input type="text" name="q" value="" placeholder="Chercher un client : nom, tél, email, plaque, n° de commande…" class="flex-1 rounded-xl border border-slate-200 px-3 py-2 text-sm" />
        <div class="inline-flex shrink-0 rounded-xl border border-slate-200 p-0.5 text-xs font-semibold">
          <% [['', 'Tous'], ['moi', 'Mes dossiers'], ['libre', 'Non pris']].forEach(function (o) { %>
            <% var qs = new URLSearchParams(Object.assign({}, todoFilters.piece ? { piece: todoFilters.piece } : {}, todoFilters.source ? { source: todoFilters.source } : {}, o[0] ? { qui: o[0] } : {})).toString(); %>
            <a href="/admin/activite-panier<%= qs ? '?' + qs : '' %>" class="whitespace-nowrap rounded-lg px-3 py-1.5 <%= todoFilters.qui === o[0] ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-50' %>"><%= o[1] %></a>
          <% }) %>
        </div>
        <% if (todoFilters.qui) { %><input type="hidden" name="qui" value="<%= todoFilters.qui %>"><% } %>
        <select name="piece" class="rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white" onchange="this.form.q.value===''&&this.form.submit()">
          <option value="">Toutes les pièces</option>
          <option value="pont" <%= todoFilters.piece === 'pont' ? 'selected' : '' %>>Ponts / transferts</option>
          <option value="boite" <%= todoFilters.piece === 'boite' ? 'selected' : '' %>>Boîtes / mécatroniques</option>
          <option value="moteur" <%= todoFilters.piece === 'moteur' ? 'selected' : '' %>>Moteurs</option>
          <option value="autre" <%= todoFilters.piece === 'autre' ? 'selected' : '' %>>Autres</option>
        </select>
        <select name="source" class="rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white" onchange="this.form.q.value===''&&this.form.submit()">
          <option value="">Toutes les sources</option>
          <% [['landing_ponts', 'Landing ponts / transferts'], ['landing_boites', 'Landing boîtes'], ['landing_moteurs', 'Landing moteurs'], ['devis', 'Demande de devis (fiche produit)'], ['contact', 'Formulaire contact'], ['appel_manque', 'Appel manqué'], ['blog_cta', 'Article de blog'], ['landing_5places', 'Transformation 2 → 5 places'], ['manual', 'Ajouté à la main']].forEach(function (o) { %>
            <option value="<%= o[0] %>" <%= todoFilters.source === o[0] ? 'selected' : '' %>><%= o[1] %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-primary text-sm">OK</button>
        <% if (todoFilters.qui || todoFilters.piece || todoFilters.source) { %><a href="/admin/activite-panier" class="text-xs font-semibold text-slate-500 hover:text-slate-800 px-2">Effacer</a><% } %>
      </form>

      <!-- La file : groupes dans l'ordre où il faut les traiter -->
      <% var totalFile = groupes.reduce(function (n, g) { return n + g.count; }, 0); %>
      <% if (!totalFile) { %>
        <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-10 text-center">
          <span class="material-symbols-outlined text-emerald-500" style="font-size:44px">task_alt</span>
          <p class="mt-2 font-semibold text-slate-800">Rien à traiter pour l'instant.</p>
          <p class="text-sm text-slate-500">Les nouvelles demandes apparaîtront ici automatiquement.</p>
        </div>
      <% } %>
      <% var tons = { blue: 'text-blue-700 bg-blue-50 border-blue-200', red: 'text-red-700 bg-red-50 border-red-200', amber: 'text-amber-800 bg-amber-50 border-amber-200', orange: 'text-orange-800 bg-orange-50 border-orange-200', slate: 'text-slate-700 bg-slate-100 border-slate-200' }; %>
      <% groupes.forEach(function (g) { if (!g.count) return; %>
        <details class="lead-groupe mt-6" <%= g.collapsed ? '' : 'open' %> id="groupe-<%= g.key %>">
          <summary class="list-none cursor-pointer flex flex-wrap items-center gap-2 select-none">
            <span class="material-symbols-outlined text-slate-400 transition lead-groupe-chevron">expand_more</span>
            <h2 class="text-base font-bold text-slate-900"><%= g.label %></h2>
            <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-bold <%= tons[g.tone] || tons.slate %>"><%= g.count %></span>
            <span class="text-xs text-slate-500"><%= g.hint %></span>
          </summary>
          <ul class="mt-3 space-y-3">
            <% g.items.forEach(function (c) { %>
              <%- include('./partials/lead-card', { c: c }) %>
            <% }) %>
          </ul>
          <% if (g.reste > 0) { %>
            <% var qsv = new URLSearchParams(Object.assign({}, todoFilters.qui ? { qui: todoFilters.qui } : {}, todoFilters.piece ? { piece: todoFilters.piece } : {}, todoFilters.source ? { source: todoFilters.source } : {}, { voir: g.key })).toString(); %>
            <a href="/admin/activite-panier?<%= qsv %>#groupe-<%= g.key %>" class="mt-3 inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Afficher les <%= g.reste %> suivants <span class="material-symbols-outlined text-base">expand_more</span></a>
          <% } %>
        </details>
      <% }) %>
    <% } else { %>
    <!-- Filtres -->
    <form action="/admin/activite-panier" class="mt-4 bg-white rounded-2xl border border-slate-200 p-4 shadow-sm" method="GET">
      <input type="hidden" name="view" value="<%= view %>" />
      <div class="grid grid-cols-2 lg:grid-cols-7 gap-3">

        <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Email, nom, tél, n° commande, pièce…"
          title="Email, nom, prénom, téléphone (toutes graphies), numéro de commande ou de facture, pièce du panier, plaque, VIN, référence"
          class="col-span-2 lg:col-span-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20" />

        <select name="manual" class="rounded-xl border border-slate-200 pl-3 pr-8 py-2.5 text-sm bg-white">
          <option value="">Statut manuel: tous</option>
          <option value="none" <%= filters.manualStatus === 'none' ? 'selected' : '' %>>Non contacté</option>
          <option value="contacted" <%= filters.manualStatus === 'contacted' ? 'selected' : '' %>>Contacté</option>
          <option value="converted" <%= filters.manualStatus === 'converted' ? 'selected' : '' %>>Converti</option>
          <option value="lost" <%= filters.manualStatus === 'lost' ? 'selected' : '' %>>Perdu</option>
        </select>

        <select name="source" class="rounded-xl border border-slate-200 px-3 py-2.5 text-sm bg-white">
          <option value="">Source: toutes</option>
          <option value="user" <%= filters.captureSource === 'user' ? 'selected' : '' %>>Compte client</option>
          <option value="guest_checkout" <%= filters.captureSource === 'guest_checkout' ? 'selected' : '' %>>Guest checkout</option>
          <option value="devis" <%= filters.captureSource === 'devis' ? 'selected' : '' %>>Demande devis</option>
          <option value="landing_moteurs" <%= filters.captureSource === 'landing_moteurs' ? 'selected' : '' %>>Landing Moteurs occasion</option>
          <option value="landing_boites" <%= filters.captureSource === 'landing_boites' ? 'selected' : '' %>>Landing Boîtes occasion</option>
          <option value="landing_ponts" <%= filters.captureSource === 'landing_ponts' ? 'selected' : '' %>>Landing Ponts / Transfert</option>
          <option value="landing_5places" <%= filters.captureSource === 'landing_5places' ? 'selected' : '' %>>Landing 2 → 5 places</option>
          <option value="contact" <%= filters.captureSource === 'contact' ? 'selected' : '' %>>Contact</option>
          <option value="newsletter" <%= filters.captureSource === 'newsletter' ? 'selected' : '' %>>Newsletter</option>
          <option value="cart_activity" <%= filters.captureSource === 'cart_activity' ? 'selected' : '' %>>Panier</option>
          <option value="blog_cta" <%= filters.captureSource === 'blog_cta' ? 'selected' : '' %>>Article blog</option>
        </select>

        <select name="channel" class="rounded-xl border border-slate-200 px-3 py-2.5 text-sm bg-white">
          <option value="">Canal: tous</option>
          <option value="email" <%= filters.channel === 'email' ? 'selected' : '' %>>Email dispo</option>
          <option value="phone" <%= filters.channel === 'phone' ? 'selected' : '' %>>Tél dispo</option>
          <option value="both" <%= filters.channel === 'both' ? 'selected' : '' %>>Email + Tél</option>
        </select>

        <select name="period" class="rounded-xl border border-slate-200 px-3 py-2.5 text-sm bg-white">
          <option value="7d" <%= filters.period === '7d' ? 'selected' : '' %>>7 jours</option>
          <option value="30d" <%= !filters.period || filters.period === '30d' ? 'selected' : '' %>>30 jours</option>
          <option value="90d" <%= filters.period === '90d' ? 'selected' : '' %>>90 jours</option>
        </select>

        <select name="sort" class="rounded-xl border border-slate-200 px-3 py-2.5 text-sm bg-white">
          <option value="recent" <%= !filters.sort || filters.sort === 'recent' ? 'selected' : '' %>>Récent ↓</option>
          <option value="amount" <%= filters.sort === 'amount' ? 'selected' : '' %>>Montant ↓</option>
          <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Ancien ↑</option>
        </select>

      </div>
      <div class="mt-3 flex items-center gap-2">
        <button class="btn btn-primary text-sm" type="submit">Appliquer</button>
        <a href="/admin/activite-panier?view=all" class="btn btn-ghost text-sm">Réinitialiser</a>
      </div>

      <% if (filters.q) { %>
        <div class="mt-3 flex flex-wrap items-center gap-2 rounded-xl border border-blue-200 bg-blue-50 px-3 py-2 text-xs text-blue-900">
          <span class="material-symbols-outlined text-sm">search</span>
          <span>Recherche « <strong><%= filters.q %></strong> » sur <strong>tout l'historique</strong>, tous statuts confondus — la période et la file « À traiter » ne s'appliquent pas.</span>
          <a href="/admin/activite-panier?view=all" class="ml-auto font-semibold underline">Effacer</a>
        </div>
      <% } %>
    </form>


      <!-- Tous les leads -->
      <div class="mt-5 flex items-center justify-between text-sm">
        <div class="font-semibold text-slate-900"><%= pagination.totalItems %> lead<%= pagination.totalItems > 1 ? 's' : '' %></div>
        <% if (pagination.totalItems > 0) { %><div class="text-xs text-slate-500"><%= pagination.from %>–<%= pagination.to %></div><% } %>
      </div>
      <% if (leads && leads.length) { %>
        <ul class="mt-3 space-y-3">
          <% leads.forEach(function (c) { %>
            <%- include('./partials/lead-card', { c: c }) %>
          <% }) %>
        </ul>
      <% } else { %>
        <div class="mt-3 rounded-2xl border border-slate-200 bg-white p-12 text-center">
          <span class="material-symbols-outlined text-slate-300" style="font-size:48px">inbox</span>
          <p class="mt-3 text-slate-500">Aucun lead ne correspond aux filtres.</p>
          <a href="/admin/activite-panier?view=all" class="mt-2 inline-block text-sm text-primary hover:underline">Réinitialiser les filtres</a>
        </div>
      <% } %>
      <% if (pagination.totalPages > 1) { %>
        <div class="mt-4 flex items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Page <%= pagination.page %> / <%= pagination.totalPages %></div>
          <div class="flex items-center gap-2">
            <% if (pagination.hasPrev) { %><a href="?<%= filtersQS ? filtersQS + '&' : '' %>page=<%= pagination.prevPage %>" class="btn btn-ghost text-xs">← Précédent</a><% } %>
            <% if (pagination.hasNext) { %><a href="?<%= filtersQS ? filtersQS + '&' : '' %>page=<%= pagination.nextPage %>" class="btn btn-ghost text-xs">Suivant →</a><% } %>
          </div>
        </div>
      <% } %>
    <% } %>

    <% if (!dbConnected) { %>
      <div class="mt-8 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-900">
        <div class="font-bold">Mode démo</div>
        <div class="mt-1 text-sm">Base de données indisponible.</div>
      </div>
    <% } %>
  </div>
</main>

<!-- Modal: guide « Comprendre cette page » (formation commercial) -->
<div id="leads-help-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50" id="leads-help-overlay"></div>
  <div class="absolute right-0 top-0 h-full w-full max-w-2xl bg-white shadow-2xl overflow-y-auto">
    <div class="p-6">
      <div class="flex items-center justify-between mb-1">
        <div class="text-lg font-bold text-slate-900">📖 Comment ça marche</div>
        <button type="button" id="leads-help-close" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center"><span class="material-symbols-outlined">close</span></button>
      </div>
      <p class="text-sm text-slate-500 mb-5">La page te dit quoi faire et quand. Tu traites de haut en bas, tu ne te poses pas de question.</p>

      <div class="rounded-xl border-2 border-primary/30 bg-red-50/40 p-4 mb-4">
        <div class="text-xs font-bold uppercase tracking-widest text-primary mb-2">🎯 La méthode en 4 gestes</div>
        <ol class="text-sm text-slate-800 space-y-2 list-decimal list-inside">
          <li><strong>Commence en haut</strong> : « Nouvelles demandes », puis « En retard », puis « Rappels du jour » et « Devis à préparer ».</li>
          <li><strong>Clique sur le gros bouton vert « Appeler »</strong> : le numéro est copié et l'appel se lance. Une fenêtre s'ouvre pour noter le résultat.</li>
          <li><strong>Note toujours le résultat</strong> (joint, pas de réponse, messagerie, mauvais numéro) <strong>et la suite</strong> (devis, rappel le…, perdu). Sans suite, le client serait oublié : la page t'oblige à la choisir.</li>
          <li><strong>Gagné</strong> seulement quand le client a payé. <strong>Perdu</strong> toujours avec le motif. Les deux sont dans « Autres ».</li>
        </ol>
      </div>

      <div class="rounded-xl border border-slate-200 p-4 mb-4">
        <div class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">🗂 Les groupes</div>
        <div class="text-sm text-slate-700 space-y-1.5">
          <div><strong>Nouvelles demandes</strong> — à rappeler dans l'heure (heures d'ouverture : 9 h–12 h, 14 h–18 h, du lundi au vendredi).</div>
          <div><strong>En retard</strong> — l'heure prévue est passée. À faire juste après les nouvelles demandes.</div>
          <div><strong>Rappels et relances du jour</strong> — les appels promis, les devis à relancer.</div>
          <div><strong>Devis à préparer</strong> — identifier la pièce, trouver le prix, envoyer le devis (bouton orange → dossier devis).</div>
          <div><strong>Planifiés</strong> — prévus un autre jour : rien à faire maintenant.</div>
          <div><strong>Anciens dossiers à reprendre</strong> — en retard depuis plus de 7 jours ouvrés. On les reprend quand le reste est fait : relire, rappeler ou clôturer.</div>
        </div>
      </div>

      <div class="rounded-xl border border-slate-200 p-4 mb-4">
        <div class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">🏷 Les étiquettes</div>
        <div class="text-sm text-slate-700 space-y-1.5">
          <div><span class="rounded-full bg-red-600 text-white px-2 py-0.5 text-xs font-bold">En retard de 2 h</span> l'urgence · <span class="rounded-full bg-blue-100 text-blue-800 px-2 py-0.5 text-xs font-semibold">Nouveau</span> l'étape où en est le client.</div>
          <div><strong>Étapes</strong> : Nouveau → En cours → Devis à préparer → Devis envoyé → Gagné ou Perdu.</div>
          <div><strong>Pris par Faniry</strong> : qui s'occupe du client. « Non pris — je m'en occupe » pour le prendre.</div>
          <div><strong>Google Ads</strong> : la demande vient d'une annonce payée. <strong>Déjà client</strong> / <strong>SAV en cours</strong> : à savoir avant d'appeler.</div>
        </div>
      </div>

      <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 mb-4">
        <div class="text-xs font-bold uppercase tracking-widest text-amber-700 mb-2">⚖️ Appeler un particulier</div>
        <div class="text-sm text-amber-900">Depuis le 11 août 2026, on n'appelle un particulier que pour <strong>répondre à sa demande</strong> (devis, formulaire, appel manqué). C'est pour ça que le bouton « Appeler » n'apparaît pas sur un simple panier abandonné ou une inscription newsletter : ces contacts sont dans « Tous les leads ».</div>
      </div>

      <div class="rounded-xl border border-slate-200 p-4">
        <div class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">❓ Et les autres onglets ?</div>
        <div class="text-sm text-slate-700 space-y-1.5">
          <div><strong>Tous les leads</strong> : l'historique complet (paniers, newsletter, gagnés, perdus) avec la recherche et les filtres.</div>
          <div><strong>Devis moteurs &amp; boîtes</strong> : l'atelier pour construire un devis (identification, prix, marge, PDF). Les demandes y arrivent ET apparaissent ici : rien ne peut être oublié.</div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Modal: action (email / sms / detail) -->
<div id="lead-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50" id="lead-modal-overlay"></div>
  <div class="absolute right-0 top-0 h-full w-full max-w-xl bg-white shadow-2xl overflow-y-auto">
    <div class="p-6">
      <div class="flex items-center justify-between mb-6">
        <div id="lead-modal-title" class="text-lg font-semibold text-slate-900">Détail du lead</div>
        <button type="button" id="lead-modal-close" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div id="lead-modal-content"><div class="text-sm text-slate-500">Chargement...</div></div>
    </div>
  </div>
</div>

<script>
(function () {
  var BRAND = <%- JSON.stringify(typeof brand !== 'undefined' ? brand.NAME : 'Autoliva') %>;

  var modal = document.getElementById('lead-modal');
  var overlay = document.getElementById('lead-modal-overlay');
  var closeBtn = document.getElementById('lead-modal-close');
  var content = document.getElementById('lead-modal-content');
  var title = document.getElementById('lead-modal-title');

  function openModal(t) { if (t) title.textContent = t; modal.classList.remove('hidden'); }
  function closeModal() { modal.classList.add('hidden'); }
  if (overlay) overlay.addEventListener('click', closeModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);

  // ─ Guide « Comprendre cette page » ─
  var helpModal = document.getElementById('leads-help-modal');
  var helpBtn = document.getElementById('leads-help-btn');
  if (helpBtn && helpModal) {
    helpBtn.addEventListener('click', function () { helpModal.classList.remove('hidden'); });
    ['leads-help-overlay', 'leads-help-close'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('click', function () { helpModal.classList.add('hidden'); });
    });
  }

  /* Anti double envoi : un 2e clic (ou Entrée) pendant l'envoi faisait partir
     un 2e e-mail / SMS au client. Bouton bloqué jusqu'à la réponse ; réactivé
     seulement en cas d'échec. */
  function verrouEnvoi(form) {
    if (form.dataset.envoiEnCours === '1') return null;
    form.dataset.envoiEnCours = '1';
    var btn = form.querySelector('button[type="submit"]');
    var libelle = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; btn.classList.add('opacity-60', 'cursor-not-allowed'); }
    return {
      echec: function () {
        form.dataset.envoiEnCours = '';
        if (btn) { btn.disabled = false; btn.classList.remove('opacity-60', 'cursor-not-allowed'); btn.innerHTML = libelle; }
      },
    };
  }

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  }

  function refresh() { window.location.reload(); }

  // ─ Copier le numéro (le commercial appelle depuis son logiciel, pas le tel: du PC) ─
  function fallbackCopyText(text) {
    try {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.top = '-1000px'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.focus(); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta);
      return true;
    } catch (_) { return false; }
  }
  document.addEventListener('click', function (e) {
    var el = e.target.closest ? e.target.closest('[data-copy-phone]') : null;
    if (!el) return;
    var num = el.getAttribute('data-copy-phone') || '';
    if (!num) return;
    var ok = function () { showToast('Numéro copié — collez-le dans votre logiciel d’appel'); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(num).then(ok).catch(function () { if (fallbackCopyText(num)) ok(); });
    } else if (fallbackCopyText(num)) { ok(); }
  });

  // ─ Statut manuel rapide ─
  document.querySelectorAll('.lead-status-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var leadId = btn.dataset.leadId;
      var status = btn.dataset.status;
      var alreadyActive = btn.classList.contains('font-semibold');
      var newStatus = alreadyActive ? null : status;
      /* « Gagné » / « Perdu » sortent le lead de « À traiter » et coupent les relances :
         on confirme (un clic à côté suffisait). « Contacté » et les annulations restent directs. */
      var question = newStatus === 'converted'
        ? 'Marquer ce lead « Gagné » ? Il sort de « À traiter » et les relances automatiques s’arrêtent.'
        : (newStatus === 'lost' ? 'Marquer ce lead « Perdu » ? Il sort de « À traiter » et les relances automatiques s’arrêtent.' : '');
      var confirmer = !question ? Promise.resolve(true)
        : (window.adminConfirm ? window.adminConfirm(question) : Promise.resolve(window.confirm(question)));
      Promise.resolve(confirmer).then(function (oui) {
      if (!oui) return;
      // Un seul changement à la fois pour ce lead (deux clics rapides pouvaient se croiser).
      var boutonsLead = document.querySelectorAll('.lead-status-btn[data-lead-id="' + leadId + '"]');
      if (btn.disabled) return;
      Array.prototype.forEach.call(boutonsLead, function (b) { b.disabled = true; });
      var relacherLead = function () { Array.prototype.forEach.call(boutonsLead, function (b) { b.disabled = false; }); };
      fetch('/admin/api/leads/' + leadId + '/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus }),
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.ok) refresh();
          else { relacherLead(); alert('Erreur: ' + (data && data.error ? data.error : 'inconnue')); }
        })
        .catch(function () { relacherLead(); alert('Erreur réseau'); });
      });
    });
  });

  // ─ Detail ─
  document.querySelectorAll('.lead-detail-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var leadId = btn.dataset.leadId;
      openModal('Détail du lead');
      content.innerHTML = '<div class="text-sm text-slate-500">Chargement...</div>';
      fetch('/admin/activite-panier/' + leadId, { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.ok || !data.cart) { content.innerHTML = '<div class="text-sm text-red-500">Erreur de chargement.</div>'; return; }
          var c = data.cart;
          var html = '<div class="space-y-4">';
          html += '<div class="rounded-xl border border-slate-200 p-4"><div class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-2">Client</div>';
          html += '<div class="font-semibold text-slate-900">' + escapeHtml(((c.firstName || '') + ' ' + (c.lastName || '')).trim() || c.email || '—') + '</div>';
          if (c.email) html += '<div class="text-sm"><a href="mailto:' + escapeHtml(c.email) + '" class="text-primary hover:underline">' + escapeHtml(c.email) + '</a></div>';
          if (c.phone) html += '<div class="text-sm"><button type="button" data-copy-phone="' + escapeHtml(c.phone) + '" class="inline-flex items-center gap-1 text-primary hover:underline cursor-pointer" title="Copier le numéro"><span class="material-symbols-outlined text-[13px]">content_copy</span>' + escapeHtml(c.phone) + '</button></div>';
          html += '<div class="text-xs text-slate-500 mt-1">Source : ' + escapeHtml(c.captureSourceLabel || '—') + '</div>';
          if (c.attribution && c.attribution.source) html += '<div class="text-xs text-slate-500">Attribution : ' + escapeHtml(c.attribution.source) + (c.attribution.medium ? ' / ' + escapeHtml(c.attribution.medium) : '') + '</div>';
          html += '</div>';

          // ─ Demande explicite (devis/contact) ─
          if (c.hasRequested) {
            html += '<div class="rounded-xl border border-teal-200 bg-teal-50/40 p-4">';
            html += '<div class="text-xs font-semibold uppercase tracking-widest text-teal-700 mb-2">📨 Demande explicite</div>';
            if (c.requested.ref) html += '<div class="text-sm"><span class="text-slate-500">Référence : </span><span class="font-medium text-slate-900">' + escapeHtml(c.requested.ref) + '</span></div>';
            if (c.requested.vehicle) html += '<div class="text-sm"><span class="text-slate-500">Véhicule : </span><span class="font-medium text-slate-900">' + escapeHtml(c.requested.vehicle) + '</span></div>';
            if (c.requested.vin) html += '<div class="text-sm"><span class="text-slate-500">VIN : </span><span class="font-mono text-slate-900">' + escapeHtml(c.requested.vin) + '</span></div>';
            if (c.requested.plate) html += '<div class="text-sm"><span class="text-slate-500">Immat : </span><span class="font-mono text-slate-900">' + escapeHtml(c.requested.plate) + '</span></div>';
            if (c.requested.message) html += '<div class="mt-2 text-sm text-slate-700 italic">"' + escapeHtml(c.requested.message) + '"</div>';
            html += '</div>';
          }

          // ─ 360° client : commandes passées ─
          if (c.clientOrders && c.clientOrders.length) {
            html += '<div class="rounded-xl border border-indigo-200 bg-indigo-50/40 p-4">';
            html += '<div class="text-xs font-semibold uppercase tracking-widest text-indigo-700 mb-3">🛍 Déjà client — ' + c.clientOrders.length + ' commande' + (c.clientOrders.length > 1 ? 's' : '') + '</div>';
            c.clientOrders.forEach(function (o) {
              html += '<div class="py-2 border-b border-indigo-100 last:border-0">';
              html += '<div class="flex items-center justify-between gap-2 text-sm">';
              html += '<a href="' + escapeHtml(o.url) + '" class="font-semibold text-indigo-800 hover:underline">n°' + escapeHtml(o.number) + '</a>';
              html += '<span class="font-bold text-slate-900">' + escapeHtml(o.totalEuro) + '</span></div>';
              html += '<div class="text-xs text-slate-600 mt-0.5">' + escapeHtml(o.date) + ' · <span class="font-medium">' + escapeHtml(o.status) + '</span></div>';
              if (o.products) html += '<div class="text-xs text-slate-500 mt-0.5">' + escapeHtml(o.products) + '</div>';
              html += '</div>';
            });
            html += '</div>';
          } else if (c.clientOrders) {
            html += '<div class="rounded-xl border border-slate-200 p-4 text-sm text-slate-500">🆕 Jamais commandé chez nous (aucune commande trouvée avec cet email / ce téléphone).</div>';
          }

          // ─ 360° client : tickets SAV ─
          if (c.savTickets && c.savTickets.length) {
            html += '<div class="rounded-xl border border-amber-200 bg-amber-50/40 p-4">';
            html += '<div class="text-xs font-semibold uppercase tracking-widest text-amber-700 mb-3">🛠 Tickets SAV (' + c.savTickets.length + ')</div>';
            c.savTickets.forEach(function (t) {
              html += '<div class="flex items-center justify-between gap-2 py-1.5 border-b border-amber-100 last:border-0 text-sm">';
              html += '<a href="' + escapeHtml(t.url) + '" class="font-semibold text-amber-800 hover:underline">' + escapeHtml(t.numero) + '</a>';
              html += '<span class="text-xs ' + (t.open ? 'font-bold text-amber-700' : 'text-slate-500') + '">' + escapeHtml(t.statut) + (t.open ? ' · en cours' : '') + '</span>';
              html += '<span class="text-xs text-slate-400">' + escapeHtml(t.date) + '</span></div>';
            });
            html += '</div>';
          }

          if (c.contextMessage) {
            html += '<div class="rounded-xl border border-slate-200 p-4"><div class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-2">Notes contextuelles</div>';
            html += '<div class="text-sm text-slate-700 whitespace-pre-line">' + escapeHtml(c.contextMessage) + '</div></div>';
          }

          if (c.items && c.items.length) {
            html += '<div class="rounded-xl border border-slate-200 p-4"><div class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-3">Articles (' + c.items.length + ')</div>';
            c.items.forEach(function (it) {
              html += '<div class="flex items-start gap-3 py-2 border-b border-slate-100 last:border-0">';
              if (it.image) html += '<img src="' + escapeHtml(it.image) + '" alt="" class="w-12 h-12 rounded-lg object-cover flex-shrink-0" />';
              else html += '<div class="w-12 h-12 rounded-lg bg-slate-100 flex-shrink-0"></div>';
              html += '<div class="flex-1 min-w-0"><div class="font-semibold text-slate-900 text-sm">' + escapeHtml(it.name) + '</div>';
              if (it.sku) html += '<div class="text-xs text-slate-400">Réf : ' + escapeHtml(it.sku) + '</div>';
              if (it.optionsSummary) html += '<div class="text-xs text-slate-500">' + escapeHtml(it.optionsSummary) + '</div>';
              html += '<div class="text-xs text-slate-500">Qté ' + it.quantity + ' · ' + escapeHtml(it.price) + '</div></div></div>';
            });
            html += '<div class="pt-3 flex justify-between items-center"><div class="font-semibold text-slate-900">Total</div><div class="font-bold text-slate-900">' + escapeHtml(c.totalAmount) + '</div></div></div>';
          }

          /* ── Demande fournisseur ────────────────────────────────────────
             Le commercial doit interroger Asysum avant de chiffrer.

             RIEN N'EST PRÉSÉLECTIONNÉ. Une version précédente devinait le
             destinataire et le nom de la pièce : elle s'est trompée deux fois
             en production. Le commercial choisit, le code rédige. Les libellés
             connus (formulaire de devis, articles du panier) sont offerts en
             raccourcis de saisie — proposer un texte qu'on lit avant de le
             valider n'engage rien ; présélectionner un destinataire qu'on ne
             relit pas envoie un e-mail au mauvais fournisseur. */
          if (c.fournisseur && c.fournisseur.demandes) {
            var F = c.fournisseur;
            html += '<div class="rounded-xl border border-slate-200 p-4" id="lead-fournisseur">';
            html += '<div class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-3">Demande fournisseur</div>';

            html += '<div class="flex items-center gap-2 flex-wrap mb-2">';
            html += '<select id="fourn-cible" class="rounded-lg border border-slate-200 px-2 py-1.5 text-sm">';
            html += '<option value="" selected>— choisir le destinataire —</option>';
            ['moteurs', 'boites', 'injection', 'ponts'].forEach(function (k) {
              var d = F.demandes[k];
              if (!d) return;
              html += '<option value="' + k + '">'
                + escapeHtml(d.libelle + ' — ' + d.contact) + '</option>';
            });
            html += '</select>';
            html += '<span id="fourn-mail" class="text-xs text-slate-500"></span>';
            html += '</div>';

            /* Pièce saisie à la main. Les raccourcis en dessous remplissent le
               champ d'un clic, mais restent modifiables : le libellé catalogue
               n'est pas toujours ce qu'il faut écrire au fournisseur. */
            html += '<div class="mb-2">';
            html += '<input id="fourn-piece" type="text" maxlength="200" placeholder="Pièce demandée (ex. culasse Mazda CX-5 2.2D)" '
              + 'class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" />';
            if (F.suggestions && F.suggestions.length) {
              html += '<div class="flex items-start gap-2 flex-wrap mt-1.5">';
              html += '<span class="text-xs text-slate-400 pt-0.5">Demandé par le client :</span>';
              F.suggestions.forEach(function (s, i) {
                html += '<button type="button" class="fourn-sugg rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-2 py-1 text-left" '
                  + 'data-i="' + i + '">' + escapeHtml(s.length > 70 ? s.slice(0, 69) + '…' : s) + '</button>';
              });
              html += '</div>';
            }
            html += '</div>';

            /* Le VIN n'est réclamé que par Jose Angel. On ne l'a quasiment
               jamais : le commercial le convertit depuis la plaque. */
            html += '<div id="fourn-vin-bloc" class="mb-2 hidden">';
            html += '<div class="flex items-center gap-2 flex-wrap">';
            html += '<input id="fourn-vin" type="text" maxlength="20" placeholder="VIN (17 caractères)" '
              + 'class="rounded-lg border border-slate-200 px-2 py-1.5 text-sm font-mono uppercase" />';
            html += '<a href="' + escapeHtml(F.lienVin) + '" target="_blank" rel="noopener" '
              + 'class="text-xs text-primary hover:underline">convertir la plaque en VIN ↗</a>';
            html += '</div>';
            html += '<div class="text-xs text-slate-400 mt-1">Ce fournisseur demande le VIN. Sans lui, la demande part incomplète.</div>';
            html += '</div>';

            /* Références pompe / injecteurs : réclamées par Sergi seulement.
               Saisie manuelle, jamais reprise du dossier — la référence citée
               par le client est précisément celle dont il n'est pas sûr. */
            html += '<div id="fourn-refs-bloc" class="mb-2 hidden">';
            html += '<input id="fourn-refs" type="text" maxlength="120" placeholder="Références pompe et/ou injecteurs" '
              + 'class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm font-mono" />';
            html += '<div class="text-xs text-slate-400 mt-1">Ce fournisseur demande les références. Ne reprends pas celle du client sans l\'avoir vérifiée.</div>';
            html += '</div>';

            html += '<textarea id="fourn-corps" rows="10" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm font-mono"></textarea>';
            html += '<div class="flex items-center gap-2 flex-wrap mt-2">';
            html += '<button type="button" id="fourn-copier" class="btn btn-primary text-xs">Copier</button>';
            html += '<a id="fourn-mailto" href="#" class="btn btn-ghost text-xs">Ouvrir dans mon mail</a>';
            html += '<button type="button" id="fourn-fait" class="btn btn-ghost text-xs">Demande envoyée</button>';
            html += '<span id="fourn-retour" class="text-xs text-emerald-700"></span>';
            html += '</div>';
            html += '</div>';
          }

          /* ── Messages échangés ──────────────────────────────────────────
             Tous canaux, envois automatiques compris. Séparé des notes : une
             note est ce qu'un commercial a ÉCRIT POUR LUI, un message est ce
             que le CLIENT a reçu. Les mélanger empêchait de répondre à
             « qu'est-ce qu'on lui a envoyé ». */
          if (c.communications && c.communications.length) {
            var r = c.commResume || {};
            html += '<div class="rounded-xl border border-slate-200 p-4">';
            html += '<div class="flex items-baseline justify-between mb-3 gap-2 flex-wrap">';
            html += '<div class="text-xs font-semibold uppercase tracking-widest text-slate-400">Messages échangés (' + c.communications.length + ')</div>';
            var compteurs = [];
            if (r.email) compteurs.push(r.email + ' email' + (r.email > 1 ? 's' : ''));
            if (r.sms) compteurs.push(r.sms + ' SMS');
            if (r.whatsapp) compteurs.push(r.whatsapp + ' WhatsApp');
            if (r.manuel) compteurs.push(r.manuel + ' manuel' + (r.manuel > 1 ? 's' : ''));
            if (r.auto) compteurs.push(r.auto + ' auto');
            html += '<div class="text-xs text-slate-500">' + escapeHtml(compteurs.join(' · ')) + '</div>';
            html += '</div>';
            /* Les échecs remontent en tête : un message non délivré explique un
               silence client qu'on prendrait sinon pour un désintérêt. */
            if (r.echecs) {
              html += '<div class="rounded-lg bg-red-50 text-red-700 text-xs px-3 py-2 mb-3">'
                + '<strong>' + r.echecs + ' message' + (r.echecs > 1 ? 's' : '') + ' non délivré' + (r.echecs > 1 ? 's' : '')
                + '</strong> — le client ne les a jamais reçus.</div>';
            }

            var ICONES = { email: 'mail', sms: 'sms', whatsapp: 'chat', appel: 'call' };
            c.communications.forEach(function (m) {
              var entrant = !!m.entrant;
              html += '<div class="flex items-start gap-3 py-2 border-b border-slate-100 last:border-0">';
              html += '<span class="material-symbols-outlined text-base flex-shrink-0 '
                + (m.echec ? 'text-red-500' : entrant ? 'text-emerald-600' : 'text-slate-400') + '">'
                + (ICONES[m.canal] || 'mail') + '</span>';
              html += '<div class="flex-1 min-w-0">';

              html += '<div class="flex items-center gap-1.5 flex-wrap">';
              if (entrant) html += '<span class="text-xs font-semibold text-emerald-700">Reçu du client</span>';
              if (m.echec) html += '<span class="rounded bg-red-50 text-red-700 text-xs px-1.5 py-0.5 font-semibold">Non délivré</span>';
              if (m.auto && !entrant) html += '<span class="rounded bg-slate-100 text-slate-500 text-xs px-1.5 py-0.5">Auto</span>';
              if (m.reconstitue) {
                html += '<span class="rounded bg-amber-50 text-amber-700 text-xs px-1.5 py-0.5" '
                  + 'title="Reconstitué depuis les anciennes traces : le contenu exact n\'a pas été conservé à l\'époque.">Reconstitué</span>';
              }
              if (m.meta && m.meta.envoiNonGaranti) {
                html += '<span class="rounded bg-amber-50 text-amber-700 text-xs px-1.5 py-0.5" '
                  + 'title="Ouvert dans WhatsApp depuis le poste du commercial : rien ne prouve que le message a bien été envoyé.">Envoi non confirmé</span>';
              }
              html += '</div>';

              if (m.objet) {
                html += '<div class="text-sm font-semibold text-slate-900">' + escapeHtml(m.objet);
                /* Le montant d'un devis fait partie de ce qu'on a envoyé : sans
                   lui, deux révisions successives sont indiscernables. */
                if (m.meta && m.meta.montant) {
                  html += ' <span class="text-slate-500 font-normal">· '
                    + escapeHtml(String(Math.round(m.meta.montant)).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')) + ' €</span>';
                }
                html += '</div>';
              }
              if (m.corps) html += '<div class="text-sm text-slate-700 whitespace-pre-line">' + escapeHtml(m.corps) + '</div>';
              if (m.echec && m.motif) html += '<div class="text-xs text-red-600">Motif : ' + escapeHtml(m.motif) + '</div>';

              var pied = [m.par || (m.auto ? 'Système' : ''), m.at].filter(Boolean).join(' · ');
              if (m.gabarit) pied += ' · modèle « ' + m.gabarit + ' »';
              html += '<div class="text-xs text-slate-400">' + escapeHtml(pied) + '</div>';
              html += '</div></div>';
            });
            html += '</div>';
          } else {
            html += '<div class="rounded-xl border border-slate-200 p-4 text-sm text-slate-500">'
              + 'Aucun message envoyé à ce contact.</div>';
          }

          if (c.notes && c.notes.length) {
            html += '<div class="rounded-xl border border-slate-200 p-4"><div class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-3">Notes internes (' + c.notes.length + ')</div>';
            c.notes.slice().reverse().forEach(function (n) {
              html += '<div class="text-sm text-slate-700 py-1.5 border-b border-slate-100 last:border-0">' + escapeHtml(n.text);
              html += '<div class="text-xs text-slate-400">' + escapeHtml(n.addedByName || 'Admin') + ' · ' + escapeHtml(n.addedAt) + '</div></div>';
            });
            html += '</div>';
          }

          html += '<form id="lead-note-form" class="rounded-xl border border-slate-200 p-4">';
          html += '<div class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-2">Ajouter une note</div>';
          html += '<textarea name="text" rows="3" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" placeholder="Note interne…"></textarea>';
          html += '<button type="submit" class="btn btn-primary text-xs mt-2">Enregistrer</button></form>';

          html += '</div>';
          content.innerHTML = html;

          /* Demande fournisseur : un seul texte, celui du serveur. Le front ne
             fait qu'échanger de destinataire et remplir les blancs (pièce,
             VIN) — réécrire la formulation ici créerait une seconde version à
             maintenir, qui divergerait à la première retouche. */
          (function () {
            var bloc = document.getElementById('lead-fournisseur');
            if (!bloc || !c.fournisseur) return;
            var F = c.fournisseur;
            var cible = document.getElementById('fourn-cible');
            var corps = document.getElementById('fourn-corps');
            var piece = document.getElementById('fourn-piece');
            var vin = document.getElementById('fourn-vin');
            var vinBloc = document.getElementById('fourn-vin-bloc');
            var refs = document.getElementById('fourn-refs');
            var refsBloc = document.getElementById('fourn-refs-bloc');
            var mailto = document.getElementById('fourn-mailto');
            var mail = document.getElementById('fourn-mail');
            var retour = document.getElementById('fourn-retour');

            function courant() { return F.demandes[cible.value]; }

            /* Les blancs du message sont remplis ici, à l'identique de ce que
               le serveur aurait écrit s'il avait connu les valeurs. */
            function remplir(texte, d) {
              var p = (piece.value || '').trim();
              var v = (vin.value || '').trim().toUpperCase();
              var r = (refs.value || '').trim();
              if (p) texte = texte.split('Demande client : ' + F.aRemplir).join('Demande client : ' + p);
              if (v) texte = texte.split('VIN : ' + F.aRemplir).join('VIN : ' + v);
              if (r && d && d.refsLibelle) {
                texte = texte.split(d.refsLibelle + ' : ' + F.aRemplir).join(d.refsLibelle + ' : ' + r);
              }
              return texte;
            }

            /* L'objet reprend la pièce saisie, sinon il annoncerait un blanc. */
            function objetCourant(d) {
              var p = (piece.value || '').trim();
              if (!p) return d.objet;
              var court = p.length > 60 ? p.slice(0, 59).trim() + '…' : p;
              return d.objet.split(F.aRemplir).join(court);
            }

            function majMailto() {
              var d = courant();
              if (!d) { mailto.removeAttribute('href'); return; }
              mailto.href = 'mailto:' + d.email
                + '?subject=' + encodeURIComponent(objetCourant(d))
                + '&body=' + encodeURIComponent(corps.value);
            }

            function rendre() {
              var d = courant();
              if (!d) {
                /* Aucun destinataire choisi : pas de message tout prêt qu'on
                   pourrait copier sans savoir à qui l'envoyer. */
                corps.value = '';
                corps.placeholder = 'Choisis d\'abord un destinataire ci-dessus.';
                mail.textContent = '';
                vinBloc.className = 'mb-2 hidden';
                refsBloc.className = 'mb-2 hidden';
                mailto.removeAttribute('href');
                return;
              }
              corps.value = remplir(d.corps, d);
              mail.textContent = d.email;
              vinBloc.className = d.vinRequis ? 'mb-2' : 'mb-2 hidden';
              refsBloc.className = d.refsRequises ? 'mb-2' : 'mb-2 hidden';
              /* On reconstruit le mailto à partir du texte AFFICHÉ : sinon les
                 retouches du commercial seraient perdues à l'ouverture du
                 client de messagerie. */
              majMailto();
            }

            cible.addEventListener('change', rendre);
            piece.addEventListener('input', rendre);
            vin.addEventListener('input', rendre);
            refs.addEventListener('input', rendre);
            /* Une retouche directe du message ne doit pas être écrasée : on ne
               met à jour que le lien, pas le corps. */
            corps.addEventListener('input', majMailto);

            Array.prototype.forEach.call(bloc.querySelectorAll('.fourn-sugg'), function (b) {
              b.addEventListener('click', function () {
                piece.value = F.suggestions[Number(b.dataset.i)] || '';
                rendre();
                piece.focus();
              });
            });

            document.getElementById('fourn-copier').addEventListener('click', function () {
              if (!corps.value.trim()) {
                retour.textContent = 'Choisis un destinataire';
                setTimeout(function () { retour.textContent = ''; }, 2500);
                return;
              }
              corps.select();
              var ok = false;
              try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(corps.value).then(function () {
                  retour.textContent = 'Copié';
                }, function () { retour.textContent = ok ? 'Copié' : 'Copie impossible — Ctrl+C'; });
              } else {
                retour.textContent = ok ? 'Copié' : 'Copie impossible — Ctrl+C';
              }
              setTimeout(function () { retour.textContent = ''; }, 2500);
            });

            /* Trace la démarche sur la fiche : sans elle, personne ne sait si
               le fournisseur a été relancé ou si le dossier dort. */
            document.getElementById('fourn-fait').addEventListener('click', function () {
              var d = courant();
              if (!d) return;
              fetch('/admin/api/leads/' + leadId + '/note', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text: 'Demande de tarif envoyée à ' + d.contact + ' (' + d.email + ')' }),
              }).then(function (r) { return r.json(); }).then(function (j) {
                retour.textContent = j && j.ok ? 'Noté sur la fiche' : 'Échec de l\'enregistrement';
                setTimeout(function () { retour.textContent = ''; }, 2500);
              }).catch(function () { retour.textContent = 'Échec de l\'enregistrement'; });
            });

            rendre();
          })();

          var noteForm = document.getElementById('lead-note-form');
          if (noteForm) {
            noteForm.addEventListener('submit', function (e) {
              e.preventDefault();
              var text = noteForm.querySelector('textarea[name="text"]').value;
              fetch('/admin/api/leads/' + leadId + '/note', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text: text }),
              })
                .then(function (r) { return r.json(); })
                .then(function (d) { if (d && d.ok) refresh(); else alert('Erreur: ' + (d && d.error ? d.error : '?')); });
            });
          }
        })
        .catch(function () { content.innerHTML = '<div class="text-sm text-red-500">Erreur de chargement.</div>'; });
    });
  });

  // ─ Relance auto manuelle : envoie tout de suite l'email n° suivant du cycle ─
  document.querySelectorAll('.lead-remind-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var n = btn.dataset.next || '';
      if (!confirm('Envoyer maintenant l’email de relance automatique n°' + n + ' à ce client ?')) return;
      btn.disabled = true;
      btn.style.opacity = '0.5';
      fetch('/admin/relances/' + btn.dataset.leadId + '/relancer', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.ok) refresh();
          else { alert('Erreur : ' + (d && d.error ? d.error : 'inconnue')); btn.disabled = false; btn.style.opacity = ''; }
        })
        .catch(function () { alert('Erreur réseau'); btn.disabled = false; btn.style.opacity = ''; });
    });
  });

  // ─ Templates injectés depuis le serveur ─
  var EMAIL_TEMPLATES = <%- JSON.stringify(emailTemplates || []) %>;
  var SMS_TEMPLATES = <%- JSON.stringify(smsTemplates || []) %>;

  /* La même liste alimente le composeur SMS et le composeur WhatsApp, mais les
     deux canaux n'ont pas les mêmes règles (en SMS le client ne peut pas
     répondre et les liens sont jetés). Un modèle peut donc déclarer
     `channels: ['whatsapp']` ; sans ce champ il reste proposé partout. */
  function smsTemplatesFor(channel) {
    return SMS_TEMPLATES.filter(function (t) {
      return !t.channels || t.channels.indexOf(channel) >= 0;
    });
  }

  /* Le lead n'a ni plaque ni VIN → on ne peut rien lui confirmer. Le composeur
     préselectionne alors le modèle qui réclame l'info plutôt qu'un modèle de
     relance commerciale qui tomberait à plat. Concerne 45 % des leads. */
  function leadMissesPlate(c) {
    var r = (c && c.requested) || {};
    return !String(r.plate || '').trim() && !String(r.vin || '').trim();
  }

  var EMAIL_VARIABLES = [
    { key: 'prenom', label: 'Prénom' },
    { key: 'nom', label: 'Nom' },
    { key: 'nom_produit', label: 'Produit' },
    { key: 'prix_total', label: 'Prix total' },
    { key: 'lien_panier', label: 'Lien panier sauvegardé' },
    { key: 'lien_produit', label: 'Lien produit' },
    { key: 'nom_commercial', label: 'Mon nom' },
    { key: 'telephone', label: 'Téléphone société' },
    { key: 'brand', label: 'Marque' },
  ];

  function fetchLeadDetail(leadId) {
    return fetch('/admin/activite-panier/' + leadId, { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); });
  }

  function renderLeadHeader(c) {
    var name = ((c.firstName || '') + ' ' + (c.lastName || '')).trim() || c.email || c.phone || 'Anonyme';
    var emailsCount = c.manualEmailsSent || 0;
    var smsCount = c.manualSmsSent || 0;
    var isDevisOrContact = c.captureSource === 'devis' || c.captureSource === 'contact';
    var hasReq = c.hasRequested || (c.requested && (c.requested.ref || c.requested.vehicle || c.requested.vin));

    var html = ''
      + '<div class="rounded-xl bg-gradient-to-br from-slate-50 to-slate-100 border border-slate-200 p-4 mb-4">'
      + '  <div class="flex items-start gap-3">';

    /* Visual: pour devis/contact avec demande, on montre une icône, pas le produit du panier */
    if (isDevisOrContact && hasReq) {
      html += '<div class="w-14 h-14 rounded-lg bg-teal-50 border border-teal-200 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-teal-600">request_quote</span></div>';
    } else if (c.items && c.items[0] && c.items[0].image) {
      html += '<img src="' + escapeHtml(c.items[0].image) + '" alt="" class="w-14 h-14 rounded-lg object-cover border border-slate-200 flex-shrink-0" />';
    } else {
      html += '<div class="w-14 h-14 rounded-lg bg-slate-200 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-slate-400">person</span></div>';
    }

    html += '<div class="flex-1 min-w-0">'
      + '<div class="font-semibold text-slate-900 text-sm">' + escapeHtml(name) + '</div>'
      + '<div class="text-xs text-slate-500 mt-0.5 space-y-0.5">';
    if (c.email) html += '<div>📧 ' + escapeHtml(c.email) + '</div>';
    if (c.phone) html += '<div>📞 ' + escapeHtml(c.phone) + '</div>';
    html += '</div>';

    /* Section principale : demande explicite si devis/contact, sinon panier */
    if (isDevisOrContact && hasReq) {
      var bits = [];
      if (c.requested.ref) bits.push(escapeHtml(c.requested.ref));
      if (c.requested.vehicle) bits.push(escapeHtml(c.requested.vehicle));
      if (c.requested.vin) bits.push('VIN ' + escapeHtml(c.requested.vin));
      else if (c.requested.plate) bits.push(escapeHtml(c.requested.plate));
      html += '<div class="mt-2 rounded-md bg-teal-50/60 border border-teal-100 px-2 py-1.5">'
        + '<div class="text-[10px] uppercase tracking-wider text-teal-700 font-semibold">Demande</div>'
        + '<div class="text-sm font-medium text-slate-900">' + (bits.length ? bits.join(' · ') : '<span class="text-slate-400 italic">sans détails</span>') + '</div>';
      if (c.requested.message) {
        html += '<div class="text-xs text-slate-600 italic mt-0.5">"' + escapeHtml(c.requested.message.slice(0, 140)) + (c.requested.message.length > 140 ? '…' : '') + '"</div>';
      }
      html += '</div>';
      if (c.items && c.items.length) {
        html += '<div class="mt-1 text-xs text-amber-700">⚠ Avait aussi en panier : ' + escapeHtml(c.items[0].name) + ' · ' + escapeHtml(c.totalAmount || '—') + '</div>';
      }
    } else {
      html += '<div class="mt-2 text-sm text-slate-700">'
        + '<span class="font-semibold">' + escapeHtml(c.totalAmount || '—') + '</span>';
      if (c.items && c.items.length) {
        html += ' · ' + escapeHtml(c.items[0].name) + (c.items.length > 1 ? ' +' + (c.items.length - 1) : '');
      }
      html += '</div>';
    }

    html += '<div class="mt-1 text-xs text-slate-400">'
      + (c.captureSourceLabel ? 'Source : ' + escapeHtml(c.captureSourceLabel) : '')
      + (c.lastActivityAt ? ' · Vu ' + escapeHtml(c.lastActivityAt) : '')
      + '</div>'
      + '<div class="mt-1 text-xs text-slate-400">';
    if (emailsCount) html += '<span>📧 ' + emailsCount + ' email(s) envoyé(s)</span>';
    if (emailsCount && smsCount) html += ' · ';
    if (smsCount) html += '<span>📱 ' + smsCount + ' SMS</span>';
    if (!emailsCount && !smsCount) html += '<span class="text-slate-300">Aucun contact manuel pour l’instant</span>';
    html += '</div>'
      + '</div></div></div>';
    return html;
  }

  function buildVariablesToolbar(targetId) {
    var html = '<div class="flex flex-wrap gap-1 mb-2">';
    html += '<span class="text-xs text-slate-400 mr-1 self-center">Insérer :</span>';
    EMAIL_VARIABLES.forEach(function (v) {
      html += '<button type="button" class="var-insert-btn px-2 py-0.5 text-xs rounded-md border border-slate-200 bg-white hover:bg-blue-50 hover:border-blue-300 text-slate-700" '
        + 'data-var="{' + v.key + '}" data-target="' + targetId + '" title="' + escapeHtml(v.label) + '">{' + v.key + '}</button>';
    });
    html += '</div>';
    return html;
  }

  function attachVariableInserters(scope) {
    scope.querySelectorAll('.var-insert-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var targetId = btn.dataset.target;
        var token = btn.dataset.var;
        var target = document.getElementById(targetId);
        if (!target) return;
        var start = target.selectionStart || 0;
        var end = target.selectionEnd || 0;
        target.value = target.value.slice(0, start) + token + target.value.slice(end);
        target.focus();
        target.selectionStart = target.selectionEnd = start + token.length;
        target.dispatchEvent(new Event('input'));
      });
    });
  }

  function insertAtCursor(target, token) {
    if (!target) return;
    var start = target.selectionStart || 0;
    var end = target.selectionEnd || 0;
    target.value = target.value.slice(0, start) + token + target.value.slice(end);
    target.focus();
    target.selectionStart = target.selectionEnd = start + token.length;
    target.dispatchEvent(new Event('input'));
  }

  // ─ Picker « Ajouter un article » : recherche le catalogue et insère au
  //   curseur un token [[article|sku|prix|libellé]] → rendu en lien naturel
  //   côté serveur (le prix affiché est modifiable dans le token). ─
  function buildArticlePicker(targetId) {
    return '<div class="mb-2">'
      + '<button type="button" id="' + targetId + '-artbtn" class="inline-flex items-center gap-1 px-2 py-1 text-xs rounded-md border border-blue-200 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold">'
      + '<span class="material-symbols-outlined text-sm">add_shopping_cart</span>Ajouter un article</button>'
      + '<span class="text-[11px] text-slate-400 ml-2">→ insère un lien naturel dans ton message</span>'
      + '<div id="' + targetId + '-artbox" class="hidden mt-2 rounded-lg border border-slate-200 bg-white p-2">'
      + '<input type="text" id="' + targetId + '-artq" placeholder="Réf, modèle, moteur… (ex : Z20DMH, DSG, culasse Opel)" autocomplete="off" class="w-full rounded-md border border-slate-200 px-2 py-1.5 text-sm mb-1" />'
      + '<div id="' + targetId + '-artres" class="max-h-56 overflow-auto"></div>'
      + '</div></div>';
  }

  function attachArticlePicker(scope, targetId) {
    var toggle = scope.querySelector('#' + targetId + '-artbtn');
    var box = scope.querySelector('#' + targetId + '-artbox');
    var input = scope.querySelector('#' + targetId + '-artq');
    var results = scope.querySelector('#' + targetId + '-artres');
    var target = document.getElementById(targetId);
    if (!toggle || !box || !input || !results || !target) return;
    var timer = null, lastQ = null, reqSeq = 0;

    toggle.addEventListener('click', function () {
      box.classList.toggle('hidden');
      if (!box.classList.contains('hidden')) { input.focus(); if (lastQ === null) doSearch(''); }
    });
    input.addEventListener('input', function () {
      var q = input.value.trim();
      if (timer) clearTimeout(timer);
      timer = setTimeout(function () { doSearch(q); }, 250);
    });

    function doSearch(q) {
      lastQ = q;
      var seq = ++reqSeq;
      results.innerHTML = '<div class="px-2 py-2 text-xs text-slate-400">Recherche…</div>';
      fetch('/admin/api/products/search?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) { if (seq === reqSeq) renderResults((d && d.items) || []); })
        .catch(function () { if (seq === reqSeq) results.innerHTML = '<div class="px-2 py-2 text-xs text-red-600">Erreur de recherche</div>'; });
    }

    function renderResults(items) {
      if (!items.length) { results.innerHTML = '<div class="px-2 py-3 text-xs text-slate-400">Aucun article trouvé.</div>'; return; }
      results.innerHTML = '';
      items.slice(0, 12).forEach(function (p) {
        var price = Math.round((p.priceCents || 0) / 100);
        var row = document.createElement('button');
        row.type = 'button';
        row.className = 'w-full text-left flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-blue-50';
        row.innerHTML = '<span class="material-symbols-outlined text-slate-400 text-base flex-shrink-0">description</span>'
          + '<span class="flex-1 min-w-0"><span class="block text-xs text-slate-800 truncate">' + escapeHtml(p.name || '') + '</span>'
          + '<span class="block text-[11px] text-slate-400 truncate">' + escapeHtml((p.sku || '') + (p.brand ? ' · ' + p.brand : '')) + '</span></span>'
          + '<span class="text-xs font-semibold text-slate-700 whitespace-nowrap">' + price.toLocaleString('fr-FR') + ' €</span>'
          + '<span class="text-[11px] text-blue-600 font-semibold whitespace-nowrap">+ insérer</span>';
        row.addEventListener('click', function () {
          var label = String(p.name || '').replace(/[|\]]/g, ' ').replace(/\s+/g, ' ').trim();
          var sku = String(p.sku || '').replace(/[|\]]/g, '');
          insertAtCursor(target, '[[article|' + sku + '|' + price + '|' + label + ']]');
          box.classList.add('hidden');
          input.value = '';
          lastQ = null;
          results.innerHTML = '';
        });
        results.appendChild(row);
      });
    }
  }

  // ─ Reformulation IA (ChatGPT) d'un message du composer, avant envoi ─
  function reformulateComposer(textarea, channel, btn, resultEl, clientName, onDone) {
    var draft = (textarea.value || '').trim();
    if (!draft) { if (resultEl) resultEl.innerHTML = '<span class="text-amber-600">Écris d\'abord un message à reformuler.</span>'; return; }
    var prev = textarea.value;
    var origHtml = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = '⏳ Reformulation…';
    fetch('/admin/api/messages/reformulate', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
      body: JSON.stringify({ draft: draft, channel: channel, clientName: clientName || '' })
    }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        btn.disabled = false; btn.innerHTML = origHtml;
        if (!res.ok || !res.j || !res.j.ok) { if (resultEl) resultEl.innerHTML = '<span class="text-red-700">' + escapeHtml((res.j && res.j.error) || 'Erreur IA') + '</span>'; return; }
        textarea.value = res.j.reformulated;
        if (onDone) onDone();
        if (resultEl) {
          resultEl.innerHTML = '<span class="text-indigo-600">✨ Reformulé par l\'IA. </span><button type="button" id="' + textarea.id + '-undo" class="underline font-semibold text-indigo-600 text-sm">Annuler</button>';
          var u = document.getElementById(textarea.id + '-undo');
          if (u) u.addEventListener('click', function () { textarea.value = prev; if (onDone) onDone(); resultEl.textContent = ''; });
        }
      }).catch(function () { btn.disabled = false; btn.innerHTML = origHtml; if (resultEl) resultEl.innerHTML = '<span class="text-red-700">Erreur réseau — réessaie.</span>'; });
  }

  // ─ Modal EMAIL ─
  function openEmailModal(leadId, lead) {
    var c = lead || {};
    openModal('Envoyer un email');

    var templatesOptions = '<option value="">— Choisir un template —</option>';
    EMAIL_TEMPLATES.forEach(function (t) {
      templatesOptions += '<option value="' + escapeHtml(t.key) + '">' + escapeHtml(t.label) + '</option>';
    });

    content.innerHTML = ''
      + renderLeadHeader(c)
      + '<form id="lead-email-form" class="space-y-3">'
      + '<div class="text-xs text-slate-500">Destinataire : <strong>' + escapeHtml(c.email || '') + '</strong></div>'
      + '<select id="lead-email-template" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm bg-white">'
      + templatesOptions + '</select>'
      + '<input type="text" id="lead-email-subject" name="subject" placeholder="Sujet" required maxlength="200" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" />'
      + buildVariablesToolbar('lead-email-body')
      + buildArticlePicker('lead-email-body')
      + '<textarea id="lead-email-body" name="body" rows="10" required maxlength="8000" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" placeholder="Bonjour {prenom},&#10;&#10;Suite à votre passage sur notre site…"></textarea>'
      + '<label class="flex items-center gap-2 text-sm"><input type="checkbox" id="lead-email-cta" checked /> Inclure un bouton "Reprendre mon panier"</label>'
      + '<div class="flex items-center gap-2 pt-2">'
      + '  <button type="submit" class="btn btn-primary text-sm">📧 Envoyer</button>'
      + '  <button type="button" id="lead-email-ai" class="btn btn-secondary text-sm" style="color:#4f46e5;border-color:#c7d2fe" title="Reformuler le message avec l’IA">✨ Reformuler IA</button>'
      + '  <button type="button" id="lead-email-preview-btn" class="btn btn-secondary text-sm">👁 Aperçu</button>'
      + '  <button type="button" onclick="document.getElementById(\'lead-modal\').classList.add(\'hidden\')" class="btn btn-ghost text-sm">Annuler</button>'
      + '</div>'
      + '<div id="lead-email-result" class="text-sm"></div>'
      + '</form>'
      + '<div id="lead-email-preview-area" class="hidden mt-4 rounded-xl border border-slate-200 overflow-hidden">'
      + '  <div class="px-3 py-2 bg-slate-50 border-b border-slate-200 text-xs text-slate-500">Aperçu de l’email tel qu’il sera reçu :</div>'
      + '  <iframe id="lead-email-preview-frame" sandbox="allow-same-origin" style="width:100%;height:400px;border:0;background:#f3f4f6;"></iframe>'
      + '</div>';

    var form = document.getElementById('lead-email-form');
    var subjectEl = document.getElementById('lead-email-subject');
    var bodyEl = document.getElementById('lead-email-body');
    var ctaEl = document.getElementById('lead-email-cta');
    var templateEl = document.getElementById('lead-email-template');
    var previewBtn = document.getElementById('lead-email-preview-btn');
    var previewArea = document.getElementById('lead-email-preview-area');
    var previewFrame = document.getElementById('lead-email-preview-frame');
    var aiBtn = document.getElementById('lead-email-ai');
    if (aiBtn) aiBtn.addEventListener('click', function () {
      reformulateComposer(bodyEl, 'email', aiBtn, document.getElementById('lead-email-result'), c.fullName, null);
    });

    attachVariableInserters(form);
    attachArticlePicker(form, 'lead-email-body');

    // Sélectionne automatiquement le template le plus pertinent selon la source
    var defaultTpl = EMAIL_TEMPLATES.find(function (t) {
      return t.forSource && t.forSource.indexOf(c.captureSource) >= 0;
    }) || EMAIL_TEMPLATES.find(function (t) { return t.key === 'cart_reminder'; });

    function applyTemplate(tpl) {
      if (!tpl) return;
      subjectEl.value = tpl.subject || '';
      bodyEl.value = tpl.body || '';
      // Le template décide si le CTA panier est pertinent (false pour devis/contact)
      if (typeof tpl.defaultIncludeCta === 'boolean') {
        ctaEl.checked = tpl.defaultIncludeCta;
      }
    }

    if (defaultTpl) {
      templateEl.value = defaultTpl.key;
      applyTemplate(defaultTpl);
    } else {
      // Pas de template par défaut : CTA off pour les leads sans panier pertinent
      var isExplicitRequest = c.captureSource === 'devis' || c.captureSource === 'contact';
      ctaEl.checked = !isExplicitRequest && c.items && c.items.length > 0;
    }

    templateEl.addEventListener('change', function () {
      var tpl = EMAIL_TEMPLATES.find(function (t) { return t.key === templateEl.value; });
      if (tpl) applyTemplate(tpl);
    });

    previewBtn.addEventListener('click', function () {
      previewArea.classList.remove('hidden');
      previewFrame.srcdoc = '<div style="padding:24px;font-family:sans-serif;color:#888">Chargement…</div>';
      fetch('/admin/api/leads/' + leadId + '/email/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subject: subjectEl.value, body: bodyEl.value, includeCartCta: ctaEl.checked }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.ok) {
            previewFrame.srcdoc = d.previewHtml;
            // mettre à jour le sujet réel (avec variables remplacées) en placeholder discret
            subjectEl.title = 'Envoyé tel quel (variables remplacées) : ' + d.subject;
          } else {
            previewFrame.srcdoc = '<div style="padding:24px;color:#dc2626">Erreur : ' + escapeHtml(d && d.error ? d.error : 'inconnue') + '</div>';
          }
        })
        .catch(function () {
          previewFrame.srcdoc = '<div style="padding:24px;color:#dc2626">Erreur réseau</div>';
        });
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var verrou = verrouEnvoi(form);
      if (!verrou) return;
      var resultEl = document.getElementById('lead-email-result');
      resultEl.textContent = 'Envoi…';
      fetch('/admin/api/leads/' + leadId + '/email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          subject: subjectEl.value,
          body: bodyEl.value,
          templateKey: templateEl.value || '',
          includeCartCta: ctaEl.checked,
        }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.ok) { resultEl.innerHTML = '<span class="text-green-700 font-semibold">✓ Email envoyé à ' + escapeHtml(d.sentTo) + '</span>'; setTimeout(refresh, 1000); }
          else { verrou.echec(); resultEl.innerHTML = '<span class="text-red-700">Erreur : ' + escapeHtml(d && d.error ? d.error : '?') + '</span>'; }
        })
        .catch(function () { verrou.echec(); resultEl.innerHTML = '<span class="text-red-700">Erreur réseau</span>'; });
    });
  }

  // ─ Modal SMS ─
  function openSmsModal(leadId, lead, presetTemplateKey) {
    var c = lead || {};
    openModal('Envoyer un SMS');

    var smsList = smsTemplatesFor('sms');
    var templatesOptions = '<option value="">— Choisir un template —</option>';
    smsList.forEach(function (t) {
      templatesOptions += '<option value="' + escapeHtml(t.key) + '">' + escapeHtml(t.label) + '</option>';
    });

    content.innerHTML = ''
      + renderLeadHeader(c)
      + '<form id="lead-sms-form" class="space-y-3">'
      + '<div class="text-xs text-slate-500">Destinataire : <strong>' + escapeHtml(c.phone || '') + '</strong></div>'
      + '<div class="rounded-lg bg-slate-50 border border-slate-200 text-[11px] text-slate-500 px-3 py-2">Pas de lien dans les SMS (bloqués par les opérateurs sous « CarParts »). Le CTA = « rappelez-moi ». Le lien / devis part par <strong>email</strong>.</div>'
      + '<select id="lead-sms-template" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm bg-white">'
      + templatesOptions + '</select>'
      + buildVariablesToolbar('lead-sms-text')
      + '<textarea id="lead-sms-text" name="text" rows="5" required maxlength="480" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" placeholder="Message SMS court…"></textarea>'
      + '<div class="text-xs text-slate-400"><span id="sms-count">0</span>/480 caractères · <span class="text-amber-600">Au-delà de 160 = SMS multipart (coût × n)</span></div>'
      + '<div id="lead-sms-linkwarn" class="hidden rounded-lg bg-amber-50 border border-amber-200 text-amber-800 text-xs px-3 py-2">⚠️ Un lien dans un SMS « CarParts » est bloqué par les opérateurs — le client ne le recevra pas. Retire le lien, envoie-le par email.</div>'
      + '<div class="flex items-center gap-2 pt-2">'
      + '  <button type="submit" class="btn btn-primary text-sm">📱 Envoyer SMS</button>'
      + '  <button type="button" id="lead-sms-ai" class="btn btn-secondary text-sm" style="color:#4f46e5;border-color:#c7d2fe" title="Reformuler le SMS avec l’IA">✨ Reformuler IA</button>'
      + '  <button type="button" onclick="document.getElementById(\'lead-modal\').classList.add(\'hidden\')" class="btn btn-ghost text-sm">Annuler</button>'
      + '</div>'
      + '<div id="lead-sms-result" class="text-sm"></div>'
      + '</form>';

    var form = document.getElementById('lead-sms-form');
    var ta = document.getElementById('lead-sms-text');
    var counter = document.getElementById('sms-count');
    var templateEl = document.getElementById('lead-sms-template');
    var linkWarn = document.getElementById('lead-sms-linkwarn');
    var submitBtn = form.querySelector('button[type="submit"]');

    attachVariableInserters(form);

    function smsHasLink(t) { return /https?:\/\/|www\.[a-z0-9-]+\.[a-z]{2,}|\b[a-z0-9-]{2,}\.(?:fr|com|net|org|eu|io|co|shop|store)\b/i.test(t || ''); }
    function updateCount() {
      counter.textContent = ta.value.length;
      var bad = smsHasLink(ta.value);
      if (linkWarn) linkWarn.classList.toggle('hidden', !bad);
      if (submitBtn) { submitBtn.disabled = bad; submitBtn.style.opacity = bad ? '0.4' : ''; submitBtn.style.cursor = bad ? 'not-allowed' : ''; }
    }
    ta.addEventListener('input', updateCount);

    var smsAiBtn = document.getElementById('lead-sms-ai');
    if (smsAiBtn) smsAiBtn.addEventListener('click', function () {
      reformulateComposer(ta, 'sms', smsAiBtn, document.getElementById('lead-sms-result'), c.fullName, updateCount);
    });

    function applyTemplate(tpl) {
      if (!tpl) return;
      ta.value = tpl.body || '';
      updateCount();
    }

    var presetSms = presetTemplateKey ? smsList.find(function (t) { return t.key === presetTemplateKey; }) : null;
    var defaultSms = presetSms
      || (leadMissesPlate(c) && smsList.find(function (t) { return t.key === 'sms_need_plate'; }))
      || smsList.find(function (t) {
        return t.forSource && t.forSource.indexOf(c.captureSource) >= 0;
      }) || smsList.find(function (t) { return t.key === 'sms_tried_to_call'; });
    if (defaultSms) { templateEl.value = defaultSms.key; applyTemplate(defaultSms); }

    templateEl.addEventListener('change', function () {
      var tpl = smsList.find(function (t) { return t.key === templateEl.value; });
      if (tpl) applyTemplate(tpl);
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var verrou = verrouEnvoi(form);
      if (!verrou) return;
      var resultEl = document.getElementById('lead-sms-result');
      resultEl.textContent = 'Envoi…';
      fetch('/admin/api/leads/' + leadId + '/sms', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: ta.value, templateKey: templateEl.value || '' }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.ok) {
            var canEmail = !!c.email;
            var extra = canEmail ? ' · <button type="button" id="sms-then-email" class="underline font-semibold text-blue-700">＋ enchaîner un email (lien / devis)</button>' : '';
            resultEl.innerHTML = '<span class="text-green-700 font-semibold">✓ SMS envoyé à ' + escapeHtml(d.sentTo) + '</span>' + extra;
            var reloadTimer = setTimeout(refresh, canEmail ? 6000 : 1200);
            var thenBtn = document.getElementById('sms-then-email');
            if (thenBtn) thenBtn.addEventListener('click', function () { clearTimeout(reloadTimer); openEmailModal(leadId, c); });
          }
          else { verrou.echec(); resultEl.innerHTML = '<span class="text-red-700">Erreur : ' + escapeHtml(d && d.error ? d.error : '?') + '</span>'; }
        })
        .catch(function () { verrou.echec(); resultEl.innerHTML = '<span class="text-red-700">Erreur réseau</span>'; });
    });
  }

  // ─ Modal WhatsApp (click-to-chat : ouvre wa.me pré-rempli, envoi depuis le WhatsApp du commercial) ─
  function openWhatsAppModal(leadId, lead, presetTemplateKey) {
    var c = lead || {};
    openModal('Message WhatsApp');

    var waList = smsTemplatesFor('whatsapp');
    var templatesOptions = '<option value="">— Choisir un modèle —</option>';
    waList.forEach(function (t) {
      templatesOptions += '<option value="' + escapeHtml(t.key) + '">' + escapeHtml(t.label) + '</option>';
    });

    content.innerHTML = ''
      + renderLeadHeader(c)
      + '<form id="lead-wa-form" class="space-y-3">'
      + '<div class="text-xs text-slate-500">Destinataire : <strong>' + escapeHtml(c.phone || '') + '</strong></div>'
      + '<div class="rounded-lg bg-emerald-50 border border-emerald-200 text-[11px] text-emerald-800 px-3 py-2">Ça ouvre WhatsApp (Web ou appli) avec le message pré-rempli — tu envoies depuis <strong>ton</strong> WhatsApp. Ici <strong>les liens passent</strong> : n\'hésite pas à joindre le lien du produit ou du devis.</div>'
      + '<select id="lead-wa-template" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm bg-white">'
      + templatesOptions + '</select>'
      + buildVariablesToolbar('lead-wa-text')
      + buildArticlePicker('lead-wa-text')
      + '<textarea id="lead-wa-text" name="text" rows="5" required maxlength="1000" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" placeholder="Message WhatsApp…"></textarea>'
      + '<div class="flex items-center gap-2 pt-2">'
      + '  <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2 transition">Ouvrir WhatsApp</button>'
      + '  <button type="button" onclick="document.getElementById(\'lead-modal\').classList.add(\'hidden\')" class="btn btn-ghost text-sm">Annuler</button>'
      + '</div>'
      + '<div id="lead-wa-result" class="text-sm"></div>'
      + '</form>';

    var form = document.getElementById('lead-wa-form');
    var ta = document.getElementById('lead-wa-text');
    var templateEl = document.getElementById('lead-wa-template');
    attachVariableInserters(form);
    attachArticlePicker(form, 'lead-wa-text');

    function applyTemplate(tpl) { if (tpl) ta.value = tpl.body || ''; }
    var presetWa = presetTemplateKey ? waList.find(function (t) { return t.key === presetTemplateKey; }) : null;
    /* Pas de plaque → en WhatsApp on demande la photo de la carte grise :
       elle donne l'immat ET le VIN d'un coup, ce que le SMS ne permet pas. */
    var defaultWa = presetWa
      || (leadMissesPlate(c) && waList.find(function (t) { return t.key === 'wa_need_plate_photo'; }))
      || waList.find(function (t) { return t.forSource && t.forSource.indexOf(c.captureSource) >= 0; })
      || waList.find(function (t) { return t.key === 'sms_tried_to_call'; });
    if (defaultWa) { templateEl.value = defaultWa.key; applyTemplate(defaultWa); }
    templateEl.addEventListener('change', function () {
      var tpl = waList.find(function (t) { return t.key === templateEl.value; });
      if (tpl) applyTemplate(tpl);
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var resultEl = document.getElementById('lead-wa-result');
      // On pré-ouvre l'onglet DANS le clic (sinon bloqué par le navigateur), on le redirige après.
      var waTab = window.open('', '_blank');
      resultEl.textContent = 'Préparation…';
      fetch('/admin/api/leads/' + leadId + '/whatsapp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: ta.value, templateKey: templateEl.value || '' }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.ok && d.waUrl) {
            if (waTab) waTab.location = d.waUrl; else window.open(d.waUrl, '_blank');
            resultEl.innerHTML = '<span class="text-green-700 font-semibold">✓ WhatsApp ouvert pour ' + escapeHtml(d.sentTo) + '</span>';
            setTimeout(refresh, 1500);
          } else {
            if (waTab) waTab.close();
            resultEl.innerHTML = '<span class="text-red-700">Erreur : ' + escapeHtml(d && d.error ? d.error : '?') + '</span>';
          }
        })
        .catch(function () { if (waTab) waTab.close(); resultEl.innerHTML = '<span class="text-red-700">Erreur réseau</span>'; });
    });
  }

  /* ══ File de travail : appeler, noter le résultat, planifier, clôturer ══
     Chaque geste enregistre la SUITE (prochaine action datée) : c'est ce qui
     garantit qu'aucun client ouvert ne soit oublié. */
  var RESULTATS = <%- JSON.stringify(resultatsAppel || {}) %>;
  var TYPES = <%- JSON.stringify(typesAction || {}) %>;
  var MOTIFS = <%- JSON.stringify(motifsPerte || {}) %>;
  var QUAND = [['1h', 'Dans 1 h'], ['2h', 'Dans 2 h'], ['aprem', 'Cet après-midi'], ['demain', 'Demain matin'], ['2j', 'Dans 2 jours'], ['5j', 'Dans 1 semaine']];

  function toast(msg, type) { if (window.showToast) window.showToast(msg, type || 'success'); }

  function postJson(url, body) {
    return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(body || {}) })
      .then(function (r) { return r.json().then(function (d) { d.__status = r.status; return d; }); });
  }

  function chips(name, options, selected) {
    return '<div class="flex flex-wrap gap-1.5">' + options.map(function (o) {
      var on = o[0] === selected;
      return '<label class="cursor-pointer"><input type="radio" class="peer sr-only" name="' + name + '" value="' + escapeHtml(o[0]) + '"' + (on ? ' checked' : '') + '>'
        + '<span class="inline-flex items-center rounded-full border px-3 py-1.5 text-sm font-medium border-slate-200 text-slate-700 hover:bg-slate-50 peer-checked:bg-slate-900 peer-checked:text-white peer-checked:border-slate-900">' + escapeHtml(o[1]) + '</span></label>';
    }).join('') + '</div>';
  }

  function blocQuand(defaut) {
    return '<div class="space-y-2"><div class="text-xs font-semibold text-slate-500">Quand ?</div>'
      + chips('quand', QUAND.concat([['autre', 'Choisir…']]), defaut || '')
      + '<input type="datetime-local" name="quandLibre" class="hidden w-full rounded-lg border border-slate-200 px-3 py-2 text-sm"></div>';
  }

  function brancherQuand(form) {
    var libre = form.querySelector('[name=quandLibre]');
    form.querySelectorAll('[name=quand]').forEach(function (r) {
      r.addEventListener('change', function () { if (libre) libre.classList.toggle('hidden', r.value !== 'autre' || !r.checked); });
    });
  }

  function lireQuand(form) {
    var r = form.querySelector('[name=quand]:checked');
    if (!r) return '';
    if (r.value !== 'autre') return r.value;
    var v = (form.querySelector('[name=quandLibre]') || {}).value || '';
    return v ? new Date(v).toISOString() : '';
  }

  function selectMotif() {
    return '<select name="motif" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm bg-white"><option value="">Choisis le motif…</option>'
      + Object.keys(MOTIFS).map(function (k) { return '<option value="' + k + '">' + escapeHtml(MOTIFS[k]) + '</option>'; }).join('') + '</select>';
  }

  function finir(form, data, ok) {
    var res = form.querySelector('.js-res');
    if (data && data.ok) {
      toast(data.message || 'Enregistré');
      closeModal();
      setTimeout(refresh, 400);
    } else {
      if (res) res.innerHTML = '<span class="text-red-700 font-semibold">' + escapeHtml((data && data.error) || 'Erreur, réessaie.') + '</span>';
      if (ok) ok.echec();
    }
  }

  /* ─ Résultat d'un appel ─ */
  function ouvrirResultat(leadId, nom) {
    openModal('Résultat de l’appel' + (nom ? ' — ' + nom : ''));
    content.innerHTML = '<form id="form-appel" class="space-y-4">'
      + '<div class="space-y-2"><div class="text-xs font-semibold text-slate-500">Comment s’est passé l’appel ?</div>'
      + chips('resultat', Object.keys(RESULTATS).map(function (k) { return [k, RESULTATS[k]]; }), '') + '</div>'
      + '<div id="appel-joint" class="hidden space-y-2"><div class="text-xs font-semibold text-slate-500">Et maintenant ?</div>'
      + chips('suite', [['quote', 'Préparer le devis'], ['callback', 'Le rappeler'], ['wait_client', 'Il doit me renvoyer des infos'], ['payment', 'Il va payer'], ['perdu', 'Perdu']], '')
      + '</div>'
      + '<div id="appel-motif" class="hidden">' + selectMotif() + '</div>'
      + '<div id="appel-quand" class="hidden">' + blocQuand('') + '</div>'
      + '<div id="appel-sms" class="hidden"><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="sms" checked> Ensuite, envoyer le SMS « J’ai essayé de vous joindre »</label></div>'
      + '<textarea name="note" rows="2" maxlength="1000" placeholder="Note (facultatif) : ce qu’il a dit, la pièce, le prix évoqué…" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm"></textarea>'
      + '<div class="flex items-center gap-3"><button type="submit" class="btn btn-primary">Enregistrer</button><span class="js-res text-sm"></span></div>'
      + '<p class="text-xs text-slate-500">Pas de réponse : le rappel est prévu tout seul (dans 2 h, puis le lendemain). Tu peux changer la date.</p>'
      + '</form>';
    var form = document.getElementById('form-appel');
    brancherQuand(form);
    function maj() {
      var r = (form.querySelector('[name=resultat]:checked') || {}).value || '';
      var s = (form.querySelector('[name=suite]:checked') || {}).value || '';
      document.getElementById('appel-joint').classList.toggle('hidden', r !== 'joint');
      document.getElementById('appel-motif').classList.toggle('hidden', !(r === 'joint' && s === 'perdu'));
      document.getElementById('appel-quand').classList.toggle('hidden', !r || (r === 'joint' && (!s || s === 'perdu')));
      document.getElementById('appel-sms').classList.toggle('hidden', !(r === 'pas_reponse' || r === 'repondeur'));
    }
    form.addEventListener('change', maj);
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var verrou = verrouEnvoi(form);
      if (!verrou) return;
      var resultat = (form.querySelector('[name=resultat]:checked') || {}).value || '';
      var suite = (form.querySelector('[name=suite]:checked') || {}).value || '';
      var sms = form.querySelector('[name=sms]');
      var envoyerSms = sms && sms.checked && (resultat === 'pas_reponse' || resultat === 'repondeur');
      postJson('/admin/api/leads/' + leadId + '/appel', {
        resultat: resultat,
        suite: suite,
        quand: lireQuand(form),
        motif: (form.querySelector('[name=motif]') || {}).value || '',
        note: form.note.value,
      }).then(function (data) {
        if (data && data.ok && envoyerSms) {
          toast(data.message || 'Appel enregistré');
          var b = document.querySelector('.lead-action[data-action="sms"][data-sms-template="sms_tried_to_call"][data-lead-id="' + leadId + '"]');
          if (b) { b.click(); return; }
        }
        finir(form, data, verrou);
      }).catch(function () { finir(form, null, verrou); });
    });
  }

  /* « Appeler » : copie le numéro, lance l'appel (tel:) et ouvre la fenêtre du résultat. */
  document.querySelectorAll('.js-appeler').forEach(function (a) {
    a.addEventListener('click', function () {
      var num = a.getAttribute('data-phone') || '';
      if (num && navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(num).catch(function () {});
      else if (num) fallbackCopyText(num);
      toast('Numéro copié. Après l’appel, note le résultat.', 'info');
      var id = a.getAttribute('data-lead-id');
      var nom = a.getAttribute('data-name') || '';
      setTimeout(function () { ouvrirResultat(id, nom); }, 700);
    });
  });
  document.querySelectorAll('.js-resultat').forEach(function (b) {
    b.addEventListener('click', function () { ouvrirResultat(b.getAttribute('data-lead-id'), b.getAttribute('data-name') || ''); });
  });

  /* ─ Planifier la prochaine action ─ */
  document.querySelectorAll('.js-planifier').forEach(function (b) {
    b.addEventListener('click', function () {
      var leadId = b.getAttribute('data-lead-id');
      openModal('Planifier la suite');
      content.innerHTML = '<form id="form-plan" class="space-y-4">'
        + '<div class="space-y-2"><div class="text-xs font-semibold text-slate-500">Que faut-il faire ?</div>'
        + chips('type', Object.keys(TYPES).map(function (k) { return [k, TYPES[k]]; }), 'callback') + '</div>'
        + blocQuand('demain')
        + '<textarea name="note" rows="2" maxlength="1000" placeholder="Note (facultatif)" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm"></textarea>'
        + '<div class="flex items-center gap-3"><button type="submit" class="btn btn-primary">Enregistrer</button><span class="js-res text-sm"></span></div>'
        + '</form>';
      var form = document.getElementById('form-plan');
      brancherQuand(form);
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var verrou = verrouEnvoi(form);
        if (!verrou) return;
        postJson('/admin/api/leads/' + leadId + '/prochaine-action', {
          type: (form.querySelector('[name=type]:checked') || {}).value || '',
          quand: lireQuand(form),
          note: form.note.value,
        }).then(function (d) { finir(form, d, verrou); }).catch(function () { finir(form, null, verrou); });
      });
    });
  });

  /* ─ Prendre le dossier ─ */
  document.querySelectorAll('.js-prendre').forEach(function (b) {
    b.addEventListener('click', function () {
      var leadId = b.getAttribute('data-lead-id');
      b.disabled = true;
      postJson('/admin/api/leads/' + leadId + '/prendre', {}).then(function (d) {
        if (d && d.ok) { toast('Dossier pris'); setTimeout(refresh, 300); return; }
        if (d && d.__status === 409) {
          var question = (d.error || 'Déjà pris.') + ' Le reprendre quand même ?';
          var conf = window.adminConfirm ? window.adminConfirm(question) : Promise.resolve(window.confirm(question));
          Promise.resolve(conf).then(function (oui) {
            if (!oui) { b.disabled = false; return; }
            postJson('/admin/api/leads/' + leadId + '/prendre', { force: true }).then(function (d2) {
              if (d2 && d2.ok) { toast('Dossier repris'); setTimeout(refresh, 300); } else { b.disabled = false; toast((d2 && d2.error) || 'Erreur', 'error'); }
            });
          });
          return;
        }
        b.disabled = false; toast((d && d.error) || 'Erreur', 'error');
      }).catch(function () { b.disabled = false; toast('Erreur réseau', 'error'); });
    });
  });

  /* ─ Gagné / Perdu / Rouvrir ─ */
  document.querySelectorAll('.js-cloturer').forEach(function (b) {
    b.addEventListener('click', function () {
      var leadId = b.getAttribute('data-lead-id');
      var issue = b.getAttribute('data-issue');
      var menu = b.closest('details'); if (menu) menu.removeAttribute('open');
      var titre = issue === 'gagne' ? 'Marquer gagné' : issue === 'perdu' ? 'Marquer perdu' : 'Rouvrir le dossier';
      openModal(titre);
      var corps = issue === 'gagne'
        ? '<p class="text-sm text-slate-600">Gagné = le client a <strong>payé</strong> (commande, acompte, virement ou espèces). Un simple « oui » au téléphone n’est pas encore gagné : dans ce cas, planifie « Vérifier le paiement ».</p>'
          + '<label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="confirme"> Le client a payé ou versé un acompte</label>'
          + '<select name="moyen" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm bg-white"><option value="">Comment ? (facultatif)</option><option>Carte / lien de paiement</option><option>Virement</option><option>Espèces</option><option>Acompte</option></select>'
        : issue === 'perdu'
          ? '<p class="text-sm text-slate-600">Pourquoi ce client est-il perdu ? Ça sert à comprendre ce qui fait perdre des ventes.</p>' + selectMotif()
            + '<textarea name="note" rows="2" maxlength="1000" placeholder="Précision (facultatif)" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm"></textarea>'
          : '<p class="text-sm text-slate-600">Le dossier redevient ouvert, avec un rappel dans l’heure.</p>';
      content.innerHTML = '<form id="form-cloture" class="space-y-4">' + corps
        + '<div class="flex items-center gap-3"><button type="submit" class="btn btn-primary">Valider</button><span class="js-res text-sm"></span></div></form>';
      var form = document.getElementById('form-cloture');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var verrou = verrouEnvoi(form);
        if (!verrou) return;
        var body = { issue: issue };
        if (issue === 'gagne') { body.confirme = !!(form.confirme && form.confirme.checked); body.moyen = form.moyen ? form.moyen.value : ''; }
        if (issue === 'perdu') { body.motif = form.motif.value; body.note = form.note ? form.note.value : ''; }
        postJson('/admin/api/leads/' + leadId + '/cloturer', body)
          .then(function (d) { finir(form, d, verrou); }).catch(function () { finir(form, null, verrou); });
      });
    });
  });

  /* Un seul menu « Autres » ouvert à la fois ; un clic ailleurs le ferme. */
  document.addEventListener('click', function (e) {
    document.querySelectorAll('details.lead-menu[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
  });
  /* Le menu se ferme dès qu'on choisit une action. */
  document.querySelectorAll('details.lead-menu button, details.lead-menu a').forEach(function (el) {
    el.addEventListener('click', function () { var d = el.closest('details'); if (d) d.removeAttribute('open'); });
  });

  // ─ Action: email / sms / whatsapp ─
  document.querySelectorAll('.lead-action').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var action = btn.dataset.action;
      var leadId = btn.dataset.leadId;
      openModal('Chargement…');
      content.innerHTML = '<div class="text-sm text-slate-500">Chargement du lead…</div>';

      fetchLeadDetail(leadId)
        .then(function (data) {
          if (!data || !data.ok || !data.cart) {
            content.innerHTML = '<div class="text-sm text-red-500">Erreur : impossible de charger le lead.</div>';
            return;
          }
          if (action === 'email') openEmailModal(leadId, data.cart);
          else if (action === 'sms') openSmsModal(leadId, data.cart, btn.dataset.smsTemplate || '');
          else if (action === 'whatsapp') openWhatsAppModal(leadId, data.cart, btn.dataset.smsTemplate || '');
        })
        .catch(function () {
          content.innerHTML = '<div class="text-sm text-red-500">Erreur réseau.</div>';
        });
    });
  });
})();
</script>

<%- include('./partials/footer') %>

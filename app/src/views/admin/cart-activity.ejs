  /* ══ File de travail : appeler, noter, planifier, clôturer ══
     Chaque geste enregistre la SUITE (prochaine action datée) : c'est ce qui
     garantit qu'aucun client ouvert ne soit oublié. */
  var RESULTATS = <%- JSON.stringify(resultatsAppel || {}) %>;
  var MOTIFS = <%- JSON.stringify(motifsPerte || {}) %>;
  /* « Devis envoyé » n'est pas une action à venir, c'est une action faite :
     c'est le seul choix qui ne demande pas d'heure (voir maj()). */
  var SUITES = [['quote', 'Préparer le devis'], ['devis_envoye', 'Devis envoyé'], ['callback', 'Le rappeler'],
    ['wait_client', 'Il doit m’envoyer des infos'], ['follow_quote', 'Relancer le devis'], ['payment', 'Il va payer'],
    ['sourcing', 'Chercher la pièce'], ['wait_supplier', 'Attente fournisseur'], ['to_validate', 'À valider par Killian'],
    ['other', 'Autre'], ['perdu', 'Perdu']];
  var QUAND = [['2h', 'Dans 2 h'], ['aprem', 'Cet après-midi'], ['demain', 'Demain matin'], ['2j', 'Dans 2 jours'], ['5j', 'Dans 1 semaine'], ['autre', 'Choisir une date…']];

  function toast(msg, type) { if (window.showToast) window.showToast(msg, type || 'success'); }

  function postJson(url, body) {
    return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(body || {}) })
      .then(function (r) { return r.json().then(function (d) { d.__status = r.status; return d; }); });
  }

  /* ══ Vue boîte mail : choisir un client ══ */
  var split = document.getElementById('file-split');
  var listeCol = document.getElementById('file-liste');
  var ficheCol = document.getElementById('file-fiche');
  var courant = null;
  var detailCache = {};

  function toutesLignes() { return Array.prototype.slice.call(document.querySelectorAll('.lead-ligne')); }
  /* Seulement l'onglet affiché : « J » ne doit pas sauter dans une file qu'on
     ne voit pas, et « Tout cocher » ne coche que ce qui est à l'écran. */
  function lignes() {
    var sel = document.querySelector('.lead-panneau') ? '.lead-panneau:not(.hidden) .lead-ligne' : '.lead-ligne';
    return Array.prototype.slice.call(document.querySelectorAll(sel));
  }

  /* ══ Onglets de la file ══
     Les groupes étaient empilés dans la colonne de gauche : avec huit d'entre
     eux, « Nouvelles demandes » se retrouvait sous 168 lignes rouges. Un
     onglet par file, à l'horizontale, et la colonne n'en montre qu'une. */
  var onglets = document.getElementById('leads-onglets');
  var panneaux = Array.prototype.slice.call(document.querySelectorAll('.lead-panneau'));
  var groupeActif = '';

  function groupeDe(id) {
    var l = id ? document.querySelector('.lead-ligne[data-lead-id="' + id + '"]') : null;
    var p = l && l.closest ? l.closest('.lead-panneau') : null;
    return p ? p.dataset.groupe : '';
  }

  function montrerGroupe(cle, opts) {
    opts = opts || {};
    if (!cle) return false;
    if (cle === groupeActif) return true;
    if (!panneaux.some(function (p) { return p.dataset.groupe === cle; })) return false;
    panneaux.forEach(function (p) { p.classList.toggle('hidden', p.dataset.groupe !== cle); });
    if (onglets) Array.prototype.forEach.call(onglets.querySelectorAll('.leads-onglet'), function (b) {
      b.setAttribute('aria-selected', b.dataset.groupe === cle ? 'true' : 'false');
    });
    groupeActif = cle;
    /* L'adresse garde l'onglet ouvert : un F5, un « Actualiser » ou un retour
       depuis une fiche y reviennent. */
    if (opts.url !== false) {
      try {
        var u = new URL(window.location.href);
        u.searchParams.set('voir', cle);
        u.hash = '';
        history.replaceState(null, '', u.toString());
      } catch (_) {}
    }
    /* Une sélection en cours porterait sur des lignes qu'on ne voit plus. */
    if (split && split.dataset.selection === '1') {
      lotSelection = {};
      toutesLignes().forEach(function (l) { l.setAttribute('aria-checked', 'false'); lotMajCase(l); });
      lotMajCompte();
    }
    if (listeCol) listeCol.scrollTop = 0;
    return true;
  }

  if (onglets) onglets.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('.leads-onglet') : null;
    if (!b || !montrerGroupe(b.dataset.groupe)) return;
    /* Comme une boîte mail : l'onglet ouvert montre son premier client, quand
       il y a la place pour les deux colonnes. */
    var premiere = lignes()[0];
    if (premiere && estSplit()) selectionner(premiere.dataset.leadId, { defiler: false });
  });

  if (panneaux.length) {
    var params = null;
    try { params = new URLSearchParams(window.location.search); } catch (_) {}
    var hash = window.location.hash.indexOf('#groupe-') === 0 ? window.location.hash.slice(8) : '';
    /* Le client demandé dans l'adresse décide de l'onglet : sans ça, un lien
       « ?lead=… » ouvrait une fiche dont la ligne était cachée. */
    var vise = groupeDe(params ? params.get('lead') : '') || (params ? params.get('voir') : '') || hash;
    if (!montrerGroupe(vise, { url: false })) montrerGroupe(panneaux[0].dataset.groupe, { url: false });
  }
  function estSplit() { return !!split && split.getBoundingClientRect().width >= 900; }

  /* Écran large : les deux colonnes remplissent la fenêtre et défilent
     chacune de leur côté, comme une boîte mail. */
  function ajusterHauteurs() {
    if (!listeCol || !ficheCol) return;
    if (estSplit()) {
      if (split.dataset.mode === 'fiche') split.dataset.mode = 'liste';
      var haut = listeCol.getBoundingClientRect().top + window.scrollY;
      var h = Math.max(420, window.innerHeight - haut - 16);
      listeCol.style.height = h + 'px';
      ficheCol.style.height = h + 'px';
    } else {
      listeCol.style.height = '';
      ficheCol.style.height = '';
    }
  }
  window.addEventListener('resize', ajusterHauteurs);

  function idSuivant(id, sens) {
    var l = lignes();
    var i = -1;
    for (var k = 0; k < l.length; k++) { if (l[k].dataset.leadId === id) { i = k; break; } }
    var j = i + (sens || 1);
    return (j >= 0 && j < l.length) ? l[j].dataset.leadId : '';
  }

  /* Recharge la page sur un client donné (l'adresse garde les filtres). */
  function allerA(id) {
    try {
      var u = new URL(window.location.href);
      if (id) u.searchParams.set('lead', id); else u.searchParams.delete('lead');
      u.hash = '';
      window.location.replace(u.toString());
    } catch (_) { window.location.reload(); }
  }

  function selectionner(id, opts) {
    opts = opts || {};
    var ligne = document.querySelector('.lead-ligne[data-lead-id="' + id + '"]');
    var fiche = document.getElementById('fiche-' + id);
    if (!ligne || !fiche) return false;
    lignes().forEach(function (l) { l.setAttribute('aria-selected', l === ligne ? 'true' : 'false'); });
    Array.prototype.forEach.call(document.querySelectorAll('.lead-fiche'), function (f) { f.classList.toggle('hidden', f !== fiche); });
    var vide = document.getElementById('fiche-vide');
    if (vide) vide.classList.add('hidden');
    courant = id;
    var panneau = ligne.closest ? ligne.closest('.lead-panneau') : null;
    if (panneau && panneau.classList.contains('hidden')) montrerGroupe(panneau.dataset.groupe);
    try {
      var u = new URL(window.location.href);
      u.searchParams.set('lead', id);
      history.replaceState(null, '', u.toString());
    } catch (_) {}
    if (estSplit()) {
      ficheCol.scrollTop = 0;
      if (opts.defiler !== false) ligne.scrollIntoView({ block: 'nearest' });
    } else if (opts.ouvrir !== false) {
      split.dataset.mode = 'fiche';
      window.scrollTo(0, 0);
    }
    afficherOnglet(fiche, 'suivi');
    return true;
  }

  function chargerDetail(id) {
    if (detailCache[id]) return Promise.resolve(detailCache[id]);
    return fetchLeadDetail(id).then(function (d) {
      if (!d || !d.ok || !d.cart) throw new Error('detail');
      detailCache[id] = d.cart;
      return d.cart;
    });
  }

  function afficherOnglet(fiche, nom, opts) {
    opts = opts || {};
    var id = fiche.dataset.leadId;
    Array.prototype.forEach.call(fiche.querySelectorAll('.fiche-onglet'), function (b) {
      b.setAttribute('aria-selected', b.dataset.onglet === nom ? 'true' : 'false');
    });
    var zone = fiche.querySelector('.fiche-onglets');
    if (!detailCache[id]) zone.innerHTML = '<div class="text-sm text-slate-400">Chargement…</div>';
    chargerDetail(id).then(function (c) {
      if (courant !== id) return;
      zone.innerHTML = nom === 'piece' ? htmlPiece(c, id) : nom === 'client' ? htmlClient(c) : htmlSuivi(c);
      if (nom === 'piece') brancherFournisseur(zone, c, id);
      if (nom === 'suivi') brancherNote(zone, id, fiche);
      var cible = opts.cible ? zone.querySelector('[data-bloc="' + opts.cible + '"]') : (opts.defiler ? fiche.querySelector('.fiche-onglets-bloc') : null);
      if (cible) cible.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }).catch(function () {
      if (courant !== id) return;
      zone.innerHTML = '<div class="text-sm text-red-600">Impossible de charger l’historique. <button type="button" class="js-onglet font-semibold underline" data-onglet="' + nom + '">Réessayer</button></div>';
    });
  }

  if (listeCol) listeCol.addEventListener('click', function (e) {
    var l = e.target.closest ? e.target.closest('.lead-ligne') : null;
    if (!l) return;
    /* Mode « Sélectionner » : le clic coche la ligne au lieu d'ouvrir la fiche. */
    if (split && split.dataset.selection === '1') { lotBasculer(l); return; }
    selectionner(l.dataset.leadId, { defiler: false });
  });

  document.addEventListener('click', function (e) {
    var t = e.target.closest ? e.target : null;
    if (!t) return;
    var onglet = t.closest('.js-onglet');
    if (onglet) {
      var fiche = onglet.closest('.lead-fiche');
      if (fiche) afficherOnglet(fiche, onglet.dataset.onglet, { cible: onglet.dataset.cible || '', defiler: !!(onglet.dataset.defiler || onglet.dataset.cible) });
      return;
    }
    if (t.closest('.js-suivant')) { passer(1); return; }
    if (t.closest('.js-retour-liste')) {
      split.dataset.mode = 'liste';
      var l = document.querySelector('.lead-ligne[data-lead-id="' + courant + '"]');
      if (l) l.scrollIntoView({ block: 'center' });
    }
  });

  function passer(sens) {
    var id = idSuivant(courant, sens);
    if (!id) { toast(sens > 0 ? 'C’était le dernier client de la liste.' : 'Tu es déjà en haut de la liste.', 'info'); return; }
    selectionner(id);
  }

  /* Un geste = une touche. Tout ce qu'on fait vingt fois par jour sur la
     fiche affichée : appeler, écrire, noter l'appel, planifier, clôturer.
     Les libellés sont dans le guide « Comment ça marche ». */
  function agirSurFiche(selecteur, sinon) {
    var fiche = document.getElementById('fiche-' + courant);
    var el = fiche ? fiche.querySelector(selecteur) : null;
    if (el) { el.click(); return; }
    toast(sinon, 'info');
  }

  /* « N » : ouvrir le suivi et écrire une note tout de suite. L'onglet se
     remplit en différé, on attend que le champ existe (2 s au plus). */
  function ecrireUneNote() {
    var fiche = document.getElementById('fiche-' + courant);
    if (!fiche) return;
    afficherOnglet(fiche, 'suivi', { defiler: true });
    var essais = 0;
    var t = setInterval(function () {
      var champ = fiche.querySelector('[data-role="note-form"] textarea');
      if (champ) { clearInterval(t); champ.focus(); return; }
      if (++essais > 20) clearInterval(t);
    }, 100);
  }

  document.addEventListener('keydown', function (e) {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    var tag = (document.activeElement && document.activeElement.tagName) || '';
    if (/^(INPUT|TEXTAREA|SELECT)$/.test(tag) || (document.activeElement && document.activeElement.isContentEditable)) return;
    if (modal && !modal.classList.contains('hidden')) return;

    /* Ces deux-là marchent même sans client sélectionné. */
    if (e.key === '/') {
      var recherche = document.querySelector('input[name="q"]');
      if (!recherche) return;
      e.preventDefault();
      /* Sur petit écran, la recherche est cachée tant qu'on lit une fiche :
         on revient à la liste, sinon la touche ne ferait rien du tout. */
      if (!estSplit() && split.dataset.mode === 'fiche') split.dataset.mode = 'liste';
      recherche.focus();
      recherche.select();
      return;
    }
    if (e.key === '?' && helpModal) { e.preventDefault(); helpModal.classList.remove('hidden'); return; }
    if (!courant) return;

    if (e.key === 'j' || e.key === 'J' || (e.key === 'ArrowDown' && estSplit())) { e.preventDefault(); passer(1); }
    else if (e.key === 'k' || e.key === 'K' || (e.key === 'ArrowUp' && estSplit())) { e.preventDefault(); passer(-1); }
    else if (e.key === 'a' || e.key === 'A') { e.preventDefault(); agirSurFiche('.js-appeler', 'Pas d’appel possible sur ce client.'); }
    else if (e.key === 'e' || e.key === 'E') { e.preventDefault(); agirSurFiche('.lead-action[data-action="email"]', 'Ce client n’a pas d’adresse email.'); }
    else if (e.key === 's' || e.key === 'S') { e.preventDefault(); agirSurFiche('.lead-action[data-action="sms"]', 'Pas de SMS possible sur ce numéro.'); }
    else if (e.key === 'r' || e.key === 'R') { e.preventDefault(); agirSurFiche('.js-resultat', 'Rien à noter : aucun appel n’est possible ici.'); }
    else if (e.key === 'p' || e.key === 'P') { e.preventDefault(); agirSurFiche('.js-planifier', 'Ce dossier est clos : rouvre-le d’abord.'); }
    else if (e.key === 'n' || e.key === 'N') { e.preventDefault(); ecrireUneNote(); }
    else if (e.key === 'g' || e.key === 'G') { e.preventDefault(); agirSurFiche('.js-cloturer[data-issue="gagne"]', 'Ce dossier est déjà clos.'); }
    else if (e.key === 'l' || e.key === 'L') { e.preventDefault(); agirSurFiche('.js-cloturer[data-issue="perdu"]', 'Ce dossier est déjà clos.'); }
    else if (e.key === 'Escape' && !estSplit() && split.dataset.mode === 'fiche') { split.dataset.mode = 'liste'; }
  });

  /* ─ Fenêtre unique « suite » : après un appel (avec le résultat) ou pour
       planifier. Elle exige toujours la suite et sa date. ─ */
  function chips(name, options, selected) {
    return '<div class="flex flex-wrap gap-1.5">' + options.map(function (o) {
      var on = o[0] === selected;
      return '<label class="cursor-pointer"><input type="radio" class="peer sr-only" name="' + name + '" value="' + escapeHtml(o[0]) + '"' + (on ? ' checked' : '') + '>'
        + '<span class="inline-flex items-center rounded-full border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 peer-checked:border-slate-900 peer-checked:bg-slate-900 peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-primary/40">' + escapeHtml(o[1]) + '</span></label>';
    }).join('') + '</div>';
  }

  function etape(num, titre, corps) {
    return '<div class="space-y-2"><div class="text-sm font-bold text-slate-900"><span class="mr-1.5 inline-flex h-5 w-5 items-center justify-center rounded-full bg-slate-900 text-[11px] text-white">' + num + '</span>' + titre + '</div>' + corps + '</div>';
  }

  function selectMotif() {
    return '<select name="motif" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm"><option value="">Choisis le motif…</option>'
      + Object.keys(MOTIFS).map(function (k) { return '<option value="' + k + '">' + escapeHtml(MOTIFS[k]) + '</option>'; }).join('') + '</select>';
  }

  function lireQuand(form) {
    var r = form.querySelector('[name=quand]:checked');
    if (!r) return '';
    if (r.value !== 'autre') return r.value;
    var v = (form.querySelector('[name=quandLibre]') || {}).value || '';
    return v ? new Date(v).toISOString() : '';
  }

  function cocher(form, name, value) {
    var r = form.querySelector('[name=' + name + '][value="' + value + '"]');
    if (r) r.checked = true;
  }

  function ouvrirSuite(leadId, nom, avecAppel) {
    var fiche = document.getElementById('fiche-' + leadId);
    var dejaEssaye = !!(fiche && fiche.dataset.dejaEssaye === '1');
    openModal((avecAppel ? 'Noter l’appel' : 'Planifier la suite') + (nom ? ' — ' + nom : ''));
    var n = 1;
    var html = '<form id="form-suite" class="space-y-5">';
    if (avecAppel) html += etape(n++, 'Comment s’est passé l’appel ?', chips('resultat', Object.keys(RESULTATS).map(function (k) { return [k, RESULTATS[k]]; }), ''));
    html += '<div data-role="suite" class="' + (avecAppel ? 'hidden' : '') + '">' + etape(n++, 'Quelle est la suite ?', chips('suite', SUITES, avecAppel ? '' : 'callback')) + '</div>';
    html += '<div data-role="motif" class="hidden space-y-2">' + selectMotif() + '</div>';
    html += '<div data-role="quand" class="' + (avecAppel ? 'hidden' : '') + '">' + etape(n, 'Pour quand ?', chips('quand', QUAND, avecAppel ? '' : 'demain')
      + '<input type="datetime-local" name="quandLibre" class="mt-2 hidden w-full rounded-lg border border-slate-200 px-3 py-2 text-sm">') + '</div>';
    /* Sans ça, il fallait inventer une heure pour un travail déjà fait — et
       cette heure inventée faisait remonter le dossier en rouge. */
    html += '<p data-role="aide-devis" class="hidden rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-900">'
      + 'Rien à prévoir : <strong>la relance du devis sera proposée toute seule dans 3 jours ouvrés</strong>, en ambre, dans « À relancer ». '
      + 'Prends « Relancer le devis » si tu veux fixer une heure précise.</p>';
    if (avecAppel) {
      html += '<div data-role="sms" class="hidden"><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="sms" checked> Ensuite, lui envoyer le SMS « J’ai essayé de vous joindre »</label></div>';
      html += '<p data-role="aide-numero" class="hidden rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-900">Mauvais numéro : écris-lui par email pour avoir le bon numéro.</p>';
    }
    html += '<textarea name="note" rows="2" maxlength="1000" placeholder="Note (facultatif) : ce qu’il a dit, la pièce, le prix évoqué…" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm"></textarea>';
    html += '<div class="flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4">'
      + '<button type="submit" data-apres="suivant" class="btn btn-primary">Enregistrer et continuer →</button>'
      + '<button type="submit" data-apres="rester" class="btn btn-ghost text-sm">Enregistrer</button>'
      + '<button type="button" data-role="annuler" class="btn btn-ghost text-sm">Annuler</button>'
      + '<span class="js-res w-full text-sm"></span></div>';
    html += '</form>';
    content.innerHTML = html;

    var form = document.getElementById('form-suite');
    function bloc(role) { return form.querySelector('[data-role="' + role + '"]'); }
    var apres = 'suivant';
    Array.prototype.forEach.call(form.querySelectorAll('button[type=submit]'), function (b) {
      b.addEventListener('click', function () { apres = b.dataset.apres || 'suivant'; });
    });
    bloc('annuler').addEventListener('click', closeModal);

    function valeur(name) { return (form.querySelector('[name=' + name + ']:checked') || {}).value || ''; }
    var dernierResultat = '';
    function maj() {
      var r = avecAppel ? valeur('resultat') : 'plan';
      /* Pas joint : la suite est évidente, on la pré-remplit (modifiable). */
      if (avecAppel && r && r !== dernierResultat) {
        dernierResultat = r;
        if (r === 'pas_reponse' || r === 'repondeur') { cocher(form, 'suite', 'callback'); cocher(form, 'quand', dejaEssaye ? 'demain' : '2h'); }
        else if (r === 'mauvais_numero') { cocher(form, 'suite', 'other'); cocher(form, 'quand', '2h'); }
      }
      var s = valeur('suite');
      bloc('suite').classList.toggle('hidden', !r);
      bloc('motif').classList.toggle('hidden', s !== 'perdu');
      bloc('quand').classList.toggle('hidden', !r || !s || s === 'perdu' || s === 'devis_envoye');
      bloc('aide-devis').classList.toggle('hidden', s !== 'devis_envoye');
      if (avecAppel) {
        bloc('sms').classList.toggle('hidden', !(r === 'pas_reponse' || r === 'repondeur'));
        bloc('aide-numero').classList.toggle('hidden', r !== 'mauvais_numero');
      }
      var libre = form.querySelector('[name=quandLibre]');
      if (libre) libre.classList.toggle('hidden', valeur('quand') !== 'autre');
    }
    form.addEventListener('change', maj);
    maj();

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var res = form.querySelector('.js-res');
      var resultat = avecAppel ? valeur('resultat') : '';
      var suite = valeur('suite');
      var quand = lireQuand(form);
      var motif = (form.querySelector('[name=motif]') || {}).value || '';
      var erreur = (avecAppel && !resultat) ? 'Choisis comment s’est passé l’appel.'
        : !suite ? 'Choisis la suite.'
          : suite === 'perdu' && !motif ? 'Choisis le motif de perte.'
            : suite !== 'perdu' && suite !== 'devis_envoye' && !quand ? 'Choisis pour quand.' : '';
      if (erreur) { res.innerHTML = '<span class="font-semibold text-red-700">' + erreur + '</span>'; return; }
      var verrou = verrouEnvoi(form);
      if (!verrou) return;
      var url, body;
      var sansHeure = suite === 'perdu' || suite === 'devis_envoye';
      if (avecAppel) { url = '/appel'; body = { resultat: resultat, suite: suite, quand: sansHeure ? '' : quand, motif: motif, note: form.note.value }; }
      else if (suite === 'perdu') { url = '/cloturer'; body = { issue: 'perdu', motif: motif, note: form.note.value }; }
      else { url = '/prochaine-action'; body = { type: suite, quand: quand, note: form.note.value }; }
      var sms = form.querySelector('[name=sms]');
      var envoyerSms = !!(sms && sms.checked && (resultat === 'pas_reponse' || resultat === 'repondeur'));
      postJson('/admin/api/leads/' + leadId + url, body).then(function (data) {
        if (!(data && data.ok)) {
          verrou.echec();
          res.innerHTML = '<span class="font-semibold text-red-700">' + escapeHtml((data && data.error) || 'Erreur, réessaie.') + '</span>';
          return;
        }
        toast(data.message || 'Enregistré');
        if (envoyerSms) {
          /* Le SMS s'ouvre tout de suite ; une fois envoyé, on enchaîne comme demandé. */
          apresEnvoi = { id: leadId, mode: apres };
          var b = document.querySelector('#fiche-' + leadId + ' .lead-action[data-action="sms"][data-sms-template="sms_tried_to_call"]');
          if (b) { b.click(); return; }
        }
        closeModal();
        if (apres === 'suivant') allerA(idSuivant(leadId, 1) || leadId); else allerA(leadId);
      }).catch(function () { verrou.echec(); res.innerHTML = '<span class="font-semibold text-red-700">Erreur réseau, réessaie.</span>'; });
    });
  }

  /* « Appeler » : copie le numéro, lance l'appel (tel:) puis ouvre la fenêtre du résultat. */
  Array.prototype.forEach.call(document.querySelectorAll('.js-appeler'), function (a) {
    a.addEventListener('click', function () {
      var num = a.getAttribute('data-phone') || '';
      if (num && navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(num).catch(function () {});
      else if (num) fallbackCopyText(num);
      toast('Numéro copié. Après l’appel, note comment ça s’est passé.', 'info');
      var id = a.getAttribute('data-lead-id');
      var nom = a.getAttribute('data-name') || '';
      setTimeout(function () { ouvrirSuite(id, nom, true); }, 700);
    });
  });
  Array.prototype.forEach.call(document.querySelectorAll('.js-resultat'), function (b) {
    b.addEventListener('click', function () { ouvrirSuite(b.getAttribute('data-lead-id'), b.getAttribute('data-name') || '', true); });
  });
  Array.prototype.forEach.call(document.querySelectorAll('.js-planifier'), function (b) {
    b.addEventListener('click', function () {
      var fiche = b.closest('.lead-fiche');
      ouvrirSuite(b.getAttribute('data-lead-id'), fiche ? fiche.dataset.name : '', false);
    });
  });

  /* ─ Prendre le dossier ─ */
  Array.prototype.forEach.call(document.querySelectorAll('.js-prendre'), function (b) {
    b.addEventListener('click', function () {
      var leadId = b.getAttribute('data-lead-id');
      b.disabled = true;
      postJson('/admin/api/leads/' + leadId + '/prendre', {}).then(function (d) {
        if (d && d.ok) { toast('C’est noté : tu t’occupes de ce client.'); setTimeout(function () { allerA(leadId); }, 300); return; }
        if (d && d.__status === 409) {
          var question = (d.error || 'Déjà pris.') + ' Le reprendre quand même ?';
          var conf = window.adminConfirm ? window.adminConfirm(question) : Promise.resolve(window.confirm(question));
          Promise.resolve(conf).then(function (oui) {
            if (!oui) { b.disabled = false; return; }
            postJson('/admin/api/leads/' + leadId + '/prendre', { force: true }).then(function (d2) {
              if (d2 && d2.ok) { toast('Dossier repris'); setTimeout(function () { allerA(leadId); }, 300); } else { b.disabled = false; toast((d2 && d2.error) || 'Erreur', 'error'); }
            });
          });
          return;
        }
        b.disabled = false; toast((d && d.error) || 'Erreur', 'error');
      }).catch(function () { b.disabled = false; toast('Erreur réseau', 'error'); });
    });
  });

  /* ─ Gagné / Perdu / Rouvrir ─ */
  Array.prototype.forEach.call(document.querySelectorAll('.js-cloturer'), function (b) {
    b.addEventListener('click', function () {
      var leadId = b.getAttribute('data-lead-id');
      var issue = b.getAttribute('data-issue');
      var menu = b.closest('details'); if (menu) menu.removeAttribute('open');
      openModal(issue === 'gagne' ? 'Marquer gagné' : issue === 'perdu' ? 'Marquer perdu' : 'Rouvrir le dossier');
      var corps = issue === 'gagne'
        ? '<p class="text-sm text-slate-600">Gagné = le client a <strong>payé</strong> (commande, acompte, virement ou espèces). Un simple « oui » au téléphone n’est pas encore gagné : dans ce cas, planifie « Il va payer ».</p>'
          + '<label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="confirme"> Le client a payé ou versé un acompte</label>'
          + '<select name="moyen" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm"><option value="">Comment ? (facultatif)</option><option>Carte / lien de paiement</option><option>Virement</option><option>Espèces</option><option>Acompte</option></select>'
        : issue === 'perdu'
          ? '<p class="text-sm text-slate-600">Pourquoi ce client est-il perdu ? Ça sert à comprendre ce qui fait perdre des ventes.</p>' + selectMotif()
            + '<textarea name="note" rows="2" maxlength="1000" placeholder="Précision (facultatif)" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm"></textarea>'
          : '<p class="text-sm text-slate-600">Le dossier redevient ouvert, avec un rappel dans l’heure.</p>';
      content.innerHTML = '<form id="form-cloture" class="space-y-4">' + corps
        + '<div class="flex flex-wrap items-center gap-2"><button type="submit" class="btn btn-primary">' + (issue === 'rouvrir' ? 'Rouvrir' : 'Valider et continuer →') + '</button>'
        + '<button type="button" data-role="annuler" class="btn btn-ghost text-sm">Annuler</button><span class="js-res w-full text-sm"></span></div></form>';
      var form = document.getElementById('form-cloture');
      form.querySelector('[data-role="annuler"]').addEventListener('click', closeModal);
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var verrou = verrouEnvoi(form);
        if (!verrou) return;
        var body = { issue: issue };
        if (issue === 'gagne') { body.confirme = !!(form.confirme && form.confirme.checked); body.moyen = form.moyen ? form.moyen.value : ''; }
        if (issue === 'perdu') { body.motif = form.motif.value; body.note = form.note ? form.note.value : ''; }
        postJson('/admin/api/leads/' + leadId + '/cloturer', body).then(function (d) {
          if (d && d.ok) {
            toast(d.message || 'Enregistré');
            closeModal();
            /* Un dossier clos quitte la file : on passe au client suivant. */
            allerA(issue === 'rouvrir' ? leadId : (idSuivant(leadId, 1) || idSuivant(leadId, -1)));
          } else {
            verrou.echec();
            form.querySelector('.js-res').innerHTML = '<span class="font-semibold text-red-700">' + escapeHtml((d && d.error) || 'Erreur, réessaie.') + '</span>';
          }
        }).catch(function () { verrou.echec(); form.querySelector('.js-res').innerHTML = '<span class="font-semibold text-red-700">Erreur réseau</span>'; });
      });
    });
  });

  /* Le menu « Équipe » se ferme comme les autres. */
  document.addEventListener('click', function (e) {
    Array.prototype.forEach.call(document.querySelectorAll('details.equipe-menu[open]'), function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
  });

  /* ─ Au chargement : le client demandé (?lead=…), sinon le premier de la
       liste sur grand écran. Sur téléphone, on montre d'abord la liste. ─ */
  (function demarrer() {
    ajusterHauteurs();
    var demande = '';
    try { demande = new URL(window.location.href).searchParams.get('lead') || ''; } catch (_) {}
    if (demande && selectionner(demande, { defiler: true })) { ajusterHauteurs(); return; }
    if (!estSplit()) return;
    var premiere = document.querySelector('details[open] .lead-ligne') || document.querySelector('.lead-ligne');
    if (premiere) selectionner(premiere.dataset.leadId, { defiler: false, ouvrir: false });
  })();

  /* Un seul menu « Autres » ouvert à la fois ; un clic ailleurs le ferme. */
  document.addEventListener('click', function (e) {
    document.querySelectorAll('details.lead-menu[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); });
  });
  /* Le menu se ferme dès qu'on choisit une action. */
  document.querySelectorAll('details.lead-menu button, details.lead-menu a').forEach(function (el) {
    el.addEventListener('click', function () { var d = el.closest('details'); if (d) d.removeAttribute('open'); });
  });

  // ─ Action: email / sms / whatsapp ─
  document.querySelectorAll('.lead-action').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var action = btn.dataset.action;
      var leadId = btn.dataset.leadId;
      openModal('Chargement…');
      content.innerHTML = '<div class="text-sm text-slate-500">Chargement du lead…</div>';

      fetchLeadDetail(leadId)
        .then(function (data) {
          if (!data || !data.ok || !data.cart) {
            content.innerHTML = '<div class="text-sm text-red-500">Erreur : impossible de charger le lead.</div>';
            return;
          }
          if (action === 'email') openEmailModal(leadId, data.cart);
          else if (action === 'sms') openSmsModal(leadId, data.cart, btn.dataset.smsTemplate || '');
          else if (action === 'whatsapp') openWhatsAppModal(leadId, data.cart, btn.dataset.smsTemplate || '');
        })
        .catch(function () {
          content.innerHTML = '<div class="text-sm text-red-500">Erreur réseau.</div>';
        });
    });
  });

  /* ══ Report en un clic : « +2 h » / « Demain » ══
     Repousser une échéance demandait d'ouvrir « Planifier », choisir la suite,
     choisir quand, valider. Quatre clics pour dire « pas maintenant » : au
     bout du compte personne ne le faisait, et la file affichait des retards
     qui n'en étaient pas. */
  Array.prototype.forEach.call(document.querySelectorAll('.js-reporter'), function (b) {
    b.addEventListener('click', function () {
      if (b.dataset.enCours === '1') return;
      b.dataset.enCours = '1';
      b.classList.add('opacity-60');
      var id = b.getAttribute('data-lead-id');
      function rendreLeBouton() { b.dataset.enCours = ''; b.classList.remove('opacity-60'); }
      postJson('/admin/api/leads/' + id + '/prochaine-action', {
        type: b.getAttribute('data-type') || 'callback',
        quand: b.getAttribute('data-quand') || '2h',
      }).then(function (d) {
        if (d && d.ok) { toast(d.message || 'Reporté'); allerA(idSuivant(id, 1) || id); return; }
        rendreLeBouton();
        toast((d && d.error) || 'Erreur, réessaie.', 'error');
      }).catch(function () { rendreLeBouton(); toast('Erreur réseau', 'error'); });
    });
  });

  /* ══ Ce qui arrive pendant qu'on travaille ══
     La file est rendue par le serveur : un lead reçu à 10 h 02 restait
     invisible jusqu'au prochain F5, et la promesse « rappelé dans l'heure »
     se jouait à la chance. On compte, on le dit, on propose d'actualiser —
     on ne recharge jamais tout seul : un message à moitié écrit serait perdu. */
  (function nouveautes() {
    var zone = document.getElementById('leads-nouveautes');
    var texte = document.getElementById('leads-nouveautes-texte');
    var sonBtn = document.getElementById('leads-son-btn');
    var sonIcone = document.getElementById('leads-son-icone');
    if (!zone || !texte || !HORLOGE || !HORLOGE.nowIso) return;
    var titreOrigine = document.title;
    var dernierTotal = 0;
    var avecSon = false;
    try { avecSon = localStorage.getItem('leads-son') === '1'; } catch (_) {}

    function majBoutonSon() {
      if (!sonBtn || !sonIcone) return;
      sonIcone.textContent = avecSon ? 'notifications_active' : 'notifications_off';
      sonBtn.classList.toggle('text-primary', avecSon);
      sonBtn.classList.toggle('border-primary/40', avecSon);
      sonBtn.title = avecSon ? 'Bip à chaque arrivée — cliquer pour couper' : 'Être prévenu par un bip quand une demande arrive';
    }
    /* Bip court fabriqué à la volée : pas de fichier son à charger, et le
       navigateur n'autorise le son qu'après un clic — celui du bouton. */
    function bip() {
      if (!avecSon) return;
      try {
        var Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) return;
        var ctx = new Ctx();
        var o = ctx.createOscillator();
        var g = ctx.createGain();
        o.frequency.value = 880;
        o.connect(g); g.connect(ctx.destination);
        g.gain.setValueAtTime(0.0001, ctx.currentTime);
        g.gain.exponentialRampToValueAtTime(0.15, ctx.currentTime + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.3);
        o.start();
        o.stop(ctx.currentTime + 0.32);
        setTimeout(function () { try { ctx.close(); } catch (_) {} }, 600);
      } catch (_) {}
    }
    if (sonBtn) {
      majBoutonSon();
      sonBtn.addEventListener('click', function () {
        avecSon = !avecSon;
        try { localStorage.setItem('leads-son', avecSon ? '1' : '0'); } catch (_) {}
        majBoutonSon();
        bip();
        toast(avecSon ? 'Bip activé quand une demande arrive' : 'Bip coupé', 'info');
      });
    }

    function verifier() {
      if (document.visibilityState === 'hidden') return;
      fetch('/admin/api/leads/file/nouveautes?depuis=' + encodeURIComponent(HORLOGE.nowIso),
        { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d || !d.ok) return;
          var total = d.nouvelles || 0;
          if (!total) return;
          var bouts = [];
          if (d.nouvelles) bouts.push(d.nouvelles + ' nouvelle' + (d.nouvelles > 1 ? 's' : '') + ' demande' + (d.nouvelles > 1 ? 's' : ''));
          texte.textContent = bouts.join(' · ');
          zone.classList.remove('hidden');
          zone.classList.add('flex');
          document.title = '(' + total + ') ' + titreOrigine;
          if (total > dernierTotal) bip();
          dernierTotal = total;
        })
        .catch(function () {});
    }
    zone.addEventListener('click', function (e) { e.preventDefault(); window.location.reload(); });
    setInterval(verifier, 60000);
    document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible') verifier(); });
    setTimeout(verifier, 15000);
  })();

  /* ══ Traiter plusieurs dossiers d'un coup ══
     « Anciens dossiers » compte des centaines de demandes mortes qu'il fallait
     clôturer une par une : personne ne le faisait, et le groupe ne désemplissait
     jamais. Rien n'est supprimé — un dossier clôturé par erreur se rouvre
     depuis sa fiche. */
  var lotSelection = {};

  function lotIds() { return Object.keys(lotSelection); }

  function lotMajCase(l) {
    var i = l.querySelector('.lead-case .material-symbols-outlined');
    if (i) i.textContent = l.getAttribute('aria-checked') === 'true' ? 'check_box' : 'check_box_outline_blank';
  }

  function lotMajCompte() {
    var el = document.getElementById('leads-lot-compte');
    if (!el) return;
    var n = lotIds().length;
    el.textContent = n + ' sélectionné' + (n > 1 ? 's' : '');
    ['leads-lot-prendre', 'leads-lot-perdu'].forEach(function (id) {
      var b = document.getElementById(id);
      if (b) { b.disabled = !n; b.classList.toggle('opacity-40', !n); b.classList.toggle('cursor-not-allowed', !n); }
    });
  }

  function lotBasculer(l) {
    var id = l.dataset.leadId;
    var coche = l.getAttribute('aria-checked') !== 'true';
    l.setAttribute('aria-checked', coche ? 'true' : 'false');
    if (coche) lotSelection[id] = true; else delete lotSelection[id];
    lotMajCase(l);
    lotMajCompte();
  }

  (function modeLot() {
    var btn = document.getElementById('leads-lot-btn');
    var barre = document.getElementById('leads-lot-barre');
    if (!btn || !barre || !split) return;

    function activer(on) {
      split.dataset.selection = on ? '1' : '';
      barre.classList.toggle('hidden', !on);
      btn.classList.toggle('bg-slate-900', on);
      btn.classList.toggle('text-white', on);
      if (!on) {
        lotSelection = {};
        toutesLignes().forEach(function (l) { l.setAttribute('aria-checked', 'false'); lotMajCase(l); });
      }
      lotMajCompte();
    }
    btn.addEventListener('click', function () { activer(split.dataset.selection !== '1'); });
    document.getElementById('leads-lot-annuler').addEventListener('click', function () { activer(false); });
    document.getElementById('leads-lot-tout').addEventListener('click', function () {
      var toutes = lignes();
      var aCocher = toutes.some(function (l) { return l.getAttribute('aria-checked') !== 'true'; });
      toutes.forEach(function (l) {
        l.setAttribute('aria-checked', aCocher ? 'true' : 'false');
        if (aCocher) lotSelection[l.dataset.leadId] = true; else delete lotSelection[l.dataset.leadId];
        lotMajCase(l);
      });
      lotMajCompte();
    });

    function envoyer(corps, apres) {
      return postJson('/admin/api/leads/lot', corps).then(function (d) {
        if (d && d.ok) { toast(d.message || 'Fait'); setTimeout(function () { window.location.reload(); }, 600); return true; }
        toast((d && d.error) || 'Erreur, réessaie.', 'error');
        if (apres) apres();
        return false;
      }).catch(function () { toast('Erreur réseau', 'error'); if (apres) apres(); return false; });
    }

    document.getElementById('leads-lot-prendre').addEventListener('click', function () {
      var ids = lotIds();
      if (!ids.length) return;
      envoyer({ action: 'prendre', ids: ids });
    });

    document.getElementById('leads-lot-perdu').addEventListener('click', function () {
      var ids = lotIds();
      if (!ids.length) return;
      openModal('Clôturer ' + ids.length + ' dossier' + (ids.length > 1 ? 's' : '') + ' en perdu');
      content.innerHTML = '<form id="form-lot-perdu" class="space-y-4">'
        + '<p class="text-sm text-slate-600"><strong>' + ids.length + ' dossier' + (ids.length > 1 ? 's' : '') + '</strong> vont passer en perdu avec le même motif. '
        + 'Les dossiers déjà gagnés sont ignorés, et un dossier clôturé par erreur se rouvre depuis sa fiche.</p>'
        + selectMotif()
        + '<textarea name="note" rows="2" maxlength="500" placeholder="Précision (facultatif) — la même pour tous" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm"></textarea>'
        + '<div class="flex flex-wrap items-center gap-2"><button type="submit" class="btn btn-primary">Clôturer les ' + ids.length + '</button>'
        + '<button type="button" data-role="annuler" class="btn btn-ghost text-sm">Annuler</button><span class="js-res w-full text-sm"></span></div></form>';
      var form = document.getElementById('form-lot-perdu');
      form.querySelector('[data-role="annuler"]').addEventListener('click', closeModal);
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.motif.value) { form.querySelector('.js-res').innerHTML = '<span class="font-semibold text-red-700">Choisis le motif de perte.</span>'; return; }
        var verrou = verrouEnvoi(form);
        if (!verrou) return;
        envoyer({ action: 'perdu', ids: ids, motif: form.motif.value, note: form.note.value }, verrou.echec)
          .then(function (ok) { if (ok) closeModal(); });
      });
    });

    lotMajCompte();
  })();

  /* ══ Horloge : les couleurs restent justes sans recharger ══
     Un commercial garde cet écran ouvert toute la matinée : une ligne dont
     l'heure venait de passer gardait sa couleur du rendu. Toutes les 30 s, on
     recolore le point des lignes dont l'échéance est passée. Plus aucun texte
     n'est réécrit (comptes à rebours et « attend 2 h 10 » retirés les 19 et
     20/11/2026). Le temps écoulé se compte dans les plages d'ouverture
     envoyées par le serveur. */
  (function horloge() {
    var H = window.LeadsHorloge;
    if (!H || !HORLOGE || !HORLOGE.nowIso) return;
    var plages = H.preparer(HORLOGE.plages);
    var rendu = Date.parse(HORLOGE.nowIso);
    if (!plages.length || !rendu) return;

    /* Teintes de la barre posées par le serveur, à changer quand l'heure passe. */
    var TONS_BARRE = ['bg-blue-500', 'bg-amber-400', 'bg-green-500', 'bg-slate-300', 'bg-red-500'];

    function rougir(el, tons, rouge) {
      if (!el || el.classList.contains(rouge)) return;
      tons.forEach(function (t) { el.classList.remove(t); });
      el.classList.add(rouge);
    }

    function majBloc(el, ecoule, maintenant) {
      var due = el.getAttribute('data-due');
      var retardRendu = Number(el.getAttribute('data-retard')) || 0;
      var promesse = el.getAttribute('data-promesse') === '1';

      /* Retard : celui du rendu qui grandit, ou celui d'une échéance qui vient
         de passer sous les yeux du commercial. */
      var retard = retardRendu > 0 ? retardRendu + ecoule
        : (due && maintenant > Date.parse(due)) ? H.minutesOuvrees(plages, Date.parse(due), maintenant) : 0;
      /* Plus aucun texte réécrit (« Retard 9 min », « avant 14:00 ») : le
         patron les trouvait polluants. Quand l'heure passe sous les yeux du
         commercial, seule la barre change de couleur — rouge pour une heure
         promise, ambre pour une relance que la file propose. */
      if (retard > 0) {
        rougir(el.querySelector('[data-role="barre"]'), TONS_BARRE, promesse ? 'bg-red-500' : 'bg-amber-400');
      }

    }

    function tic() {
      if (document.visibilityState === 'hidden') return;
      var maintenant = Date.now();
      var ecoule = H.minutesOuvrees(plages, rendu, maintenant);
      Array.prototype.forEach.call(document.querySelectorAll('.lead-ligne[data-attente], .lead-fiche[data-attente]'), function (el) {
        majBloc(el, ecoule, maintenant);
      });
    }

    setInterval(tic, 30000);
    /* De retour sur l'onglet après une pause : on remet l'heure tout de suite. */
    document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible') tic(); });
  })();
})();
</script>


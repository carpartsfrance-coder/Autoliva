  /* Ajout d'une note : sans recharger la page, l'historique se met à jour. */
  function brancherNote(zone, leadId, fiche) {
    var form = zone.querySelector('[data-role="note-form"]');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var ta = form.querySelector('textarea');
      var res = form.querySelector('[data-role="note-res"]');
      if (!ta.value.trim()) { res.innerHTML = '<span class="text-amber-700">Écris d’abord la note.</span>'; return; }
      var verrou = verrouEnvoi(form);
      if (!verrou) return;
      postJson('/admin/api/leads/' + leadId + '/note', { text: ta.value }).then(function (d) {
        if (d && d.ok) { delete detailCache[leadId]; toast('Note ajoutée'); afficherOnglet(fiche, 'suivi'); }
        else { verrou.echec(); res.innerHTML = '<span class="text-red-700">' + escapeHtml((d && d.error) || 'Erreur') + '</span>'; }
      }).catch(function () { verrou.echec(); res.innerHTML = '<span class="text-red-700">Erreur réseau</span>'; });
    });
  }

  /* Demande fournisseur : un seul texte, celui du serveur. Le front change de
     destinataire et remplit les blancs (pièce, VIN, références). */
  function brancherFournisseur(zone, c, leadId) {
    var bloc = zone.querySelector('[data-bloc="fournisseur"]');
    if (!bloc || !c.fournisseur) return;
    var F = c.fournisseur;
    function q(role) { return bloc.querySelector('[data-role="' + role + '"]'); }
    var cible = q('fourn-cible'), corps = q('fourn-corps'), piece = q('fourn-piece'), vin = q('fourn-vin'),
      vinBloc = q('fourn-vin-bloc'), refs = q('fourn-refs'), refsBloc = q('fourn-refs-bloc'),
      mailto = q('fourn-mailto'), mail = q('fourn-mail'), retour = q('fourn-retour');

    function courantF() { return F.demandes[cible.value]; }
    function remplir(texte, d) {
      var p = (piece.value || '').trim();
      var v = (vin.value || '').trim().toUpperCase();
      var r = (refs.value || '').trim();
      if (p) texte = texte.split('Demande client : ' + F.aRemplir).join('Demande client : ' + p);
      if (v) texte = texte.split('VIN : ' + F.aRemplir).join('VIN : ' + v);
      if (r && d && d.refsLibelle) texte = texte.split(d.refsLibelle + ' : ' + F.aRemplir).join(d.refsLibelle + ' : ' + r);
      return texte;
    }
    function objetCourant(d) {
      var p = (piece.value || '').trim();
      if (!p) return d.objet;
      return d.objet.split(F.aRemplir).join(p.length > 60 ? p.slice(0, 59).trim() + '…' : p);
    }
    function majMailto() {
      var d = courantF();
      if (!d) { mailto.removeAttribute('href'); return; }
      mailto.href = 'mailto:' + d.email + '?subject=' + encodeURIComponent(objetCourant(d)) + '&body=' + encodeURIComponent(corps.value);
    }
    function rendre() {
      var d = courantF();
      if (!d) {
        corps.value = '';
        corps.placeholder = 'Choisis d’abord le fournisseur ci-dessus.';
        mail.textContent = '';
        vinBloc.classList.add('hidden');
        refsBloc.classList.add('hidden');
        mailto.removeAttribute('href');
        return;
      }
      corps.value = remplir(d.corps, d);
      mail.textContent = d.email;
      vinBloc.classList.toggle('hidden', !d.vinRequis);
      refsBloc.classList.toggle('hidden', !d.refsRequises);
      majMailto();
    }
    cible.addEventListener('change', rendre);
    piece.addEventListener('input', rendre);
    vin.addEventListener('input', rendre);
    refs.addEventListener('input', rendre);
    corps.addEventListener('input', majMailto);
    Array.prototype.forEach.call(bloc.querySelectorAll('[data-role="fourn-sugg"]'), function (b) {
      b.addEventListener('click', function () { piece.value = F.suggestions[Number(b.dataset.i)] || ''; rendre(); piece.focus(); });
    });
    function dire(t) { retour.textContent = t; setTimeout(function () { retour.textContent = ''; }, 2500); }
    q('fourn-copier').addEventListener('click', function () {
      if (!corps.value.trim()) { dire('Choisis un fournisseur'); return; }
      corps.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(corps.value).then(function () { dire('Copié'); }, function () { dire(ok ? 'Copié' : 'Copie impossible — Ctrl+C'); });
      } else dire(ok ? 'Copié' : 'Copie impossible — Ctrl+C');
    });
    /* Trace la démarche sur la fiche : sinon personne ne sait si le fournisseur a été relancé. */
    q('fourn-fait').addEventListener('click', function () {
      var d = courantF();
      if (!d) { dire('Choisis un fournisseur'); return; }
      postJson('/admin/api/leads/' + leadId + '/note', { text: 'Demande de tarif envoyée à ' + d.contact + ' (' + d.email + ')' })
        .then(function (j) { if (j && j.ok) delete detailCache[leadId]; dire(j && j.ok ? 'Noté dans le suivi' : 'Échec de l’enregistrement'); })
        .catch(function () { dire('Échec de l’enregistrement'); });
    });
    rendre();
  }

  // ─ Relance auto manuelle : envoie tout de suite l'email n° suivant du cycle ─
  document.querySelectorAll('.lead-remind-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var n = btn.dataset.next || '';
      if (!confirm('Envoyer maintenant l’email de relance automatique n°' + n + ' à ce client ?')) return;
      btn.disabled = true;
      btn.style.opacity = '0.5';
      fetch('/admin/relances/' + btn.dataset.leadId + '/relancer', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.ok) refresh();
          else { alert('Erreur : ' + (d && d.error ? d.error : 'inconnue')); btn.disabled = false; btn.style.opacity = ''; }
        })
        .catch(function () { alert('Erreur réseau'); btn.disabled = false; btn.style.opacity = ''; });
    });
  });

  // ─ Templates injectés depuis le serveur ─
  var EMAIL_TEMPLATES = <%- JSON.stringify(emailTemplates || []) %>;
  var SMS_TEMPLATES = <%- JSON.stringify(smsTemplates || []) %>;

  /* La même liste alimente le composeur SMS et le composeur WhatsApp, mais les
     deux canaux n'ont pas les mêmes règles (en SMS le client ne peut pas
     répondre et les liens sont jetés). Un modèle peut donc déclarer
     `channels: ['whatsapp']` ; sans ce champ il reste proposé partout. */
  function smsTemplatesFor(channel) {
    return SMS_TEMPLATES.filter(function (t) {
      return !t.channels || t.channels.indexOf(channel) >= 0;
    });
  }

  /* Le lead n'a ni plaque ni VIN → on ne peut rien lui confirmer. Le composeur
     préselectionne alors le modèle qui réclame l'info plutôt qu'un modèle de
     relance commerciale qui tomberait à plat. Concerne 45 % des leads. */
  function leadMissesPlate(c) {
    var r = (c && c.requested) || {};
    return !String(r.plate || '').trim() && !String(r.vin || '').trim();
  }

  var EMAIL_VARIABLES = [
    { key: 'prenom', label: 'Prénom' },
    { key: 'nom', label: 'Nom' },
    { key: 'nom_produit', label: 'Produit' },
    { key: 'prix_total', label: 'Prix total' },
    { key: 'lien_panier', label: 'Lien panier sauvegardé' },
    { key: 'lien_produit', label: 'Lien produit' },
    { key: 'nom_commercial', label: 'Mon nom' },
    { key: 'telephone', label: 'Téléphone société' },
    { key: 'brand', label: 'Marque' },
  ];

  function fetchLeadDetail(leadId) {
    return fetch('/admin/activite-panier/' + leadId, { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); });
  }

  function renderLeadHeader(c) {
    var name = ((c.firstName || '') + ' ' + (c.lastName || '')).trim() || c.email || c.phone || 'Anonyme';
    var emailsCount = c.manualEmailsSent || 0;
    var smsCount = c.manualSmsSent || 0;
    var isDevisOrContact = c.captureSource === 'devis' || c.captureSource === 'contact';
    var hasReq = c.hasRequested || (c.requested && (c.requested.ref || c.requested.vehicle || c.requested.vin));

    var html = ''
      + '<div class="rounded-xl bg-gradient-to-br from-slate-50 to-slate-100 border border-slate-200 p-4 mb-4">'
      + '  <div class="flex items-start gap-3">';

    /* Visual: pour devis/contact avec demande, on montre une icône, pas le produit du panier */
    if (isDevisOrContact && hasReq) {
      html += '<div class="w-14 h-14 rounded-lg bg-teal-50 border border-teal-200 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-teal-600">request_quote</span></div>';
    } else if (c.items && c.items[0] && c.items[0].image) {
      html += '<img src="' + escapeHtml(c.items[0].image) + '" alt="" class="w-14 h-14 rounded-lg object-cover border border-slate-200 flex-shrink-0" />';
    } else {
      html += '<div class="w-14 h-14 rounded-lg bg-slate-200 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-slate-400">person</span></div>';
    }

    html += '<div class="flex-1 min-w-0">'
      + '<div class="font-semibold text-slate-900 text-sm">' + escapeHtml(name) + '</div>'
      + '<div class="text-xs text-slate-500 mt-0.5 space-y-0.5">';
    if (c.email) html += '<div>📧 ' + escapeHtml(c.email) + '</div>';
    if (c.phone) html += '<div>📞 ' + escapeHtml(c.phone) + '</div>';
    html += '</div>';

    /* Section principale : demande explicite si devis/contact, sinon panier */
    if (isDevisOrContact && hasReq) {
      var bits = [];
      if (c.requested.ref) bits.push(escapeHtml(c.requested.ref));
      if (c.requested.vehicle) bits.push(escapeHtml(c.requested.vehicle));
      if (c.requested.vin) bits.push('VIN ' + escapeHtml(c.requested.vin));
      else if (c.requested.plate) bits.push(escapeHtml(c.requested.plate));
      html += '<div class="mt-2 rounded-md bg-teal-50/60 border border-teal-100 px-2 py-1.5">'
        + '<div class="text-[10px] uppercase tracking-wider text-teal-700 font-semibold">Demande</div>'
        + '<div class="text-sm font-medium text-slate-900">' + (bits.length ? bits.join(' · ') : '<span class="text-slate-400 italic">sans détails</span>') + '</div>';
      if (c.requested.message) {
        html += '<div class="text-xs text-slate-600 italic mt-0.5">"' + escapeHtml(c.requested.message.slice(0, 140)) + (c.requested.message.length > 140 ? '…' : '') + '"</div>';
      }
      html += '</div>';
      if (c.items && c.items.length) {
        html += '<div class="mt-1 text-xs text-amber-700">⚠ Avait aussi en panier : ' + escapeHtml(c.items[0].name) + ' · ' + escapeHtml(c.totalAmount || '—') + '</div>';
      }
    } else {
      html += '<div class="mt-2 text-sm text-slate-700">'
        + '<span class="font-semibold">' + escapeHtml(c.totalAmount || '—') + '</span>';
      if (c.items && c.items.length) {
        html += ' · ' + escapeHtml(c.items[0].name) + (c.items.length > 1 ? ' +' + (c.items.length - 1) : '');
      }
      html += '</div>';
    }

    html += '<div class="mt-1 text-xs text-slate-400">'
      + (c.captureSourceLabel ? 'Source : ' + escapeHtml(c.captureSourceLabel) : '')
      + (c.lastActivityAt ? ' · Vu ' + escapeHtml(c.lastActivityAt) : '')
      + '</div>'
      + '<div class="mt-1 text-xs text-slate-400">';
    if (emailsCount) html += '<span>📧 ' + emailsCount + ' email(s) envoyé(s)</span>';
    if (emailsCount && smsCount) html += ' · ';
    if (smsCount) html += '<span>📱 ' + smsCount + ' SMS</span>';
    if (!emailsCount && !smsCount) html += '<span class="text-slate-300">Aucun contact manuel pour l’instant</span>';
    html += '</div>'
      + '</div></div></div>';
    return html;
  }

  function buildVariablesToolbar(targetId) {
    var html = '<div class="flex flex-wrap gap-1 mb-2">';
    html += '<span class="text-xs text-slate-400 mr-1 self-center">Insérer :</span>';
    EMAIL_VARIABLES.forEach(function (v) {
      html += '<button type="button" class="var-insert-btn px-2 py-0.5 text-xs rounded-md border border-slate-200 bg-white hover:bg-blue-50 hover:border-blue-300 text-slate-700" '
        + 'data-var="{' + v.key + '}" data-target="' + targetId + '" title="' + escapeHtml(v.label) + '">{' + v.key + '}</button>';
    });
    html += '</div>';
    return html;
  }

  function attachVariableInserters(scope) {
    scope.querySelectorAll('.var-insert-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var targetId = btn.dataset.target;
        var token = btn.dataset.var;
        var target = document.getElementById(targetId);
        if (!target) return;
        var start = target.selectionStart || 0;
        var end = target.selectionEnd || 0;
        target.value = target.value.slice(0, start) + token + target.value.slice(end);
        target.focus();
        target.selectionStart = target.selectionEnd = start + token.length;
        target.dispatchEvent(new Event('input'));
      });
    });
  }

  function insertAtCursor(target, token) {
    if (!target) return;
    var start = target.selectionStart || 0;
    var end = target.selectionEnd || 0;
    target.value = target.value.slice(0, start) + token + target.value.slice(end);
    target.focus();
    target.selectionStart = target.selectionEnd = start + token.length;
    target.dispatchEvent(new Event('input'));
  }

  // ─ Picker « Ajouter un article » : recherche le catalogue et insère au
  //   curseur un token [[article|sku|prix|libellé]] → rendu en lien naturel
  //   côté serveur (le prix affiché est modifiable dans le token). ─
  function buildArticlePicker(targetId) {
    return '<div class="mb-2">'
      + '<button type="button" id="' + targetId + '-artbtn" class="inline-flex items-center gap-1 px-2 py-1 text-xs rounded-md border border-blue-200 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold">'
      + '<span class="material-symbols-outlined text-sm">add_shopping_cart</span>Ajouter un article</button>'
      + '<span class="text-[11px] text-slate-400 ml-2">→ insère un lien naturel dans ton message</span>'
      + '<div id="' + targetId + '-artbox" class="hidden mt-2 rounded-lg border border-slate-200 bg-white p-2">'
      + '<input type="text" id="' + targetId + '-artq" placeholder="Réf, modèle, moteur… (ex : Z20DMH, DSG, culasse Opel)" autocomplete="off" class="w-full rounded-md border border-slate-200 px-2 py-1.5 text-sm mb-1" />'
      + '<div id="' + targetId + '-artres" class="max-h-56 overflow-auto"></div>'
      + '</div></div>';
  }

  function attachArticlePicker(scope, targetId) {
    var toggle = scope.querySelector('#' + targetId + '-artbtn');
    var box = scope.querySelector('#' + targetId + '-artbox');
    var input = scope.querySelector('#' + targetId + '-artq');
    var results = scope.querySelector('#' + targetId + '-artres');
    var target = document.getElementById(targetId);
    if (!toggle || !box || !input || !results || !target) return;
    var timer = null, lastQ = null, reqSeq = 0;

    toggle.addEventListener('click', function () {
      box.classList.toggle('hidden');
      if (!box.classList.contains('hidden')) { input.focus(); if (lastQ === null) doSearch(''); }
    });
    input.addEventListener('input', function () {
      var q = input.value.trim();
      if (timer) clearTimeout(timer);
      timer = setTimeout(function () { doSearch(q); }, 250);
    });

    function doSearch(q) {
      lastQ = q;
      var seq = ++reqSeq;
      results.innerHTML = '<div class="px-2 py-2 text-xs text-slate-400">Recherche…</div>';
      fetch('/admin/api/products/search?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) { if (seq === reqSeq) renderResults((d && d.items) || []); })
        .catch(function () { if (seq === reqSeq) results.innerHTML = '<div class="px-2 py-2 text-xs text-red-600">Erreur de recherche</div>'; });
    }

    function renderResults(items) {
      if (!items.length) { results.innerHTML = '<div class="px-2 py-3 text-xs text-slate-400">Aucun article trouvé.</div>'; return; }
      results.innerHTML = '';
      items.slice(0, 12).forEach(function (p) {
        var price = Math.round((p.priceCents || 0) / 100);
        var row = document.createElement('button');
        row.type = 'button';
        row.className = 'w-full text-left flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-blue-50';
        row.innerHTML = '<span class="material-symbols-outlined text-slate-400 text-base flex-shrink-0">description</span>'
          + '<span class="flex-1 min-w-0"><span class="block text-xs text-slate-800 truncate">' + escapeHtml(p.name || '') + '</span>'
          + '<span class="block text-[11px] text-slate-400 truncate">' + escapeHtml((p.sku || '') + (p.brand ? ' · ' + p.brand : '')) + '</span></span>'
          + '<span class="text-xs font-semibold text-slate-700 whitespace-nowrap">' + price.toLocaleString('fr-FR') + ' €</span>'
          + '<span class="text-[11px] text-blue-600 font-semibold whitespace-nowrap">+ insérer</span>';
        row.addEventListener('click', function () {
          var label = String(p.name || '').replace(/[|\]]/g, ' ').replace(/\s+/g, ' ').trim();
          var sku = String(p.sku || '').replace(/[|\]]/g, '');
          insertAtCursor(target, '[[article|' + sku + '|' + price + '|' + label + ']]');
          box.classList.add('hidden');
          input.value = '';
          lastQ = null;
          results.innerHTML = '';
        });
        results.appendChild(row);
      });
    }
  }

  // ─ Reformulation IA (ChatGPT) d'un message du composer, avant envoi ─
  function reformulateComposer(textarea, channel, btn, resultEl, clientName, onDone) {
    var draft = (textarea.value || '').trim();
    if (!draft) { if (resultEl) resultEl.innerHTML = '<span class="text-amber-600">Écris d\'abord un message à reformuler.</span>'; return; }
    var prev = textarea.value;
    var origHtml = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = '⏳ Reformulation…';
    fetch('/admin/api/messages/reformulate', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
      body: JSON.stringify({ draft: draft, channel: channel, clientName: clientName || '' })
    }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        btn.disabled = false; btn.innerHTML = origHtml;
        if (!res.ok || !res.j || !res.j.ok) { if (resultEl) resultEl.innerHTML = '<span class="text-red-700">' + escapeHtml((res.j && res.j.error) || 'Erreur IA') + '</span>'; return; }
        textarea.value = res.j.reformulated;
        if (onDone) onDone();
        if (resultEl) {
          resultEl.innerHTML = '<span class="text-indigo-600">✨ Reformulé par l\'IA. </span><button type="button" id="' + textarea.id + '-undo" class="underline font-semibold text-indigo-600 text-sm">Annuler</button>';
          var u = document.getElementById(textarea.id + '-undo');
          if (u) u.addEventListener('click', function () { textarea.value = prev; if (onDone) onDone(); resultEl.textContent = ''; });
        }
      }).catch(function () { btn.disabled = false; btn.innerHTML = origHtml; if (resultEl) resultEl.innerHTML = '<span class="text-red-700">Erreur réseau — réessaie.</span>'; });
  }


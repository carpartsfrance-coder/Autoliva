<%- include('./partials/head') %>

<%- include('./partials/sidebar', { active: 'cart-activity' }) %>

<style>
  /* Vue « boîte mail » : la liste des clients à gauche, le client sélectionné
     à droite. Écran étroit (téléphone, petite tablette) : la liste, puis la
     fiche en plein écran avec « ← Liste ». Le seuil suit la largeur réelle de
     la zone (barre latérale ouverte ou non), pas celle de l'écran. */
  .file-split { container-type: inline-size; }
  .file-cols { display: block; }
  .file-fiche-col { display: none; }
  .file-split[data-mode="fiche"] .file-liste-col,
  .file-split[data-mode="fiche"] .masque-en-fiche { display: none; }
  .file-split[data-mode="fiche"] .file-fiche-col { display: block; }
  @container (min-width: 900px) {
    .file-cols { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 1rem; align-items: start; }
    .file-split .file-liste-col, .file-split .file-fiche-col { display: block !important; overflow-y: auto; overscroll-behavior: contain; }
    .file-split .seul-mobile { display: none !important; }
    .file-split .groupe-entete { position: sticky; top: 0; }
  }
  .lead-ligne[aria-selected="true"] { background: #f1f5f9; }
  /* Mode « Sélectionner » : la case prend la place du trait de couleur. */
  .lead-case { position: absolute; left: .5rem; top: .55rem; display: none; color: #cbd5e1; }
  .file-split[data-selection="1"] .lead-ligne { padding-left: 2.25rem; }
  .file-split[data-selection="1"] .lead-case { display: block; }
  .lead-ligne[aria-checked="true"] { background: #eff6ff; }
  .lead-ligne[aria-checked="true"] .lead-case { color: #2563eb; }
  .fiche-onglet[aria-selected="true"] { border-color: #0f172a; color: #0f172a; }
  .lead-menu > summary::-webkit-details-marker, .equipe-menu > summary::-webkit-details-marker { display: none; }
  /* Onglets de la file : huit groupes empilés faisaient une colonne de gauche
     interminable, où « Nouvelles demandes » se retrouvait sous 168 retards. */
  .leads-onglet { display: inline-flex; align-items: center; gap: .4rem; white-space: nowrap;
    border-bottom: 2px solid transparent; padding: .55rem .7rem; font-size: .8125rem; font-weight: 600; color: #64748b; }
  .leads-onglet:hover { color: #0f172a; background: #f8fafc; }
  .leads-onglet[aria-selected="true"] { color: #0f172a; border-bottom-color: #64748b; }
  .leads-onglet[aria-selected="true"][data-ton="red"] { border-bottom-color: #dc2626; }
  .leads-onglet[aria-selected="true"][data-ton="amber"] { border-bottom-color: #f59e0b; }
  .leads-onglet[aria-selected="true"][data-ton="orange"] { border-bottom-color: #ea580c; }
  .leads-onglet[aria-selected="true"][data-ton="green"] { border-bottom-color: #16a34a; }
  .leads-onglet[aria-selected="true"][data-ton="blue"] { border-bottom-color: #2563eb; }
  .leads-onglet[aria-selected="true"][data-ton="yellow"] { border-bottom-color: #ca8a04; }
  .leads-onglet[aria-selected="true"][data-ton="rose"] { border-bottom-color: #e11d48; }
</style>

<main class="flex-1 min-w-0">
  <div id="file-split" class="file-split px-3 sm:px-5 lg:px-6 py-4" data-mode="liste">

    <!-- En-tête : titre, onglets, aide -->
    <div class="masque-en-fiche flex flex-wrap items-center gap-x-3 gap-y-2">
      <h1 class="text-xl md:text-2xl font-semibold text-slate-900 mr-1">Leads à traiter</h1>
      <div class="inline-flex rounded-xl border border-slate-200 bg-white p-0.5 text-sm font-semibold">
        <a href="<%= tabs.todoUrl %>" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 <%= view === 'todo' ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-50' %>" title="Les vraies demandes ouvertes, triées par urgence">
          À traiter <span class="rounded-full px-1.5 text-[11px] font-bold <%= view === 'todo' ? 'bg-white/20' : 'bg-slate-100 text-slate-600' %>"><%= tabs.todoCount %></span>
        </a>
        <a href="<%= tabs.allUrl %>" class="rounded-lg px-3 py-1.5 <%= view === 'all' ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-50' %>" title="Tout l'historique : paniers, newsletter, gagnés, perdus, avec la recherche">Tous les leads</a>
      </div>
      <div class="ml-auto flex gap-2">
        <% if (view === 'todo') { %>
          <button type="button" id="leads-lot-btn" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50" title="Traiter plusieurs dossiers d'un coup : prendre en charge, ou clôturer en perdu">
            <span class="material-symbols-outlined text-base text-primary">checklist</span><span class="hidden sm:inline">Sélectionner</span>
          </button>
          <button type="button" id="leads-son-btn" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50" title="Être prévenu par un bip quand une demande arrive">
            <span class="material-symbols-outlined text-base" id="leads-son-icone">notifications_off</span>
          </button>
        <% } %>
        <button type="button" id="leads-help-btn" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50">
          <span class="material-symbols-outlined text-base text-primary">school</span><span class="hidden sm:inline">Comment ça marche</span>
        </button>
        <a href="/admin/parametres/modeles-messages" class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50" title="Personnaliser les textes des SMS et emails">
          <span class="material-symbols-outlined text-base text-primary">edit_note</span><span class="hidden sm:inline">Modèles de messages</span>
        </a>
      </div>
    </div>

    <% if (view === 'todo' && bandeau) { %>
      <% var b = bandeau; var dl = b.delai || {}; var med = dl.mediane; %>
      <!-- Les chiffres du patron, sur une ligne -->
      <div class="masque-en-fiche mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm text-slate-600">
        <%/* « En retard » comptait aussi les relances que la file déduit du
              dernier contact : 168 un mardi matin, un chiffre que plus
              personne ne regardait. Ici, seules les heures PROMISES. */%>
        <span title="Un rendez-vous promis est passé, sur un dossier déjà pris en main. Les demandes que personne n'a touchées sont comptées dans « jamais contactés », pas ici.">
          <strong class="text-base <%= b.enRetard ? 'text-red-700' : 'text-slate-900' %>"><%= b.enRetard %></strong> en retard
        </span>
        <% if (b.aRelancer) { %>
          <span title="Sans nouvelles depuis plus de 2 jours ouvrés. Personne n'a promis cette date : c'est la file qui la propose."><strong class="text-base text-amber-700"><%= b.aRelancer %></strong> à relancer</span>
        <% } %>
        <% if (b.anciens) { %>
          <span title="En retard depuis plus de 7 jours ouvrés : à reprendre quand la file du jour est vide"><strong class="text-base text-slate-900"><%= b.anciens %></strong> ancien<%= b.anciens > 1 ? 's' : '' %></span>
        <% } %>
        <span title="Demandes ouvertes sur lesquelles personne n'a encore appelé ni écrit (les messages automatiques ne comptent pas)"><strong class="text-base text-slate-900"><%= b.jamaisPris %></strong> jamais contactés</span>
        <span title="Nouvelles demandes, rappels et devis prévus aujourd'hui (hors retards)"><strong class="text-base text-slate-900"><%= b.duJour %></strong> à faire aujourd’hui</span>
        <span title="Temps médian entre la demande du client et le premier appel ou message d'un commercial, en heures d'ouverture, sur les 30 derniers jours">
          <strong class="text-base text-slate-900"><% if (med === null || med === undefined) { %>—<% } else if (med < 60) { %><%= med %> min<% } else { %><%= Math.floor(med / 60) %> h <%= String(med % 60).padStart(2, '0') %><% } %></strong> pour répondre<% if (dl.pctDansLHeure !== null && dl.pctDansLHeure !== undefined) { %> <span class="text-slate-400">· <%= dl.pctDansLHeure %> % dans l’heure</span><% } %>
        </span>
        <% if (b.parPersonne && b.parPersonne.length) { %>
          <details class="equipe-menu relative ml-auto">
            <summary class="list-none inline-flex cursor-pointer items-center gap-1 rounded-lg px-2 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-100">
              <span class="material-symbols-outlined text-[16px]">group</span>Équipe<span class="material-symbols-outlined text-[16px]">expand_more</span>
            </summary>
            <div class="absolute right-0 z-30 mt-1 w-60 rounded-xl border border-slate-200 bg-white p-3 text-xs shadow-xl">
              <div class="mb-2 font-semibold text-slate-500">Dossiers en retard par personne</div>
              <% b.parPersonne.forEach(function (p) { %>
                <div class="flex items-center justify-between py-1"><span class="text-slate-700"><%= p.nom %></span><strong class="text-slate-900"><%= p.n %></strong></div>
              <% }) %>
            </div>
          </details>
        <% } %>
      </div>
    <% } else if (view === 'all') { %>
      <div class="masque-en-fiche mt-3 flex flex-wrap items-center gap-x-5 gap-y-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm text-slate-600" title="30 derniers jours, hors dossiers devis moteurs, boîtes et ponts, hors robots">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">30 jours</span>
        <span><strong class="text-base text-slate-900"><%= kpis.total %></strong> leads</span>
        <span><strong class="text-base text-slate-900"><%= kpis.uncontacted %></strong> jamais contactés</span>
        <span><strong class="text-base text-slate-900"><%= kpis.contacted %></strong> contactés</span>
        <span><strong class="text-base text-green-700"><%= kpis.converted %></strong> convertis <span class="text-slate-400">(<%= kpis.recoveryRate %> %)</span></span>
        <span title="Somme des paniers non convertis — indicatif"><strong class="text-base text-slate-900"><%= kpis.pendingValue || '0,00 €' %></strong> de paniers en attente</span>
      </div>
    <% } %>

    <%
      /* Les filtres en cours, à reporter dans chaque lien de la page : sans
         ça, trier ou déplier un groupe effaçait silencieusement le reste. */
      var filtresEnCours = Object.assign({},
        todoFilters.qui ? { qui: todoFilters.qui } : {},
        todoFilters.piece ? { piece: todoFilters.piece } : {},
        todoFilters.source ? { source: todoFilters.source } : {},
        todoFilters.suivi ? { suivi: todoFilters.suivi } : {},
        todoFilters.tri ? { tri: todoFilters.tri } : {});
    %>
    <% if (view === 'todo') { %>
      <!-- Recherche et filtres rapides -->
      <form action="/admin/activite-panier" method="GET" class="masque-en-fiche mt-3 flex flex-wrap items-center gap-2">
        <label class="relative min-w-[220px] flex-1">
          <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-slate-400">search</span>
          <input type="text" name="q" value="" placeholder="Chercher : nom, téléphone, email, plaque, n° de commande…" class="w-full rounded-xl border border-slate-200 bg-white py-2 pl-10 pr-3 text-sm" />
        </label>
        <div class="inline-flex shrink-0 rounded-xl border border-slate-200 bg-white p-0.5 text-xs font-semibold">
          <% [['', 'Toute l’équipe'], ['moi', 'Mes dossiers'], ['libre', 'Non pris']].forEach(function (o) { %>
            <% var qso = Object.assign({}, filtresEnCours); if (o[0]) { qso.qui = o[0]; } else { delete qso.qui; } var qs = new URLSearchParams(qso).toString(); %>
            <a href="/admin/activite-panier<%= qs ? '?' + qs : '' %>" class="whitespace-nowrap rounded-lg px-3 py-1.5 <%= todoFilters.qui === o[0] ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-50' %>"><%= o[1] %></a>
          <% }) %>
        </div>
        <% if (todoFilters.qui) { %><input type="hidden" name="qui" value="<%= todoFilters.qui %>"><% } %>
        <% if (todoFilters.tri) { %><input type="hidden" name="tri" value="<%= todoFilters.tri %>"><% } %>
        <%/* La pile de demandes vierges, sans sortir les dossiers en cours de
              la file de tout le monde : c'est ce qui avait laissé 197 demandes
              mortes quand « Contacté » les rangeait dans un autre onglet. */%>
        <select name="suivi" class="min-w-[150px] flex-1 sm:flex-none rounded-xl border border-slate-200 bg-white py-2 pl-3 pr-8 text-sm" onchange="this.form.q.value===''&&this.form.submit()">
          <option value="">Tous les dossiers</option>
          <option value="vierges" <%= todoFilters.suivi === 'vierges' ? 'selected' : '' %>>Jamais contactés</option>
          <option value="encours" <%= todoFilters.suivi === 'encours' ? 'selected' : '' %>>Déjà contactés</option>
        </select>
        <select name="piece" class="min-w-[140px] flex-1 sm:flex-none rounded-xl border border-slate-200 bg-white py-2 pl-3 pr-8 text-sm" onchange="this.form.q.value===''&&this.form.submit()">
          <option value="">Toutes les pièces</option>
          <option value="pont" <%= todoFilters.piece === 'pont' ? 'selected' : '' %>>Ponts / transferts</option>
          <option value="boite" <%= todoFilters.piece === 'boite' ? 'selected' : '' %>>Boîtes / mécatroniques</option>
          <option value="moteur" <%= todoFilters.piece === 'moteur' ? 'selected' : '' %>>Moteurs</option>
          <option value="autre" <%= todoFilters.piece === 'autre' ? 'selected' : '' %>>Autres</option>
        </select>
        <select name="source" class="min-w-[140px] flex-1 sm:flex-none rounded-xl border border-slate-200 bg-white py-2 pl-3 pr-8 text-sm" onchange="this.form.q.value===''&&this.form.submit()">
          <option value="">Toutes les sources</option>
          <% [['landing_ponts', 'Landing ponts / transferts'], ['landing_boites', 'Landing boîtes'], ['landing_moteurs', 'Landing moteurs'], ['devis', 'Demande de devis (fiche produit)'], ['contact', 'Formulaire contact'], ['appel_manque', 'Appel manqué'], ['blog_cta', 'Article de blog'], ['landing_5places', 'Transformation 2 → 5 places'], ['manual', 'Ajouté à la main']].forEach(function (o) { %>
            <option value="<%= o[0] %>" <%= todoFilters.source === o[0] ? 'selected' : '' %>><%= o[1] %></option>
          <% }) %>
        </select>
        <% if (todoFilters.qui || todoFilters.piece || todoFilters.source || todoFilters.suivi || todoFilters.tri) { %><a href="/admin/activite-panier" class="px-2 text-xs font-semibold text-slate-500 hover:text-slate-800">Effacer les filtres</a><% } %>
      </form>
    <% } else { %>
      <!-- Filtres de l'historique -->
      <form action="/admin/activite-panier" class="masque-en-fiche mt-3 flex flex-wrap items-center gap-2" method="GET">
        <input type="hidden" name="view" value="all" />
        <label class="relative min-w-[220px] flex-1">
          <span class="material-symbols-outlined pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-slate-400">search</span>
          <input type="text" name="q" value="<%= filters.q || '' %>" placeholder="Email, nom, téléphone, n° de commande, pièce, plaque…" title="Email, nom, prénom, téléphone (toutes graphies), numéro de commande ou de facture, pièce du panier, plaque, VIN, référence" class="w-full rounded-xl border border-slate-200 bg-white py-2 pl-10 pr-3 text-sm" />
        </label>
        <select name="manual" class="rounded-xl border border-slate-200 bg-white py-2 pl-3 pr-8 text-sm">
          <option value="">Tous les statuts</option>
          <option value="none" <%= filters.manualStatus === 'none' ? 'selected' : '' %>>Non contacté</option>
          <option value="contacted" <%= filters.manualStatus === 'contacted' ? 'selected' : '' %>>Contacté</option>
          <option value="converted" <%= filters.manualStatus === 'converted' ? 'selected' : '' %>>Gagné</option>
          <option value="lost" <%= filters.manualStatus === 'lost' ? 'selected' : '' %>>Perdu</option>
        </select>
        <select name="source" class="rounded-xl border border-slate-200 bg-white py-2 pl-3 pr-8 text-sm">
          <option value="">Toutes les sources</option>
          <% [['user', 'Compte client'], ['guest_checkout', 'Commande sans compte'], ['devis', 'Demande de devis'], ['landing_moteurs', 'Landing moteurs'], ['landing_boites', 'Landing boîtes'], ['landing_ponts', 'Landing ponts / transferts'], ['landing_5places', 'Landing 2 → 5 places'], ['contact', 'Contact'], ['appel_manque', 'Appel manqué'], ['newsletter', 'Newsletter'], ['cart_activity', 'Panier'], ['blog_cta', 'Article de blog'], ['manual', 'Ajouté à la main']].forEach(function (o) { %>
            <option value="<%= o[0] %>" <%= filters.captureSource === o[0] ? 'selected' : '' %>><%= o[1] %></option>
          <% }) %>
        </select>
        <select name="channel" class="rounded-xl border border-slate-200 bg-white py-2 pl-3 pr-8 text-sm">
          <option value="">Email ou tél.</option>
          <option value="email" <%= filters.channel === 'email' ? 'selected' : '' %>>Avec email</option>
          <option value="phone" <%= filters.channel === 'phone' ? 'selected' : '' %>>Avec téléphone</option>
          <option value="both" <%= filters.channel === 'both' ? 'selected' : '' %>>Email + téléphone</option>
        </select>
        <select name="period" class="rounded-xl border border-slate-200 bg-white py-2 pl-3 pr-8 text-sm">
          <option value="7d" <%= filters.period === '7d' ? 'selected' : '' %>>7 jours</option>
          <option value="30d" <%= !filters.period || filters.period === '30d' ? 'selected' : '' %>>30 jours</option>
          <option value="90d" <%= filters.period === '90d' ? 'selected' : '' %>>90 jours</option>
        </select>
        <select name="sort" class="rounded-xl border border-slate-200 bg-white py-2 pl-3 pr-8 text-sm">
          <option value="recent" <%= !filters.sort || filters.sort === 'recent' ? 'selected' : '' %>>Plus récents</option>
          <option value="amount" <%= filters.sort === 'amount' ? 'selected' : '' %>>Plus gros montant</option>
          <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Plus anciens</option>
        </select>
        <button class="btn btn-primary text-sm" type="submit">Chercher</button>
        <a href="/admin/activite-panier?view=all" class="px-2 text-xs font-semibold text-slate-500 hover:text-slate-800">Effacer</a>
      </form>
      <% if (filters.q) { %>
        <div class="masque-en-fiche mt-2 flex flex-wrap items-center gap-2 rounded-xl border border-blue-200 bg-blue-50 px-3 py-2 text-xs text-blue-900">
          <span class="material-symbols-outlined text-sm">search</span>
          <span>Recherche « <strong><%= filters.q %></strong> » dans <strong>tout l'historique</strong>, tous statuts confondus.</span>
          <a href="/admin/activite-panier?view=all" class="ml-auto font-semibold underline">Effacer</a>
        </div>
      <% } %>
    <% } %>

    <%
      var nomsCourts = { non_traites: 'Non traités', retard: 'En retard', rappels: 'Prévus aujourd’hui', devis: 'Devis à préparer', fournisseur: 'Attente fournisseur', a_valider: 'À valider', relances: 'À relancer', plus_tard: 'Planifiés', anciens: 'Anciens' };
      var tons = { green: 'bg-green-100 text-green-800', blue: 'bg-blue-100 text-blue-800', red: 'bg-red-100 text-red-700', amber: 'bg-amber-100 text-amber-800', orange: 'bg-orange-100 text-orange-800', yellow: 'bg-yellow-100 text-yellow-800', rose: 'bg-rose-100 text-rose-800', slate: 'bg-slate-200 text-slate-700' };
      var affiches = view === 'todo' ? [].concat.apply([], groupes.map(function (g) { return g.items; })) : (leads || []);
    %>
    <%/* Ce qui arrive pendant qu'on travaille. La file est rendue par le
          serveur : sans ce bandeau, un lead reçu à 10 h 02 restait invisible
          jusqu'au prochain F5, et la promesse « rappelé dans l'heure » se
          jouait à la chance. */%>
    <a id="leads-nouveautes" href="#" class="masque-en-fiche mt-3 hidden items-center gap-2 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-2.5 text-sm font-semibold text-emerald-900 hover:bg-emerald-100">
      <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
      <span id="leads-nouveautes-texte"></span>
      <span class="ml-auto underline">Actualiser</span>
    </a>

    <% if (view === 'todo' && affiches.length) { %>
      <%/* Les groupes étaient empilés dans la colonne de gauche : avec huit
            d'entre eux, « Nouvelles demandes » se retrouvait sous 168 lignes
            rouges. À l'horizontale, les compteurs se lisent d'un coup d'œil
            et la colonne ne montre qu'une file à la fois. */%>
      <nav id="leads-onglets" class="masque-en-fiche mt-3 flex gap-1 overflow-x-auto border-b border-slate-200" role="tablist" aria-label="Files de travail">
        <% groupes.forEach(function (g) { if (!g.count) return; %>
          <button type="button" role="tab" aria-selected="false" class="leads-onglet shrink-0 rounded-t-lg"
                  data-groupe="<%= g.key %>" data-ton="<%= g.tone %>" title="<%= g.hint %>">
            <%= nomsCourts[g.key] || g.label %>
            <span class="rounded-full px-1.5 text-[11px] font-bold <%= tons[g.tone] || tons.slate %>"><%= g.count %></span>
          </button>
        <% }) %>
      </nav>
    <% } %>

    <div class="file-cols mt-3">
      <!-- Liste des clients -->
      <aside id="file-liste" class="file-liste-col rounded-2xl border border-slate-200 bg-white" aria-label="Liste des clients">
        <% if (view === 'todo') { %>
          <% if (!affiches.length) { %>
            <div class="p-8 text-center">
              <span class="material-symbols-outlined text-emerald-500" style="font-size:40px">task_alt</span>
              <p class="mt-2 font-semibold text-slate-800">Rien à traiter pour l’instant.</p>
              <p class="text-sm text-slate-500">Les nouvelles demandes arrivent ici toutes seules.</p>
            </div>
          <% } %>
          <% groupes.forEach(function (g) { if (!g.count) return; %>
            <div class="lead-panneau hidden" id="groupe-<%= g.key %>" data-groupe="<%= g.key %>">
              <%/* Le sens du groupe, écrit en clair : l'info-bulle du titre
                    repliable ne se lisait qu'à la souris, et « En retard »
                    contre « À relancer » se joue justement sur ce mot. */%>
              <div class="groupe-entete z-10 flex items-center gap-3 border-b border-slate-100 bg-white/95 px-3.5 py-1.5 text-xs text-slate-500">
                <p class="min-w-0 flex-1 truncate" title="<%= g.hint %>."><%= g.court || g.hint %></p>
                <%/* Trier l'onglet par date de la demande (19/11/2026 : « je
                      voudrais pouvoir trier les leads par date »). Chaque
                      onglet garde son propre choix : un « plus anciennes »
                      pris dans « À relancer » ne retourne pas « Non traités ».
                      Par défaut, l'ordre de travail de l'onglet. */%>
                <%
                  var ordres = g.key === 'non_traites'
                    ? [['', 'Plus récentes d’abord', 'Plus récentes'], ['ancien', 'Plus anciennes d’abord', 'Plus anciennes']]
                    : [['', 'Le plus urgent d’abord', 'Urgence'], ['recent', 'Demandes les plus récentes', 'Plus récentes'], ['ancien', 'Demandes les plus anciennes', 'Plus anciennes']];
                  var ordreActif = ordres.filter(function (o) { return o[0] === g.tri; })[0] || ordres[0];
                %>
                <details class="lead-menu relative shrink-0">
                  <summary class="list-none cursor-pointer inline-flex items-center gap-1 rounded-md px-1.5 py-1 font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900" title="Trier cet onglet" data-role="tri">
                    <span class="material-symbols-outlined text-[16px] text-slate-400">sort</span><%= ordreActif[2] %><span class="material-symbols-outlined text-[16px] text-slate-400">expand_more</span>
                  </summary>
                  <div class="absolute right-0 z-30 mt-1 w-72 max-w-[calc(100vw-2rem)] rounded-lg border border-slate-200 bg-white p-1 text-sm shadow-lg">
                    <p class="px-3 pb-1 pt-1.5 text-xs text-slate-400">Trier « <%= g.label %> »</p>
                    <% ordres.forEach(function (o) {
                         var actif = o === ordreActif;
                         var triO = Object.assign({}, todoFilters.triParOnglet || {});
                         if (o[0]) { triO[g.key] = o[0]; } else { delete triO[g.key]; }
                         var triS = groupes.map(function (x) { return x.key; }).filter(function (k) { return triO[k]; })
                           .map(function (k) { return k + '-' + triO[k]; }).join('.');
                         var qso = Object.assign({}, filtresEnCours);
                         if (triS) { qso.tri = triS; } else { delete qso.tri; }
                         if (todoFilters.voir === g.key) { qso.voir = g.key; }
                         var qs = new URLSearchParams(qso).toString(); %>
                      <a href="/admin/activite-panier<%= qs ? '?' + qs : '' %>#groupe-<%= g.key %>"
                         class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm hover:bg-slate-50 <%= actif ? 'font-medium text-slate-900' : 'text-slate-700' %>"<%- actif ? ' aria-current="true"' : '' %>>
                        <span class="material-symbols-outlined w-[18px] shrink-0 text-[18px] <%= actif ? 'text-slate-900' : 'text-transparent' %>" aria-hidden="true">check</span>
                        <span class="min-w-0 flex-1"><%= o[1] %></span>
                        <% if (!o[0]) { %><span class="shrink-0 text-xs font-normal text-slate-400">conseillé</span><% } %>
                      </a>
                    <% }) %>
                  </div>
                </details>
              </div>
              <ul>
                <%/* Rangée par date, la liste est coupée par jour : « Aujourd’hui
                      · 3 », « Hier · 2 », « Samedi 28 novembre · 1 ». Le compte
                      porte sur tout l'onglet, pas sur les lignes affichées. */%>
                <% var jourPrecedent = null; %>
                <% g.items.forEach(function (c) { %>
                  <% if (g.parJour) {
                       var jr = g.parJour === 'rdv' ? c.prevuJour : c.recuJour;
                       var cleJour = jr ? jr.cle : '';
                       if (cleJour !== jourPrecedent) { jourPrecedent = cleJour;
                         var nJour = (g.jours || {})[cleJour] || 0; %>
                    <li class="lead-jour flex items-baseline gap-1.5 border-b border-slate-100 bg-slate-50 px-3.5 py-1.5 text-xs font-semibold text-slate-600" data-jour="<%= cleJour %>">
                      <%= jr ? jr.libelle : 'Date inconnue' %><% if (nJour) { %><span class="font-normal text-slate-400">· <%= nJour %></span><% } %>
                    </li>
                  <% } } %>
                  <%- include('./partials/lead-ligne', { c: c, triDate: !!g.tri, jour: g.parJour || '' }) %>
                <% }) %>
              </ul>
              <% if (g.reste > 0) { %>
                <% var qsv = new URLSearchParams(Object.assign({}, filtresEnCours, { voir: g.key })).toString(); %>
                <a href="/admin/activite-panier?<%= qsv %>" class="flex items-center gap-1 border-b border-slate-100 px-4 py-2.5 text-xs font-semibold text-primary hover:bg-slate-50">Afficher les <%= g.reste %> suivants<span class="material-symbols-outlined text-[16px]">expand_more</span></a>
              <% } %>
            </div>
          <% }) %>
        <% } else { %>
          <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 px-4 py-2 text-xs">
            <span class="font-bold uppercase tracking-wider text-slate-600"><%= pagination.totalItems %> lead<%= pagination.totalItems > 1 ? 's' : '' %></span>
            <% if (pagination.totalItems > 0) { %><span class="text-slate-500"><%= pagination.from %>–<%= pagination.to %></span><% } %>
          </div>
          <% if (affiches.length) { %>
            <ul><% affiches.forEach(function (c) { %><%- include('./partials/lead-ligne', { c: c }) %><% }) %></ul>
          <% } else { %>
            <div class="p-8 text-center">
              <span class="material-symbols-outlined text-slate-300" style="font-size:40px">inbox</span>
              <p class="mt-2 text-sm text-slate-500">Aucun lead ne correspond.</p>
              <a href="/admin/activite-panier?view=all" class="mt-1 inline-block text-sm text-primary hover:underline">Effacer les filtres</a>
            </div>
          <% } %>
          <% if (pagination.totalPages > 1) { %>
            <div class="flex items-center justify-between px-4 py-2.5 text-xs">
              <span class="text-slate-500">Page <%= pagination.page %> / <%= pagination.totalPages %></span>
              <span class="flex gap-2">
                <% if (pagination.hasPrev) { %><a href="?<%= filtersQS ? filtersQS + '&' : '' %>page=<%= pagination.prevPage %>" class="font-semibold text-slate-700 hover:text-primary">← Précédents</a><% } %>
                <% if (pagination.hasNext) { %><a href="?<%= filtersQS ? filtersQS + '&' : '' %>page=<%= pagination.nextPage %>" class="font-semibold text-slate-700 hover:text-primary">Suivants →</a><% } %>
              </span>
            </div>
          <% } %>
        <% } %>
      <%/* Barre d'actions du mode « Sélectionner », collée en bas de la liste. */%>
      <div id="leads-lot-barre" class="sticky bottom-0 z-20 hidden border-t border-slate-200 bg-white/95 px-3 py-2 backdrop-blur">
        <div class="flex flex-wrap items-center gap-2 text-sm">
          <span id="leads-lot-compte" class="font-semibold text-slate-800">0 sélectionné</span>
          <button type="button" id="leads-lot-tout" class="rounded-lg px-2 py-1 text-xs font-semibold text-primary hover:bg-slate-100">Tout cocher</button>
          <div class="ml-auto flex gap-1.5">
            <button type="button" id="leads-lot-prendre" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">Je m’en occupe</button>
            <button type="button" id="leads-lot-perdu" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">Perdu…</button>
            <button type="button" id="leads-lot-annuler" class="rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-500 hover:bg-slate-100">Annuler</button>
          </div>
        </div>
      </div>
      </aside>

      <!-- Client sélectionné -->
      <section id="file-fiche" class="file-fiche-col rounded-2xl border border-slate-200 bg-white" aria-live="polite">
        <div id="fiche-vide" class="p-10 text-center text-sm text-slate-500">
          <span class="material-symbols-outlined text-slate-300" style="font-size:40px">touch_app</span>
          <p class="mt-2"><%= affiches.length ? 'Choisis un client dans la liste.' : 'Aucun client à afficher.' %></p>
        </div>
        <% affiches.forEach(function (c) { %><%- include('./partials/lead-fiche', { c: c }) %><% }) %>
      </section>
    </div>

    <% if (!dbConnected) { %>
      <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-900">
        <div class="font-bold">Mode démo</div>
        <div class="mt-1 text-sm">Base de données indisponible.</div>
      </div>
    <% } %>
  </div>
</main>

<!-- Guide « Comment ça marche » -->
<div id="leads-help-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50" id="leads-help-overlay"></div>
  <div class="absolute right-0 top-0 h-full w-full max-w-2xl overflow-y-auto bg-white shadow-2xl">
    <div class="p-6">
      <div class="mb-1 flex items-center justify-between">
        <div class="text-lg font-bold text-slate-900">Comment ça marche</div>
        <button type="button" id="leads-help-close" class="flex h-8 w-8 items-center justify-center rounded-lg hover:bg-slate-100"><span class="material-symbols-outlined">close</span></button>
      </div>
      <p class="mb-5 text-sm text-slate-500">En haut les onglets, un par file de travail. À gauche la liste de l’onglet ouvert, déjà triée. À droite le client choisi et ce qu’il faut faire.</p>

      <div class="mb-4 rounded-xl border-2 border-primary/30 bg-red-50/40 p-4">
        <div class="mb-2 text-xs font-bold uppercase tracking-widest text-primary">La méthode en 4 gestes</div>
        <ol class="list-inside list-decimal space-y-2 text-sm text-slate-800">
          <li><strong>Vide les onglets de gauche à droite</strong> : ils sont dans l’ordre où il faut travailler. Dans chaque onglet, prends le premier client : la liste est déjà triée. Pour la voir dans l’ordre d’arrivée, le menu de tri en haut à droite de la liste range l’onglet par date de la demande, des plus récentes ou des plus anciennes ; chaque onglet garde son propre tri. Rangée par date, la liste est coupée par jour (« Aujourd’hui », « Hier », « Samedi 28 novembre »), avec le nombre de dossiers du jour ; dans « Planifiés », c’est le jour du rendez-vous.</li>
          <li><strong>Regarde l’encadré « La prochaine action »</strong> à droite et clique sur son gros bouton : Appeler, Préparer le devis, Écrire au client…</li>
          <li><strong>Après l’appel, clique « Noter l’appel »</strong> : comment ça s’est passé, la suite, et pour quand. Sans suite, le client serait oublié : la fenêtre te la demande toujours.</li>
          <li><strong>« Enregistrer et continuer »</strong> t’emmène tout seul au client suivant. <strong>Gagné</strong> seulement quand le client a payé, <strong>Perdu</strong> toujours avec le motif (dans le menu ⋯ de la fiche).</li>
        </ol>
      </div>

      <div class="mb-4 rounded-xl border border-slate-200 p-4">
        <div class="mb-2 text-xs font-bold uppercase tracking-widest text-slate-400">Les groupes de la liste</div>
        <div class="space-y-1.5 text-sm text-slate-700">
          <div><strong>Non traités</strong> — <strong>tout ce que personne n’a encore appelé ni écrit</strong>, en retard ou non : c’est le même geste pour toi, décrocher le téléphone. Les plus récentes en haut, parce qu’un lead frais se transforme bien mieux qu’un lead de la veille — le menu de tri en tête de liste repart du fond de la pile. La promesse reste d’appeler dans l’heure (9 h–12 h, 14 h–18 h, du lundi au vendredi) : passé ce délai la barre de la ligne vire au rouge, même si elle ne change pas d’onglet.</div>
          <div><strong>En retard</strong> — <strong>un rendez-vous promis</strong> est passé, sur un dossier <strong>déjà pris en main</strong> : tu avais prévu de rappeler à 14 h et il est 16 h. C’est le seul onglet rouge, et il doit rester petit.</div>
          <div><strong>Prévus aujourd’hui</strong> — les rappels et relances planifiés pour aujourd’hui.</div>
          <div><strong>Devis à préparer</strong> — trouver la pièce et le prix, puis envoyer le devis (bouton « Atelier devis »). Les plus vieux en haut.</div>
          <div><strong>Attente fournisseur</strong> — le prix est demandé au fournisseur (WhatsApp ou mail) : <strong>ne le redemande pas</strong>. Regarde sa réponse, puis envoie le devis au client.</div>
          <div><strong>À valider</strong> — Killian doit décider avant qu’on écrive au client : devis de plus de 4 000 € HT, pièce d’occasion à trouver, compatibilité à trancher, remise.</div>
          <div><strong>À relancer</strong> — sans nouvelles depuis plus de 2 jours ouvrés. <strong>Personne n’a promis cette date</strong> : c’est la file qui la propose. Ce n’est pas un reproche, c’est une suggestion — d’où l’ambre et pas le rouge.</div>
          <div><strong>Planifiés</strong> — prévus un autre jour : rien à faire maintenant. C’est là que partent les dossiers mis « En attente du client ».</div>
          <div><strong>Anciens dossiers</strong> — en retard depuis plus de 7 jours ouvrés. On les reprend quand le reste est fait : relire, rappeler ou clôturer.</div>
        </div>
      </div>

      <div class="mb-4 rounded-xl border border-slate-200 p-4">
        <div class="mb-2 text-xs font-bold uppercase tracking-widest text-slate-400">Ce que dit une ligne</div>
        <div class="space-y-1.5 text-sm text-slate-700">
          <div><strong>La barre de couleur à gauche dit l’urgence</strong>, sans texte : <span class="font-bold text-red-600">rouge</span> pour une heure promise et passée, <span class="font-bold text-amber-700">ambre</span> pour une relance que la file propose, <span class="font-bold text-blue-700">bleu</span> pour une demande encore dans l’heure. Pas de compte à rebours sur les lignes : seule la date d’un rendez-vous fixé un autre jour s’affiche, dans « Planifiés ».</div>
          <div>Dessous : la pièce et le véhicule, et à droite le <strong>montant en jeu</strong> (le devis s’il est parti, sinon le panier).</div>
          <div>Puis <strong>l’heure d’arrivée de la demande</strong> (« 09:12 » aujourd’hui, « hier 16:40 », « mar. 17/11 »), <strong>qui s’en occupe</strong> (« Non pris » si personne) et d’où elle vient (Google Ads, landing…).</div>
          <div>À droite de cette ligne : soit <strong>depuis combien de temps elle attend</strong> (temps compté en heures d’ouverture depuis la demande, tant que personne n’a appelé ni écrit — <span class="font-bold text-red-600">rouge</span> au-delà d’une heure), soit <strong>« contacté 2× · 5 j »</strong> dès que quelqu’un s’en est occupé : combien de fois, et depuis combien de temps le client est sans nouvelles. Ces durées se remettent à jour toutes seules, sans recharger la page.</div>
          <div>En bas, les pastilles qui changent la façon d’appeler : <span class="rounded bg-green-100 px-1.5 text-[11px] font-semibold text-green-800">A cliqué payer</span> <span class="rounded bg-violet-100 px-1.5 text-[11px] font-semibold text-violet-800">Devis vu</span> <span class="rounded bg-indigo-50 px-1.5 text-[11px] font-semibold text-indigo-700">Déjà client</span> <span class="rounded bg-amber-100 px-1.5 text-[11px] font-semibold text-amber-800">SAV en cours</span>, et « note » quand un collègue a écrit quelque chose (passe la souris dessus pour la lire).</div>
          <div>Dans la fiche : « M’attribuer », en haut à droite, pour prendre le client. Le menu ⋯ regroupe le reste (atelier devis, fournisseur, SMS types, gagné, perdu).</div>
        </div>
      </div>

      <div class="mb-4 rounded-xl border border-slate-200 p-4">
        <div class="mb-2 text-xs font-bold uppercase tracking-widest text-slate-400">Raccourcis clavier</div>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-slate-700">
          <% [['J', 'client suivant'], ['K', 'client précédent'], ['A', 'appeler'], ['E', 'écrire un email'], ['S', 'envoyer un SMS'], ['R', 'noter l’appel'], ['P', 'planifier la suite'], ['N', 'écrire une note'], ['G', 'gagné'], ['L', 'perdu'], ['/', 'chercher'], ['?', 'cette aide']].forEach(function (k) { %>
            <div><kbd class="rounded border border-slate-300 bg-slate-50 px-1.5 font-mono text-xs"><%= k[0] %></kbd> <%= k[1] %></div>
          <% }) %>
        </div>
        <div class="mt-2 text-xs text-slate-500">Ils agissent sur le client affiché à droite, sauf quand on écrit dans un champ.</div>
      </div>

      <div class="mb-4 rounded-xl border border-slate-200 p-4">
        <div class="mb-2 text-xs font-bold uppercase tracking-widest text-slate-400">Gagner du temps</div>
        <div class="space-y-1.5 text-sm text-slate-700">
          <div><strong>Le menu « Reporter »</strong>, dans la fiche : « Planifier… », « Dans 2 heures » et « Demain matin ». Les deux derniers repoussent le dossier et passent au client suivant, en un clic.</div>
          <div><strong>« Devis envoyé »</strong>, dans « Noter l’appel » : le seul choix qui ne demande pas d’heure. Le devis parti, ce qui suit c’est sa relance, et sa date se déduit toute seule (3 jours ouvrés, en ambre). Avant, il fallait inventer une heure pour un travail déjà fait — et cette heure faisait remonter le dossier en rouge l’après-midi même. Un devis envoyé depuis l’atelier solde aussi « Préparer le devis » tout seul.</div>
          <div><strong>« En attente du client »</strong>, dans le même menu « Reporter » : quand la balle est dans SON camp (il réfléchit, il attend son garagiste, il rappelle le mois prochain). Le dossier part dans « Planifiés » et ne remonte qu’à la date choisie. Sans ça, il revenait dans la file tous les deux jours ouvrés jusqu’à la clôture.</div>
          <div><strong>« En attente chez nous »</strong>, toujours dans « Reporter » : « Prix demandé au fournisseur » dès que la demande de prix est partie, et « À valider par Killian » quand il doit trancher. Le dossier part dans l’onglet du même nom. Un devis envoyé depuis l’atelier termine ces deux attentes tout seul.</div>
          <div><strong>Le filtre « Jamais contactés »</strong>, en haut : la pile de demandes que personne n’a encore touchées. Les dossiers en cours restent dans la file de tout le monde — c’est volontaire, un client appelé une fois qui n’a pas dit oui n’est pas un dossier fini.</div>
          <div><strong>« Sélectionner »</strong>, en haut : coche plusieurs clients d’un coup pour les prendre en charge ou les clôturer en perdu avec un motif commun. C’est fait pour vider « Anciens dossiers ». Rien n’est supprimé : un dossier clôturé par erreur se rouvre depuis sa fiche.</div>
          <div><strong>Quand une demande arrive</strong> pendant que la page est ouverte, un bandeau vert le dit en haut de la liste et le titre de l’onglet compte. La cloche, en haut, ajoute un bip.</div>
        </div>
      </div>

      <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 p-4">
        <div class="mb-2 text-xs font-bold uppercase tracking-widest text-amber-700">Appeler un particulier</div>
        <div class="text-sm text-amber-900">Depuis le 11 août 2026, on n’appelle un particulier que pour <strong>répondre à sa demande</strong> (devis, formulaire, appel manqué). C’est pour ça que le bouton « Appeler » n’apparaît pas sur un simple panier abandonné ou une inscription newsletter : on leur écrit.</div>
      </div>

      <div class="rounded-xl border border-slate-200 p-4">
        <div class="mb-2 text-xs font-bold uppercase tracking-widest text-slate-400">Et les autres pages ?</div>
        <div class="space-y-1.5 text-sm text-slate-700">
          <div><strong>Tous les leads</strong> : l’historique complet (paniers, newsletter, gagnés, perdus) avec la recherche.</div>
          <div><strong>Atelier devis</strong> : pour construire un devis moteur, boîte ou pont (pièce, prix, marge, PDF). Les demandes y arrivent ET apparaissent ici : rien ne peut être oublié.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: action (email / sms / detail) -->
<div id="lead-modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50" id="lead-modal-overlay"></div>
  <div class="absolute right-0 top-0 h-full w-full max-w-xl bg-white shadow-2xl overflow-y-auto">
    <div class="p-6">
      <div class="flex items-center justify-between mb-6">
        <div id="lead-modal-title" class="text-lg font-semibold text-slate-900">Détail du lead</div>
        <button type="button" id="lead-modal-close" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div id="lead-modal-content"><div class="text-sm text-slate-500">Chargement...</div></div>
    </div>
  </div>
</div>

<script src="/js/leads-horloge.js?v=<%= (typeof assetVersions !== 'undefined' && assetVersions.leadsHorlogeJs) || '' %>"></script>
<script>
(function () {
  var BRAND = <%- JSON.stringify(typeof brand !== 'undefined' ? brand.NAME : 'Autoliva') %>;
  /* Fenêtre d'ouverture des prochains jours, calculée par le serveur
     (services/leadHeure.js) : l'horloge ci-dessous ne refait ni les
     week-ends, ni les fériés, ni les changements d'heure. */
  var HORLOGE = <%- JSON.stringify(typeof horloge !== 'undefined' && horloge ? horloge : { nowIso: '', plages: [] }) %>;

  var modal = document.getElementById('lead-modal');
  var overlay = document.getElementById('lead-modal-overlay');
  var closeBtn = document.getElementById('lead-modal-close');
  var content = document.getElementById('lead-modal-content');
  var title = document.getElementById('lead-modal-title');

  function openModal(t) { if (t) title.textContent = t; modal.classList.remove('hidden'); }
  /* Si un envoi devait être suivi d'un rechargement (SMS après un appel),
     fermer la fenêtre sans envoyer recharge quand même : la fiche affichée
     doit refléter l'appel qui vient d'être enregistré. */
  function closeModal() { modal.classList.add('hidden'); if (apresEnvoi) refresh(); }
  if (overlay) overlay.addEventListener('click', closeModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);

  // ─ Guide « Comprendre cette page » ─
  var helpModal = document.getElementById('leads-help-modal');
  var helpBtn = document.getElementById('leads-help-btn');
  if (helpBtn && helpModal) {
    helpBtn.addEventListener('click', function () { helpModal.classList.remove('hidden'); });
    ['leads-help-overlay', 'leads-help-close'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('click', function () { helpModal.classList.add('hidden'); });
    });
  }

  /* Anti double envoi : un 2e clic (ou Entrée) pendant l'envoi faisait partir
     un 2e e-mail / SMS au client. Bouton bloqué jusqu'à la réponse ; réactivé
     seulement en cas d'échec. */
  function verrouEnvoi(form) {
    if (form.dataset.envoiEnCours === '1') return null;
    form.dataset.envoiEnCours = '1';
    var btn = form.querySelector('button[type="submit"]');
    var libelle = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; btn.classList.add('opacity-60', 'cursor-not-allowed'); }
    return {
      echec: function () {
        form.dataset.envoiEnCours = '';
        if (btn) { btn.disabled = false; btn.classList.remove('opacity-60', 'cursor-not-allowed'); btn.innerHTML = libelle; }
      },
    };
  }

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  }

  /* Après un envoi : on recharge en restant sur le même client (l'adresse
     garde ?lead=…), sauf si on a demandé de passer au client suivant. */
  var apresEnvoi = null;
  function refresh() {
    var a = apresEnvoi;
    apresEnvoi = null;
    if (a && a.mode === 'suivant') { allerA(idSuivant(a.id, 1) || a.id); return; }
    if (a) { allerA(a.id); return; }
    window.location.reload();
  }

  // ─ Copier le numéro (le commercial appelle depuis son logiciel, pas le tel: du PC) ─
  function fallbackCopyText(text) {
    try {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.top = '-1000px'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.focus(); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta);
      return true;
    } catch (_) { return false; }
  }
  document.addEventListener('click', function (e) {
    var el = e.target.closest ? e.target.closest('[data-copy-phone]') : null;
    if (!el) return;
    var num = el.getAttribute('data-copy-phone') || '';
    if (!num) return;
    var ok = function () { showToast('Numéro copié — collez-le dans votre logiciel d’appel'); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(num).then(ok).catch(function () { if (fallbackCopyText(num)) ok(); });
    } else if (fallbackCopyText(num)) { ok(); }
  });


  /* ══ Onglets de la fiche : Suivi et notes · Pièce et devis · Client ══
     Même source que l'ancien « Détail » (GET /admin/activite-panier/:id).
     Tout est cherché DANS la fiche (data-role), jamais par id global : deux
     fiches chargées ne peuvent pas se marcher dessus. */
  var SOURCES_ATELIER = ['landing_moteurs', 'landing_boites', 'landing_ponts'];
  var ICONES_CANAL = { email: 'mail', sms: 'sms', whatsapp: 'chat', appel: 'call' };

  function titreBloc(t, droite) {
    return '<div class="mb-2 flex flex-wrap items-baseline justify-between gap-2"><div class="text-[11px] font-bold uppercase tracking-widest text-slate-400">' + t + '</div>'
      + (droite ? '<div class="text-xs text-slate-500">' + droite + '</div>' : '') + '</div>';
  }


  /* Messages + notes sur UNE ligne du temps, la plus récente en haut. Les
     notes « Email envoyé… » doublonnent le journal des messages : on les saute. */
  /* ══ Onglet « Suivi et notes » ══
     Refait le 20/11/2026 dans le style de la fiche. Le champ de note passe EN
     HAUT (c'est le geste qu'on fait après chaque appel ; il était sous tout
     l'historique), et l'historique se lit comme un fil : groupé par jour, le
     plus récent en haut, l'heure à droite. Les messages du client ressortent
     en bleu ; envois automatiques, appels et notes restent en gris. */
  var FMT_JOUR_CLE = new Intl.DateTimeFormat('fr-CA', { timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit' });
  var FMT_JOUR_NOM = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', weekday: 'short', day: 'numeric', month: 'short' });
  var FMT_JOUR_NOM_AN = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
  var FMT_HEURE_PARIS = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', hour: '2-digit', minute: '2-digit' });

  /** Jour (heure de Paris) d'un ISO : clé de regroupement et intitulé. */
  function jourDe(iso) {
    var d = new Date(iso);
    if (!iso || isNaN(d.getTime())) return { cle: '', nom: 'Date inconnue' };
    var cle = FMT_JOUR_CLE.format(d);
    var maintenant = new Date();
    if (cle === FMT_JOUR_CLE.format(maintenant)) return { cle: cle, nom: 'Aujourd’hui' };
    if (cle === FMT_JOUR_CLE.format(new Date(maintenant.getTime() - 86400000))) return { cle: cle, nom: 'Hier' };
    var memeAnnee = cle.slice(0, 4) === FMT_JOUR_CLE.format(maintenant).slice(0, 4);
    var nom = (memeAnnee ? FMT_JOUR_NOM : FMT_JOUR_NOM_AN).format(d);
    return { cle: cle, nom: nom.charAt(0).toUpperCase() + nom.slice(1) };
  }
  function heureDe(iso) {
    var d = new Date(iso);
    return (!iso || isNaN(d.getTime())) ? '' : FMT_HEURE_PARIS.format(d);
  }

  /* Pastilles d'un événement : petites, et colorées seulement quand c'est une
     information à ne pas rater (non délivré, envoi non confirmé…). */
  function pastilleHisto(texte, ton, titre) {
    var c = { rouge: 'bg-red-50 text-red-700', ambre: 'bg-amber-50 text-amber-800', gris: 'bg-slate-100 text-slate-600' }[ton] || 'bg-slate-100 text-slate-600';
    return ' <span class="ml-1 rounded-full px-1.5 py-px text-[11px] font-normal ' + c + '"' + (titre ? ' title="' + escapeHtml(titre) + '"' : '') + '>' + texte + '</span>';
  }

  /* Ce que dit une note qui n'est pas une note libre (appel noté, suite
     planifiée…), d'après le pictogramme posé par le serveur en tête du texte. */
  function genreNote(texte) {
    var t = String(texte || '');
    if (/^📞/.test(t)) return { icone: 'call', genre: 'appel noté' };
    if (/^🗓/.test(t)) return { icone: 'event', genre: 'suite planifiée' };
    if (/^✅/.test(t)) return { icone: 'verified', genre: 'gagné' };
    if (/^✖/.test(t)) return { icone: 'block', genre: 'perdu' };
    if (/^↩/.test(t)) return { icone: 'undo', genre: 'rouvert' };
    if (/pris en charge/i.test(t)) return { icone: 'pan_tool', genre: 'prise en charge' };
    return { icone: 'sticky_note_2', genre: '' };
  }

  function htmlSuivi(c) {
    var comms = c.communications || [];
    var aRecu = comms.some(function (m) { return m.entrant; });
    var items = [];
    comms.forEach(function (m) { items.push({ type: 'msg', iso: m.atIso || '', m: m }); });
    (c.notes || []).forEach(function (n) {
      var t = String(n.text || '');
      /* Doublons du journal des messages : l'envoi est déjà au fil. */
      if (/^(📧 Email envoyé|📱 SMS envoyé|📲 WhatsApp ouvert)/.test(t)) return;
      /* Ringover écrit une note à chaque SMS reçu ; le SMS lui-même est déjà
         au fil (et son contexte dans la fiche). Gardée seulement pour les
         vieux dossiers dont le message n'a pas été journalisé. */
      if (aRecu && /^R[ÉE]PONSE SMS du client/i.test(t)) return;
      items.push({ type: 'note', iso: n.addedAtIso || '', n: n });
    });
    items.sort(function (a, b) { return a.iso < b.iso ? 1 : a.iso > b.iso ? -1 : 0; });

    var html = '<form data-role="note-form" class="mb-6">'
      + '<textarea name="text" rows="2" maxlength="2000" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm placeholder:text-slate-400" placeholder="Ajouter une note pour l’équipe : ce que le client a dit, la pièce, le prix évoqué…"></textarea>'
      + '<div class="mt-2 flex flex-wrap items-center gap-3">'
      + '<button type="submit" class="inline-flex min-h-[2.75rem] items-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Enregistrer la note</button>'
      + '<span class="text-xs text-slate-400">Le client ne voit pas les notes.</span>'
      + '<span data-role="note-res" class="text-xs"></span></div></form>';

    var r = c.commResume || {};
    if (r.echecs) {
      html += '<div class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">' + r.echecs + ' message' + (r.echecs > 1 ? 's' : '')
        + ' non délivré' + (r.echecs > 1 ? 's' : '') + ' : le client ne les a jamais reçus.</div>';
    }
    if (!items.length) return html + '<p class="text-sm text-slate-500">Rien pour l’instant : aucun message, aucune note.</p>';

    var jourEnCours = null;
    items.forEach(function (it) {
      var jour = jourDe(it.iso);
      if (!jourEnCours || jour.cle !== jourEnCours) {
        if (jourEnCours !== null) html += '</ol></section>';
        jourEnCours = jour.cle;
        html += '<section class="mb-5"><h3 class="mb-3 text-xs font-medium text-slate-400">' + escapeHtml(jour.nom) + '</h3><ol class="space-y-4">';
      }

      var icone, rond, titre, corps = '', pied = '';
      if (it.type === 'msg') {
        var m = it.m;
        var canal = ({ email: 'Email', sms: 'SMS', whatsapp: 'WhatsApp', appel: 'Appel' })[m.canal] || (m.canal || 'Message');
        icone = ICONES_CANAL[m.canal] || 'mail';
        rond = m.echec ? 'bg-red-50 text-red-600' : m.entrant ? 'bg-blue-50 text-blue-600' : 'bg-slate-100 text-slate-500';
        titre = m.entrant ? (m.canal === 'appel' ? 'Appel du client' : canal + ' reçu du client')
          : (m.canal === 'appel' ? 'Appel' : m.canal === 'whatsapp' ? 'Message WhatsApp' : canal + ' envoyé');
        titre = escapeHtml(titre);
        if (m.auto && !m.entrant) titre += ' <span class="font-normal text-slate-400">· automatique</span>';
        if (m.echec) titre += pastilleHisto('Non délivré', 'rouge');
        if (m.reconstitue) titre += pastilleHisto('Reconstitué', 'ambre', 'Reconstitué depuis les anciennes traces : le texte exact n’a pas été gardé.');
        if (m.meta && m.meta.envoiNonGaranti) titre += pastilleHisto('Envoi non confirmé', 'ambre', 'Ouvert dans WhatsApp depuis le poste du commercial : rien ne prouve que le message est parti.');
        if (m.objet) {
          corps += '<div class="text-sm text-slate-800">' + escapeHtml(m.objet);
          if (m.meta && m.meta.montant) corps += ' <span class="text-slate-500">· ' + escapeHtml(String(Math.round(m.meta.montant)).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')) + ' €</span>';
          corps += '</div>';
        }
        if (m.corps) {
          var texte = String(m.corps);
          if (texte.length > 280) {
            corps += '<details class="text-sm leading-relaxed text-slate-600"><summary class="cursor-pointer list-none whitespace-pre-line">' + escapeHtml(texte.slice(0, 260)) + '… <span class="font-medium text-slate-800 underline decoration-slate-300 underline-offset-2">Lire la suite</span></summary>'
              + '<div class="whitespace-pre-line">' + escapeHtml(texte.slice(260)) + '</div></details>';
          } else {
            corps += '<div class="whitespace-pre-line text-sm leading-relaxed text-slate-600">' + escapeHtml(texte) + '</div>';
          }
        }
        if (m.echec && m.motif) corps += '<div class="text-xs text-red-600">Motif : ' + escapeHtml(m.motif) + '</div>';
        var auteur = m.entrant ? '' : (m.par || (m.auto ? 'Système' : ''));
        pied = [auteur, m.gabarit ? 'modèle « ' + m.gabarit + ' »' : ''].filter(Boolean).join(' · ');
      } else {
        var n = it.n;
        var g = genreNote(n.text);
        icone = g.icone;
        rond = g.icone === 'verified' ? 'bg-green-50 text-green-600' : 'bg-slate-100 text-slate-500';
        titre = escapeHtml(n.addedByName || 'Admin') + (g.genre ? ' <span class="font-normal text-slate-400">· ' + g.genre + '</span>' : '');
        corps = '<div class="whitespace-pre-line text-sm leading-relaxed text-slate-600">' + escapeHtml(String(n.text || '').replace(/^(📞|🗓|✅|✖|↩)\s*/, '')) + '</div>';
      }

      html += '<li class="grid gap-x-3" style="grid-template-columns: 1.75rem minmax(0, 1fr);">'
        + '<span class="flex h-7 w-7 items-center justify-center rounded-full ' + rond + '"><span class="material-symbols-outlined text-[16px]">' + icone + '</span></span>'
        + '<div class="min-w-0">'
        + '<div class="flex items-baseline gap-2 text-sm"><span class="min-w-0 flex-1 font-medium text-slate-900">' + titre + '</span>'
        + '<span class="shrink-0 text-xs text-slate-400" title="' + escapeHtml((it.type === 'msg' ? it.m.at : it.n.addedAt) || '') + '">' + heureDe(it.iso) + '</span></div>'
        + (corps ? '<div class="mt-0.5">' + corps + '</div>' : '')
        + (pied ? '<div class="mt-0.5 text-xs text-slate-400">' + escapeHtml(pied) + '</div>' : '')
        + '</div></li>';
    });
    html += '</ol></section>';
    return html;
  }

  function ligneInfo(label, valeur, mono) {
    if (!valeur) return '';
    return '<div class="flex gap-2 text-sm"><span class="w-24 shrink-0 text-slate-500">' + label + '</span><span class="min-w-0 break-words ' + (mono ? 'font-mono ' : 'font-medium ') + 'text-slate-900">' + escapeHtml(valeur) + '</span></div>';
  }

  function htmlPiece(c, leadId) {
    var html = '<div class="space-y-4">';
    var rq = c.requested || {};
    if (c.hasRequested) {
      html += '<div class="rounded-xl border border-slate-200 p-4">' + titreBloc('La demande du client')
        + ligneInfo('Référence', rq.ref) + ligneInfo('Véhicule', rq.vehicle) + ligneInfo('Plaque', rq.plate, true) + ligneInfo('VIN', rq.vin, true);
      if (rq.message) html += '<div class="mt-2 whitespace-pre-line text-sm italic text-slate-700">« ' + escapeHtml(rq.message) + ' »</div>';
      html += '</div>';
    }
    if (SOURCES_ATELIER.indexOf(c.captureSource) !== -1) {
      html += '<a href="/admin/devis-moteurs/' + escapeHtml(leadId) + '" class="flex items-center gap-3 rounded-xl border border-orange-200 bg-orange-50 p-4 hover:bg-orange-100">'
        + '<span class="material-symbols-outlined text-orange-600">request_quote</span><span class="flex-1 text-sm"><strong class="text-slate-900">Atelier devis</strong><span class="block text-slate-600">Identifier la pièce, calculer le prix et la marge, envoyer le devis PDF.</span></span>'
        + '<span class="material-symbols-outlined text-orange-600">arrow_forward</span></a>';
    }
    if (c.items && c.items.length) {
      html += '<div class="rounded-xl border border-slate-200 p-4">' + titreBloc('Panier (' + c.items.length + ')', escapeHtml(c.totalAmount || ''));
      c.items.forEach(function (it) {
        html += '<div class="flex items-start gap-3 border-b border-slate-100 py-2 last:border-0">';
        html += it.image ? '<img src="' + escapeHtml(it.image) + '" alt="" class="h-11 w-11 shrink-0 rounded-lg object-cover" />' : '<div class="h-11 w-11 shrink-0 rounded-lg bg-slate-100"></div>';
        html += '<div class="min-w-0 flex-1"><div class="text-sm font-semibold text-slate-900">' + escapeHtml(it.name) + '</div>';
        if (it.sku) html += '<div class="text-xs text-slate-400">Réf. ' + escapeHtml(it.sku) + '</div>';
        if (it.optionsSummary) html += '<div class="text-xs text-slate-500">' + escapeHtml(it.optionsSummary) + '</div>';
        html += '<div class="text-xs text-slate-500">Qté ' + it.quantity + ' · ' + escapeHtml(it.price) + '</div></div></div>';
      });
      html += '</div>';
    }
    if (c.contextMessage) {
      html += '<div class="rounded-xl border border-slate-200 p-4">' + titreBloc('Contexte') + '<div class="whitespace-pre-line text-sm text-slate-700">' + escapeHtml(c.contextMessage) + '</div></div>';
    }

    /* Demande fournisseur. RIEN N'EST PRÉSÉLECTIONNÉ : une version précédente
       devinait le destinataire et s'est trompée deux fois en production. Le
       commercial choisit, le code rédige. */
    if (c.fournisseur && c.fournisseur.demandes) {
      var F = c.fournisseur;
      html += '<div class="rounded-xl border border-slate-200 p-4" data-bloc="fournisseur">' + titreBloc('Demander un prix au fournisseur');
      html += '<div class="mb-2 flex flex-wrap items-center gap-2"><select data-role="fourn-cible" class="rounded-lg border border-slate-200 px-2 py-1.5 text-sm"><option value="" selected>— choisir le fournisseur —</option>';
      ['moteurs', 'boites', 'injection', 'ponts'].forEach(function (k) {
        var d = F.demandes[k];
        if (d) html += '<option value="' + k + '">' + escapeHtml(d.libelle + ' — ' + d.contact) + '</option>';
      });
      html += '</select><span data-role="fourn-mail" class="text-xs text-slate-500"></span></div>';
      html += '<div class="mb-2"><input data-role="fourn-piece" type="text" maxlength="200" placeholder="Pièce demandée (ex. culasse Mazda CX-5 2.2D)" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" />';
      if (F.suggestions && F.suggestions.length) {
        html += '<div class="mt-1.5 flex flex-wrap items-start gap-2"><span class="pt-0.5 text-xs text-slate-400">Demandé par le client :</span>';
        F.suggestions.forEach(function (s, i) {
          html += '<button type="button" data-role="fourn-sugg" data-i="' + i + '" class="rounded-lg bg-slate-100 px-2 py-1 text-left text-xs text-slate-700 hover:bg-slate-200">' + escapeHtml(s.length > 70 ? s.slice(0, 69) + '…' : s) + '</button>';
        });
        html += '</div>';
      }
      html += '</div>';
      html += '<div data-role="fourn-vin-bloc" class="mb-2 hidden"><div class="flex flex-wrap items-center gap-2">'
        + '<input data-role="fourn-vin" type="text" maxlength="20" placeholder="VIN (17 caractères)" class="rounded-lg border border-slate-200 px-2 py-1.5 font-mono text-sm uppercase" />'
        + '<a href="' + escapeHtml(F.lienVin) + '" target="_blank" rel="noopener" class="text-xs text-primary hover:underline">convertir la plaque en VIN ↗</a></div>'
        + '<div class="mt-1 text-xs text-slate-400">Ce fournisseur demande le VIN. Sans lui, la demande part incomplète.</div></div>';
      html += '<div data-role="fourn-refs-bloc" class="mb-2 hidden"><input data-role="fourn-refs" type="text" maxlength="120" placeholder="Références pompe et/ou injecteurs" class="w-full rounded-lg border border-slate-200 px-3 py-2 font-mono text-sm" />'
        + '<div class="mt-1 text-xs text-slate-400">Ce fournisseur demande les références. Ne reprends pas celle du client sans l’avoir vérifiée.</div></div>';
      html += '<textarea data-role="fourn-corps" rows="9" class="w-full rounded-lg border border-slate-200 px-3 py-2 font-mono text-sm"></textarea>';
      html += '<div class="mt-2 flex flex-wrap items-center gap-2"><button type="button" data-role="fourn-copier" class="btn btn-primary text-xs">Copier</button>'
        + '<a data-role="fourn-mailto" class="btn btn-ghost text-xs">Ouvrir dans mon mail</a>'
        + '<button type="button" data-role="fourn-fait" class="btn btn-ghost text-xs">Demande envoyée</button>'
        + '<span data-role="fourn-retour" class="text-xs text-emerald-700"></span></div>';
      html += '</div>';
    }
    if (html === '<div class="space-y-4">') html += '<div class="text-sm text-slate-500">Aucune information sur la pièce.</div>';
    html += '</div>';
    return html;
  }

  function htmlClient(c) {
    var html = '<div class="space-y-4">';
    var nom = ((c.firstName || '') + ' ' + (c.lastName || '')).trim();
    html += '<div class="rounded-xl border border-slate-200 p-4">' + titreBloc('Coordonnées') + ligneInfo('Nom', nom) + ligneInfo('Email', c.email);
    if (c.phone) html += '<div class="flex gap-2 text-sm"><span class="w-24 shrink-0 text-slate-500">Téléphone</span><button type="button" data-copy-phone="' + escapeHtml(c.phone) + '" class="inline-flex items-center gap-1 font-medium text-slate-900 hover:text-primary">' + escapeHtml(c.phone) + '<span class="material-symbols-outlined text-[14px] text-slate-400">content_copy</span></button></div>';
    html += ligneInfo('Source', c.captureSourceLabel);
    if (c.attribution && c.attribution.source) html += ligneInfo('Arrivé par', c.attribution.source + (c.attribution.medium ? ' / ' + c.attribution.medium : '') + (c.attribution.campaign ? ' · ' + c.attribution.campaign : ''));
    html += ligneInfo('Reçu le', c.createdAt) + ligneInfo('Vu le', c.lastActivityAt);
    html += '</div>';

    if (c.clientOrders && c.clientOrders.length) {
      html += '<div class="rounded-xl border border-indigo-200 bg-indigo-50/40 p-4">' + titreBloc('Déjà client — ' + c.clientOrders.length + ' commande' + (c.clientOrders.length > 1 ? 's' : ''));
      c.clientOrders.forEach(function (o) {
        html += '<div class="border-b border-indigo-100 py-2 last:border-0"><div class="flex items-center justify-between gap-2 text-sm">'
          + '<a href="' + escapeHtml(o.url) + '" class="font-semibold text-indigo-800 hover:underline">n°' + escapeHtml(o.number) + '</a><span class="font-bold text-slate-900">' + escapeHtml(o.totalEuro) + '</span></div>'
          + '<div class="mt-0.5 text-xs text-slate-600">' + escapeHtml(o.date) + ' · <span class="font-medium">' + escapeHtml(o.status) + '</span></div>'
          + (o.products ? '<div class="mt-0.5 text-xs text-slate-500">' + escapeHtml(o.products) + '</div>' : '') + '</div>';
      });
      html += '</div>';
    } else if (c.clientOrders) {
      html += '<div class="rounded-xl border border-slate-200 p-4 text-sm text-slate-500">Jamais commandé chez nous (aucune commande avec cet email ou ce téléphone).</div>';
    }
    if (c.savTickets && c.savTickets.length) {
      html += '<div class="rounded-xl border border-amber-200 bg-amber-50/40 p-4">' + titreBloc('Tickets SAV (' + c.savTickets.length + ')');
      c.savTickets.forEach(function (t) {
        html += '<div class="flex items-center justify-between gap-2 border-b border-amber-100 py-1.5 text-sm last:border-0">'
          + '<a href="' + escapeHtml(t.url) + '" class="font-semibold text-amber-800 hover:underline">' + escapeHtml(t.numero) + '</a>'
          + '<span class="text-xs ' + (t.open ? 'font-bold text-amber-700' : 'text-slate-500') + '">' + escapeHtml(t.statut) + (t.open ? ' · en cours' : '') + '</span>'
          + '<span class="text-xs text-slate-400">' + escapeHtml(t.date) + '</span></div>';
      });
      html += '</div>';
    }
    if (c.sessionId) {
      html += '<a href="/admin/visiteurs/' + escapeHtml(c.sessionId) + '" class="flex items-center gap-3 rounded-xl border border-slate-200 p-4 hover:bg-slate-50"><span class="material-symbols-outlined text-slate-500">route</span>'
        + '<span class="flex-1 text-sm"><strong class="text-slate-900">Parcours sur le site</strong><span class="block text-slate-600">Les pages vues par le client avant sa demande.</span></span><span class="material-symbols-outlined text-slate-400">arrow_forward</span></a>';
    }
    html += '</div>';
    return html;
  }

  /* Ajout d'une note : sans recharger la page, l'historique se met à jour. */
  function brancherNote(zone, leadId, fiche) {
    var form = zone.querySelector('[data-role="note-form"]');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var ta = form.querySelector('textarea');
      var res = form.querySelector('[data-role="note-res"]');
      if (!ta.value.trim()) { res.innerHTML = '<span class="text-amber-700">Écris d’abord la note.</span>'; return; }
      var verrou = verrouEnvoi(form);
      if (!verrou) return;
      postJson('/admin/api/leads/' + leadId + '/note', { text: ta.value }).then(function (d) {
        if (d && d.ok) { delete detailCache[leadId]; toast('Note ajoutée'); afficherOnglet(fiche, 'suivi'); }
        else { verrou.echec(); res.innerHTML = '<span class="text-red-700">' + escapeHtml((d && d.error) || 'Erreur') + '</span>'; }
      }).catch(function () { verrou.echec(); res.innerHTML = '<span class="text-red-700">Erreur réseau</span>'; });
    });
  }

  /* Demande fournisseur : un seul texte, celui du serveur. Le front change de
     destinataire et remplit les blancs (pièce, VIN, références). */
  function brancherFournisseur(zone, c, leadId) {
    var bloc = zone.querySelector('[data-bloc="fournisseur"]');
    if (!bloc || !c.fournisseur) return;
    var F = c.fournisseur;
    function q(role) { return bloc.querySelector('[data-role="' + role + '"]'); }
    var cible = q('fourn-cible'), corps = q('fourn-corps'), piece = q('fourn-piece'), vin = q('fourn-vin'),
      vinBloc = q('fourn-vin-bloc'), refs = q('fourn-refs'), refsBloc = q('fourn-refs-bloc'),
      mailto = q('fourn-mailto'), mail = q('fourn-mail'), retour = q('fourn-retour');

    function courantF() { return F.demandes[cible.value]; }
    function remplir(texte, d) {
      var p = (piece.value || '').trim();
      var v = (vin.value || '').trim().toUpperCase();
      var r = (refs.value || '').trim();
      if (p) texte = texte.split('Demande client : ' + F.aRemplir).join('Demande client : ' + p);
      if (v) texte = texte.split('VIN : ' + F.aRemplir).join('VIN : ' + v);
      if (r && d && d.refsLibelle) texte = texte.split(d.refsLibelle + ' : ' + F.aRemplir).join(d.refsLibelle + ' : ' + r);
      return texte;
    }
    function objetCourant(d) {
      var p = (piece.value || '').trim();
      if (!p) return d.objet;
      return d.objet.split(F.aRemplir).join(p.length > 60 ? p.slice(0, 59).trim() + '…' : p);
    }
    function majMailto() {
      var d = courantF();
      if (!d) { mailto.removeAttribute('href'); return; }
      mailto.href = 'mailto:' + d.email + '?subject=' + encodeURIComponent(objetCourant(d)) + '&body=' + encodeURIComponent(corps.value);
    }
    function rendre() {
      var d = courantF();
      if (!d) {
        corps.value = '';
        corps.placeholder = 'Choisis d’abord le fournisseur ci-dessus.';
        mail.textContent = '';
        vinBloc.classList.add('hidden');
        refsBloc.classList.add('hidden');
        mailto.removeAttribute('href');
        return;
      }
      corps.value = remplir(d.corps, d);
      mail.textContent = d.email;
      vinBloc.classList.toggle('hidden', !d.vinRequis);
      refsBloc.classList.toggle('hidden', !d.refsRequises);
      majMailto();
    }
    cible.addEventListener('change', rendre);
    piece.addEventListener('input', rendre);
    vin.addEventListener('input', rendre);
    refs.addEventListener('input', rendre);
    corps.addEventListener('input', majMailto);
    Array.prototype.forEach.call(bloc.querySelectorAll('[data-role="fourn-sugg"]'), function (b) {
      b.addEventListener('click', function () { piece.value = F.suggestions[Number(b.dataset.i)] || ''; rendre(); piece.focus(); });
    });
    function dire(t) { retour.textContent = t; setTimeout(function () { retour.textContent = ''; }, 2500); }
    q('fourn-copier').addEventListener('click', function () {
      if (!corps.value.trim()) { dire('Choisis un fournisseur'); return; }
      corps.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(corps.value).then(function () { dire('Copié'); }, function () { dire(ok ? 'Copié' : 'Copie impossible — Ctrl+C'); });
      } else dire(ok ? 'Copié' : 'Copie impossible — Ctrl+C');
    });
    /* Trace la démarche sur la fiche : sinon personne ne sait si le fournisseur a été relancé. */
    q('fourn-fait').addEventListener('click', function () {
      var d = courantF();
      if (!d) { dire('Choisis un fournisseur'); return; }
      postJson('/admin/api/leads/' + leadId + '/note', { text: 'Demande de tarif envoyée à ' + d.contact + ' (' + d.email + ')' })
        .then(function (j) { if (j && j.ok) delete detailCache[leadId]; dire(j && j.ok ? 'Noté dans le suivi' : 'Échec de l’enregistrement'); })
        .catch(function () { dire('Échec de l’enregistrement'); });
    });
    rendre();
  }

  // ─ Relance auto manuelle : envoie tout de suite l'email n° suivant du cycle ─
  document.querySelectorAll('.lead-remind-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var n = btn.dataset.next || '';
      if (!confirm('Envoyer maintenant l’email de relance automatique n°' + n + ' à ce client ?')) return;
      btn.disabled = true;
      btn.style.opacity = '0.5';
      fetch('/admin/relances/' + btn.dataset.leadId + '/relancer', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.ok) refresh();
          else { alert('Erreur : ' + (d && d.error ? d.error : 'inconnue')); btn.disabled = false; btn.style.opacity = ''; }
        })
        .catch(function () { alert('Erreur réseau'); btn.disabled = false; btn.style.opacity = ''; });
    });
  });

  // ─ Templates injectés depuis le serveur ─
  var EMAIL_TEMPLATES = <%- JSON.stringify(emailTemplates || []) %>;
  var SMS_TEMPLATES = <%- JSON.stringify(smsTemplates || []) %>;

  /* La même liste alimente le composeur SMS et le composeur WhatsApp, mais les
     deux canaux n'ont pas les mêmes règles (en SMS le client ne peut pas
     répondre et les liens sont jetés). Un modèle peut donc déclarer
     `channels: ['whatsapp']` ; sans ce champ il reste proposé partout. */
  function smsTemplatesFor(channel) {
    return SMS_TEMPLATES.filter(function (t) {
      return !t.channels || t.channels.indexOf(channel) >= 0;
    });
  }

  /* Le lead n'a ni plaque ni VIN → on ne peut rien lui confirmer. Le composeur
     préselectionne alors le modèle qui réclame l'info plutôt qu'un modèle de
     relance commerciale qui tomberait à plat. Concerne 45 % des leads. */
  function leadMissesPlate(c) {
    var r = (c && c.requested) || {};
    return !String(r.plate || '').trim() && !String(r.vin || '').trim();
  }

  var EMAIL_VARIABLES = [
    { key: 'prenom', label: 'Prénom' },
    { key: 'nom', label: 'Nom' },
    { key: 'nom_produit', label: 'Produit' },
    { key: 'prix_total', label: 'Prix total' },
    { key: 'lien_panier', label: 'Lien panier sauvegardé' },
    { key: 'lien_produit', label: 'Lien produit' },
    { key: 'nom_commercial', label: 'Mon nom' },
    { key: 'telephone', label: 'Téléphone société' },
    { key: 'brand', label: 'Marque' },
  ];

  function fetchLeadDetail(leadId) {
    return fetch('/admin/activite-panier/' + leadId, { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); });
  }

  function renderLeadHeader(c) {
    var name = ((c.firstName || '') + ' ' + (c.lastName || '')).trim() || c.email || c.phone || 'Anonyme';
    var emailsCount = c.manualEmailsSent || 0;
    var smsCount = c.manualSmsSent || 0;
    var isDevisOrContact = c.captureSource === 'devis' || c.captureSource === 'contact';
    var hasReq = c.hasRequested || (c.requested && (c.requested.ref || c.requested.vehicle || c.requested.vin));

    var html = ''
      + '<div class="rounded-xl bg-gradient-to-br from-slate-50 to-slate-100 border border-slate-200 p-4 mb-4">'
      + '  <div class="flex items-start gap-3">';

    /* Visual: pour devis/contact avec demande, on montre une icône, pas le produit du panier */
    if (isDevisOrContact && hasReq) {
      html += '<div class="w-14 h-14 rounded-lg bg-teal-50 border border-teal-200 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-teal-600">request_quote</span></div>';
    } else if (c.items && c.items[0] && c.items[0].image) {
      html += '<img src="' + escapeHtml(c.items[0].image) + '" alt="" class="w-14 h-14 rounded-lg object-cover border border-slate-200 flex-shrink-0" />';
    } else {
      html += '<div class="w-14 h-14 rounded-lg bg-slate-200 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-slate-400">person</span></div>';
    }

    html += '<div class="flex-1 min-w-0">'
      + '<div class="font-semibold text-slate-900 text-sm">' + escapeHtml(name) + '</div>'
      + '<div class="text-xs text-slate-500 mt-0.5 space-y-0.5">';
    if (c.email) html += '<div>📧 ' + escapeHtml(c.email) + '</div>';
    if (c.phone) html += '<div>📞 ' + escapeHtml(c.phone) + '</div>';
    html += '</div>';

    /* Section principale : demande explicite si devis/contact, sinon panier */
    if (isDevisOrContact && hasReq) {
      var bits = [];
      if (c.requested.ref) bits.push(escapeHtml(c.requested.ref));
      if (c.requested.vehicle) bits.push(escapeHtml(c.requested.vehicle));
      if (c.requested.vin) bits.push('VIN ' + escapeHtml(c.requested.vin));
      else if (c.requested.plate) bits.push(escapeHtml(c.requested.plate));
      html += '<div class="mt-2 rounded-md bg-teal-50/60 border border-teal-100 px-2 py-1.5">'
        + '<div class="text-[10px] uppercase tracking-wider text-teal-700 font-semibold">Demande</div>'
        + '<div class="text-sm font-medium text-slate-900">' + (bits.length ? bits.join(' · ') : '<span class="text-slate-400 italic">sans détails</span>') + '</div>';
      if (c.requested.message) {
        html += '<div class="text-xs text-slate-600 italic mt-0.5">"' + escapeHtml(c.requested.message.slice(0, 140)) + (c.requested.message.length > 140 ? '…' : '') + '"</div>';
      }
      html += '</div>';
      if (c.items && c.items.length) {
        html += '<div class="mt-1 text-xs text-amber-700">⚠ Avait aussi en panier : ' + escapeHtml(c.items[0].name) + ' · ' + escapeHtml(c.totalAmount || '—') + '</div>';
      }
    } else {
      html += '<div class="mt-2 text-sm text-slate-700">'
        + '<span class="font-semibold">' + escapeHtml(c.totalAmount || '—') + '</span>';
      if (c.items && c.items.length) {
        html += ' · ' + escapeHtml(c.items[0].name) + (c.items.length > 1 ? ' +' + (c.items.length - 1) : '');
      }
      html += '</div>';
    }

    html += '<div class="mt-1 text-xs text-slate-400">'
      + (c.captureSourceLabel ? 'Source : ' + escapeHtml(c.captureSourceLabel) : '')
      + (c.lastActivityAt ? ' · Vu ' + escapeHtml(c.lastActivityAt) : '')
      + '</div>'
      + '<div class="mt-1 text-xs text-slate-400">';
    if (emailsCount) html += '<span>📧 ' + emailsCount + ' email(s) envoyé(s)</span>';
    if (emailsCount && smsCount) html += ' · ';
    if (smsCount) html += '<span>📱 ' + smsCount + ' SMS</span>';
    if (!emailsCount && !smsCount) html += '<span class="text-slate-300">Aucun contact manuel pour l’instant</span>';
    html += '</div>'
      + '</div></div></div>';
    return html;
  }

  function buildVariablesToolbar(targetId) {
    var html = '<div class="flex flex-wrap gap-1 mb-2">';
    html += '<span class="text-xs text-slate-400 mr-1 self-center">Insérer :</span>';
    EMAIL_VARIABLES.forEach(function (v) {
      html += '<button type="button" class="var-insert-btn px-2 py-0.5 text-xs rounded-md border border-slate-200 bg-white hover:bg-blue-50 hover:border-blue-300 text-slate-700" '
        + 'data-var="{' + v.key + '}" data-target="' + targetId + '" title="' + escapeHtml(v.label) + '">{' + v.key + '}</button>';
    });
    html += '</div>';
    return html;
  }

  function attachVariableInserters(scope) {
    scope.querySelectorAll('.var-insert-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var targetId = btn.dataset.target;
        var token = btn.dataset.var;
        var target = document.getElementById(targetId);
        if (!target) return;
        var start = target.selectionStart || 0;
        var end = target.selectionEnd || 0;
        target.value = target.value.slice(0, start) + token + target.value.slice(end);
        target.focus();
        target.selectionStart = target.selectionEnd = start + token.length;
        target.dispatchEvent(new Event('input'));
      });
    });
  }

  function insertAtCursor(target, token) {
    if (!target) return;
    var start = target.selectionStart || 0;
    var end = target.selectionEnd || 0;
    target.value = target.value.slice(0, start) + token + target.value.slice(end);
    target.focus();
    target.selectionStart = target.selectionEnd = start + token.length;
    target.dispatchEvent(new Event('input'));
  }

  // ─ Picker « Ajouter un article » : recherche le catalogue et insère au
  //   curseur un token [[article|sku|prix|libellé]] → rendu en lien naturel
  //   côté serveur (le prix affiché est modifiable dans le token). ─
  function buildArticlePicker(targetId) {
    return '<div class="mb-2">'
      + '<button type="button" id="' + targetId + '-artbtn" class="inline-flex items-center gap-1 px-2 py-1 text-xs rounded-md border border-blue-200 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold">'
      + '<span class="material-symbols-outlined text-sm">add_shopping_cart</span>Ajouter un article</button>'
      + '<span class="text-[11px] text-slate-400 ml-2">→ insère un lien naturel dans ton message</span>'
      + '<div id="' + targetId + '-artbox" class="hidden mt-2 rounded-lg border border-slate-200 bg-white p-2">'
      + '<input type="text" id="' + targetId + '-artq" placeholder="Réf, modèle, moteur… (ex : Z20DMH, DSG, culasse Opel)" autocomplete="off" class="w-full rounded-md border border-slate-200 px-2 py-1.5 text-sm mb-1" />'
      + '<div id="' + targetId + '-artres" class="max-h-56 overflow-auto"></div>'
      + '</div></div>';
  }

  function attachArticlePicker(scope, targetId) {
    var toggle = scope.querySelector('#' + targetId + '-artbtn');
    var box = scope.querySelector('#' + targetId + '-artbox');
    var input = scope.querySelector('#' + targetId + '-artq');
    var results = scope.querySelector('#' + targetId + '-artres');
    var target = document.getElementById(targetId);
    if (!toggle || !box || !input || !results || !target) return;
    var timer = null, lastQ = null, reqSeq = 0;

    toggle.addEventListener('click', function () {
      box.classList.toggle('hidden');
      if (!box.classList.contains('hidden')) { input.focus(); if (lastQ === null) doSearch(''); }
    });
    input.addEventListener('input', function () {
      var q = input.value.trim();
      if (timer) clearTimeout(timer);
      timer = setTimeout(function () { doSearch(q); }, 250);
    });

    function doSearch(q) {
      lastQ = q;
      var seq = ++reqSeq;
      results.innerHTML = '<div class="px-2 py-2 text-xs text-slate-400">Recherche…</div>';
      fetch('/admin/api/products/search?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (d) { if (seq === reqSeq) renderResults((d && d.items) || []); })
        .catch(function () { if (seq === reqSeq) results.innerHTML = '<div class="px-2 py-2 text-xs text-red-600">Erreur de recherche</div>'; });
    }

    function renderResults(items) {
      if (!items.length) { results.innerHTML = '<div class="px-2 py-3 text-xs text-slate-400">Aucun article trouvé.</div>'; return; }
      results.innerHTML = '';
      items.slice(0, 12).forEach(function (p) {
        var price = Math.round((p.priceCents || 0) / 100);
        var row = document.createElement('button');
        row.type = 'button';
        row.className = 'w-full text-left flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-blue-50';
        row.innerHTML = '<span class="material-symbols-outlined text-slate-400 text-base flex-shrink-0">description</span>'
          + '<span class="flex-1 min-w-0"><span class="block text-xs text-slate-800 truncate">' + escapeHtml(p.name || '') + '</span>'
          + '<span class="block text-[11px] text-slate-400 truncate">' + escapeHtml((p.sku || '') + (p.brand ? ' · ' + p.brand : '')) + '</span></span>'
          + '<span class="text-xs font-semibold text-slate-700 whitespace-nowrap">' + price.toLocaleString('fr-FR') + ' €</span>'
          + '<span class="text-[11px] text-blue-600 font-semibold whitespace-nowrap">+ insérer</span>';
        row.addEventListener('click', function () {
          var label = String(p.name || '').replace(/[|\]]/g, ' ').replace(/\s+/g, ' ').trim();
          var sku = String(p.sku || '').replace(/[|\]]/g, '');
          insertAtCursor(target, '[[article|' + sku + '|' + price + '|' + label + ']]');
          box.classList.add('hidden');
          input.value = '';
          lastQ = null;
          results.innerHTML = '';
        });
        results.appendChild(row);
      });
    }
  }

  // ─ Reformulation IA (ChatGPT) d'un message du composer, avant envoi ─
  function reformulateComposer(textarea, channel, btn, resultEl, clientName, onDone) {
    var draft = (textarea.value || '').trim();
    if (!draft) { if (resultEl) resultEl.innerHTML = '<span class="text-amber-600">Écris d\'abord un message à reformuler.</span>'; return; }
    var prev = textarea.value;
    var origHtml = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = '⏳ Reformulation…';
    fetch('/admin/api/messages/reformulate', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
      body: JSON.stringify({ draft: draft, channel: channel, clientName: clientName || '' })
    }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        btn.disabled = false; btn.innerHTML = origHtml;
        if (!res.ok || !res.j || !res.j.ok) { if (resultEl) resultEl.innerHTML = '<span class="text-red-700">' + escapeHtml((res.j && res.j.error) || 'Erreur IA') + '</span>'; return; }
        textarea.value = res.j.reformulated;
        if (onDone) onDone();
        if (resultEl) {
          resultEl.innerHTML = '<span class="text-indigo-600">✨ Reformulé par l\'IA. </span><button type="button" id="' + textarea.id + '-undo" class="underline font-semibold text-indigo-600 text-sm">Annuler</button>';
          var u = document.getElementById(textarea.id + '-undo');
          if (u) u.addEventListener('click', function () { textarea.value = prev; if (onDone) onDone(); resultEl.textContent = ''; });
        }
      }).catch(function () { btn.disabled = false; btn.innerHTML = origHtml; if (resultEl) resultEl.innerHTML = '<span class="text-red-700">Erreur réseau — réessaie.</span>'; });
  }

  // ─ Modal EMAIL ─
  function openEmailModal(leadId, lead) {
    var c = lead || {};
    openModal('Envoyer un email');

    var templatesOptions = '<option value="">— Choisir un template —</option>';
    EMAIL_TEMPLATES.forEach(function (t) {
      templatesOptions += '<option value="' + escapeHtml(t.key) + '">' + escapeHtml(t.label) + '</option>';
    });

    content.innerHTML = ''
      + renderLeadHeader(c)
      + '<form id="lead-email-form" class="space-y-3">'
      + '<div class="text-xs text-slate-500">Destinataire : <strong>' + escapeHtml(c.email || '') + '</strong></div>'
      + '<select id="lead-email-template" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm bg-white">'
      + templatesOptions + '</select>'
      + '<input type="text" id="lead-email-subject" name="subject" placeholder="Sujet" required maxlength="200" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" />'
      + buildVariablesToolbar('lead-email-body')
      + buildArticlePicker('lead-email-body')
      + '<textarea id="lead-email-body" name="body" rows="10" required maxlength="8000" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" placeholder="Bonjour {prenom},&#10;&#10;Suite à votre passage sur notre site…"></textarea>'
      + '<label class="flex items-center gap-2 text-sm"><input type="checkbox" id="lead-email-cta" checked /> Inclure un bouton "Reprendre mon panier"</label>'
      + '<div class="flex items-center gap-2 pt-2">'
      + '  <button type="submit" class="btn btn-primary text-sm">📧 Envoyer</button>'
      + '  <button type="button" id="lead-email-ai" class="btn btn-secondary text-sm" style="color:#4f46e5;border-color:#c7d2fe" title="Reformuler le message avec l’IA">✨ Reformuler IA</button>'
      + '  <button type="button" id="lead-email-preview-btn" class="btn btn-secondary text-sm">👁 Aperçu</button>'
      + '  <button type="button" onclick="document.getElementById(\'lead-modal\').classList.add(\'hidden\')" class="btn btn-ghost text-sm">Annuler</button>'
      + '</div>'
      + '<div id="lead-email-result" class="text-sm"></div>'
      + '</form>'
      + '<div id="lead-email-preview-area" class="hidden mt-4 rounded-xl border border-slate-200 overflow-hidden">'
      + '  <div class="px-3 py-2 bg-slate-50 border-b border-slate-200 text-xs text-slate-500">Aperçu de l’email tel qu’il sera reçu :</div>'
      + '  <iframe id="lead-email-preview-frame" sandbox="allow-same-origin" style="width:100%;height:400px;border:0;background:#f3f4f6;"></iframe>'
      + '</div>';

    var form = document.getElementById('lead-email-form');
    var subjectEl = document.getElementById('lead-email-subject');
    var bodyEl = document.getElementById('lead-email-body');
    var ctaEl = document.getElementById('lead-email-cta');
    var templateEl = document.getElementById('lead-email-template');
    var previewBtn = document.getElementById('lead-email-preview-btn');
    var previewArea = document.getElementById('lead-email-preview-area');
    var previewFrame = document.getElementById('lead-email-preview-frame');
    var aiBtn = document.getElementById('lead-email-ai');
    if (aiBtn) aiBtn.addEventListener('click', function () {
      reformulateComposer(bodyEl, 'email', aiBtn, document.getElementById('lead-email-result'), c.fullName, null);
    });

    attachVariableInserters(form);
    attachArticlePicker(form, 'lead-email-body');

    // Sélectionne automatiquement le template le plus pertinent selon la source
    var defaultTpl = EMAIL_TEMPLATES.find(function (t) {
      return t.forSource && t.forSource.indexOf(c.captureSource) >= 0;
    }) || EMAIL_TEMPLATES.find(function (t) { return t.key === 'cart_reminder'; });

    function applyTemplate(tpl) {
      if (!tpl) return;
      subjectEl.value = tpl.subject || '';
      bodyEl.value = tpl.body || '';
      // Le template décide si le CTA panier est pertinent (false pour devis/contact)
      if (typeof tpl.defaultIncludeCta === 'boolean') {
        ctaEl.checked = tpl.defaultIncludeCta;
      }
    }

    if (defaultTpl) {
      templateEl.value = defaultTpl.key;
      applyTemplate(defaultTpl);
    } else {
      // Pas de template par défaut : CTA off pour les leads sans panier pertinent
      var isExplicitRequest = c.captureSource === 'devis' || c.captureSource === 'contact';
      ctaEl.checked = !isExplicitRequest && c.items && c.items.length > 0;
    }

    templateEl.addEventListener('change', function () {
      var tpl = EMAIL_TEMPLATES.find(function (t) { return t.key === templateEl.value; });
      if (tpl) applyTemplate(tpl);
    });

    previewBtn.addEventListener('click', function () {
      previewArea.classList.remove('hidden');
      previewFrame.srcdoc = '<div style="padding:24px;font-family:sans-serif;color:#888">Chargement…</div>';
      fetch('/admin/api/leads/' + leadId + '/email/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subject: subjectEl.value, body: bodyEl.value, includeCartCta: ctaEl.checked }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.ok) {
            previewFrame.srcdoc = d.previewHtml;
            // mettre à jour le sujet réel (avec variables remplacées) en placeholder discret
            subjectEl.title = 'Envoyé tel quel (variables remplacées) : ' + d.subject;
          } else {
            previewFrame.srcdoc = '<div style="padding:24px;color:#dc2626">Erreur : ' + escapeHtml(d && d.error ? d.error : 'inconnue') + '</div>';
          }
        })
        .catch(function () {
          previewFrame.srcdoc = '<div style="padding:24px;color:#dc2626">Erreur réseau</div>';
        });
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var verrou = verrouEnvoi(form);
      if (!verrou) return;
      var resultEl = document.getElementById('lead-email-result');
      resultEl.textContent = 'Envoi…';
      fetch('/admin/api/leads/' + leadId + '/email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          subject: subjectEl.value,
          body: bodyEl.value,
          templateKey: templateEl.value || '',
          includeCartCta: ctaEl.checked,
        }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d && d.ok) { resultEl.innerHTML = '<span class="text-green-700 font-semibold">✓ Email envoyé à ' + escapeHtml(d.sentTo) + '</span>'; setTimeout(refresh, 1000); }
          else { verrou.echec(); resultEl.innerHTML = '<span class="text-red-700">Erreur : ' + escapeHtml(d && d.error ? d.error : '?') + '</span>'; }
        })
        .catch(function () { verrou.echec(); resultEl.innerHTML = '<span class="text-red-700">Erreur réseau</span>'; });
    });
  }


    html += ligneInfo('Source', c.captureSourceLabel);
    if (c.attribution && c.attribution.source) html += ligneInfo('Arrivé par', c.attribution.source + (c.attribution.medium ? ' / ' + c.attribution.medium : '') + (c.attribution.campaign ? ' · ' + c.attribution.campaign : ''));

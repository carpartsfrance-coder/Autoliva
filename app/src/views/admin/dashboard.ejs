<%- include('./partials/head') %>

<%- include('./partials/sidebar', { active: 'dashboard' }) %>

<main class="flex-1 relative">
  <%- include('./partials/skeleton-dashboard') %>
  <div class="px-6 lg:px-10 py-8">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
      <div>
        <div class="text-2xl md:text-3xl font-semibold text-slate-900">Tableau de Bord Global</div>
        <div class="mt-1 text-sm text-slate-500">Aperçu des performances de <%= brand.NAME %></div>
      </div>

      <% if (showFinancials) { %>
        <% var _pk = (typeof period !== 'undefined' && period && period.key) ? period.key : '6m'; %>
        <form method="GET" action="/admin" class="flex items-end gap-2 flex-wrap">
          <div>
            <label class="block text-[10px] font-semibold uppercase tracking-widest text-slate-400 mb-1" for="dashPeriod">Période</label>
            <select id="dashPeriod" name="period" onchange="if(this.value!=='custom'){this.form.from.value='';this.form.to.value='';}this.form.submit();" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-bold text-slate-900">
              <option value="7d" <%= _pk==='7d'?'selected':'' %>>7 derniers jours</option>
              <option value="30d" <%= _pk==='30d'?'selected':'' %>>30 derniers jours</option>
              <option value="90d" <%= _pk==='90d'?'selected':'' %>>90 derniers jours</option>
              <option value="6m" <%= _pk==='6m'?'selected':'' %>>6 derniers mois</option>
              <option value="12m" <%= _pk==='12m'?'selected':'' %>>12 derniers mois</option>
              <option value="year" <%= _pk==='year'?'selected':'' %>>Cette année</option>
              <% if (_pk==='custom') { %><option value="custom" selected>Période personnalisée</option><% } %>
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-semibold uppercase tracking-widest text-slate-400 mb-1" for="dashFrom">Du</label>
            <input id="dashFrom" type="date" name="from" value="<%= (typeof period !== 'undefined' && period && period.key==='custom') ? period.from : '' %>" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900" />
          </div>
          <div>
            <label class="block text-[10px] font-semibold uppercase tracking-widest text-slate-400 mb-1" for="dashTo">Au</label>
            <input id="dashTo" type="date" name="to" value="<%= (typeof period !== 'undefined' && period && period.key==='custom') ? period.to : '' %>" class="rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900" />
          </div>
          <button class="btn btn-primary" type="submit">
            <span class="material-symbols-outlined mr-2 text-base">filter_alt</span>
            Appliquer
          </button>
        </form>
      <% } %>
    </div>

    <!-- KPI Cards Row 1 -->
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 <%= showFinancials ? 'xl:grid-cols-4' : 'xl:grid-cols-2' %> gap-6">

      <%# Les badges « +12 % », « +5.2 % » et les petites courbes étaient écrits en dur
          (toujours les mêmes, quelles que soient les ventes). Remplacés par de vraies
          comparaisons ; seule la carte du jour garde une courbe : les 7 derniers jours. %>
      <% if (showFinancials) { %>
        <% const _sem = (typeof weeklyChart !== 'undefined' && weeklyChart && Array.isArray(weeklyChart.values)) ? weeklyChart.values : [];
           const _semMax = Math.max(1, ..._sem);
           const _semPts = _sem.map((v, k) => ((_sem.length > 1 ? (k * 100 / (_sem.length - 1)) : 0).toFixed(1)) + ',' + (32 - (v / _semMax) * 28).toFixed(1)).join(' L');
           const _tendance = kpis && typeof kpis.revenueMonthTrendPct === 'number' ? kpis.revenueMonthTrendPct : null; %>
        <!-- Chiffre d'affaires (jour) -->
        <a class="kpi-card" href="/admin/commandes">
          <div class="kpi-card__header">
            <div class="kpi-card__icon bg-green-50 text-green-600">
              <span class="material-symbols-outlined">payments</span>
            </div>
          </div>
          <div class="kpi-card__label">Chiffre d'affaires (jour)</div>
          <div class="kpi-card__value"><%= kpis && kpis.revenueToday ? kpis.revenueToday : '—' %></div>
          <div class="kpi-card__compare">
            Hier : <strong class="text-slate-700"><%= kpis && kpis.revenueYesterday ? kpis.revenueYesterday : '—' %></strong>
          </div>
          <% if (_sem.length > 1 && _sem.some((v) => v > 0)) { %>
          <div class="kpi-card__sparkline" title="Ventes des 7 derniers jours">
            <svg viewBox="0 0 100 36" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M<%= _semPts %>" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
              <path d="M<%= _semPts %> L100,36 L0,36 Z" fill="#059669" fill-opacity="0.08"/>
            </svg>
          </div>
          <% } %>
        </a>

        <!-- C.A. (mois en cours) -->
        <a class="kpi-card" href="/admin/commandes">
          <div class="kpi-card__header">
            <div class="kpi-card__icon bg-blue-50 text-blue-600">
              <span class="material-symbols-outlined">monitoring</span>
            </div>
            <% if (_tendance !== null) { %>
              <span class="badge <%= _tendance >= 0 ? 'badge-success' : 'badge-danger' %>"><%= _tendance >= 0 ? '+' : '' %><%= _tendance %> %</span>
            <% } %>
          </div>
          <div class="kpi-card__label" title="Commandes payées, hors cautions de consigne (remboursables)">C.A. (mois en cours)</div>
          <div class="kpi-card__value"><%= kpis && kpis.revenueMonth ? kpis.revenueMonth : '—' %></div>
          <div class="kpi-card__compare">
            Mois dernier à la même date : <strong class="text-slate-700"><%= kpis && kpis.revenuePrevMonthToDate ? kpis.revenuePrevMonthToDate : '—' %></strong>
          </div>
        </a>

        <!-- Panier moyen -->
        <a class="kpi-card" href="/admin/commandes">
          <div class="kpi-card__header">
            <div class="kpi-card__icon bg-violet-50 text-violet-600">
              <span class="material-symbols-outlined">shopping_basket</span>
            </div>
          </div>
          <div class="kpi-card__label">Panier moyen (ce mois)</div>
          <div class="kpi-card__value"><%= kpis && kpis.averageBasket ? kpis.averageBasket : '—' %></div>
          <div class="kpi-card__compare">
            <% const _nbMois = kpis && kpis.ordersThisMonth ? kpis.ordersThisMonth : 0; %><%= _nbMois %> commande<%= _nbMois > 1 ? 's' : '' %> payée<%= _nbMois > 1 ? 's' : '' %> ce mois
          </div>
        </a>
      <% } %>

      <%# Ce compteur ne compte que les commandes NON PAYÉES (statut « en attente de paiement » :
          virement pas encore reçu, paiement interrompu) — pas les commandes à préparer. %>
      <% const _nbAttente = kpis && typeof kpis.pendingOrdersCount !== 'undefined' ? kpis.pendingOrdersCount : 0; %>
      <a class="kpi-card" href="/admin/commandes?status=pending_payment">
        <div class="kpi-card__header">
          <div class="kpi-card__icon bg-orange-50 text-orange-600">
            <span class="material-symbols-outlined">hourglass_top</span>
          </div>
          <% if (_nbAttente > 0) { %><div class="w-2 h-2 rounded-full bg-orange-500 mt-1"></div><% } %>
        </div>
        <div class="kpi-card__label">En attente de paiement</div>
        <div class="kpi-card__value"><%= _nbAttente %></div>
        <div class="kpi-card__compare">
          Virements à recevoir, paiements pas finis
        </div>
      </a>

    </div>

    <!-- KPI Cards Row 2 -->
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 <%= showFinancials ? 'xl:grid-cols-4' : 'xl:grid-cols-1' %> gap-6">
      <a class="block bg-white rounded-2xl border border-slate-200 p-5 hover:border-slate-300" href="/admin/catalogue?stock=bas">
        <div class="flex items-center justify-between">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
            <span class="material-symbols-outlined">warning</span>
          </div>
          <% const _nbStockBas = kpis && typeof kpis.stockAlertsCount !== 'undefined' ? kpis.stockAlertsCount : 0; %>
          <% if (_nbStockBas > 0) { %><div class="w-2 h-2 rounded-full bg-amber-500"></div><% } %>
        </div>
        <%# Comptait toutes les fiches à stock ≤ 2, ruptures comprises (3 513 « alertes » : la plupart des
            pièces sont commandées à la demande). Seulement les fiches publiées à 1 ou 2 pièces. %>
        <div class="mt-4 text-[10px] font-semibold uppercase tracking-widest text-slate-400">Stock bas (1 ou 2 pièces)</div>
        <div class="mt-2 text-2xl font-semibold <%= _nbStockBas > 0 ? 'text-primary' : 'text-slate-900' %>"><%= _nbStockBas %> article<%= _nbStockBas > 1 ? 's' : '' %></div>
      </a>

      <% if (showFinancials) { %>
        <!-- Top 3 Products -->
        <div class="xl:col-span-3 bg-white rounded-2xl border border-slate-200 p-5">
          <div class="text-[10px] font-semibold uppercase tracking-widest text-slate-400 mb-3">Top 3 produits vendus (ce mois)</div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <% const topProducts = kpis && Array.isArray(kpis.topProducts) ? kpis.topProducts : []; %>
            <% if (topProducts.length) { %>
              <% topProducts.forEach((p, idx) => { %>
                <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-50">
                  <div class="w-8 h-8 rounded-lg flex items-center justify-center font-semibold text-sm <%= idx === 0 ? 'bg-amber-100 text-amber-700' : idx === 1 ? 'bg-slate-200 text-slate-500' : 'bg-orange-100 text-orange-600' %>">
                    #<%= idx + 1 %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-bold text-slate-900 truncate"><%= p.name %></div>
                    <div class="text-xs text-slate-500"><%= p.qty %> vendus &middot; <%= p.revenue %></div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-sm text-slate-500 col-span-3">Aucune vente ce mois.</div>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>

    <%# ── Santé de la traduction allemande ──────────────────────────────
        Affiché SEULEMENT quand il y a quelque chose à dire : un encart vert
        permanent finit par ne plus être lu, et c'est exactement comme ça
        qu'une panne silencieuse le reste. %>
    <% var _sd = typeof santeDe !== 'undefined' && santeDe ? santeDe : null; %>
    <% if (_sd && _sd.verdict !== 'ok') { %>
      <%
        var _sdCouleur = _sd.verdict === 'alerte' ? 'red' : (_sd.verdict === 'en_cours' ? 'blue' : 'slate');
        var _sdIcone = _sd.verdict === 'alerte' ? 'warning' : (_sd.verdict === 'en_cours' ? 'autorenew' : 'translate');
      %>
      <div class="mt-8 bg-white rounded-2xl border border-<%= _sdCouleur %>-200 p-6">
        <div class="flex items-start gap-3">
          <span class="material-symbols-outlined text-lg text-<%= _sdCouleur %>-600 mt-0.5"><%= _sdIcone %></span>
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-slate-900">Traduction allemande</div>
            <p class="mt-1 text-sm text-slate-600"><%= _sd.message %></p>
            <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-xs text-slate-500">
              <span>Fiches : <strong class="text-slate-700"><%= (_sd.fiches.publiees - _sd.fiches.enAttente).toLocaleString('fr-FR') %></strong> / <%= _sd.fiches.publiees.toLocaleString('fr-FR') %></span>
              <span>Articles : <strong class="text-slate-700"><%= _sd.articles.publies - _sd.articles.enAttente %></strong> / <%= _sd.articles.publies %></span>
              <% if (_sd.quarantaine) { %><span class="text-red-600">Mises de côté : <strong><%= _sd.quarantaine %></strong></span><% } %>
              <% if (_sd.derniereTraductionH !== null) { %><% const _dtH = Number(_sd.derniereTraductionH) || 0; %><span>Dernière traduction : il y a <%= _dtH >= 48 ? Math.round(_dtH / 24) + ' jours' : Math.round(_dtH) + ' h' %></span><% } %>
              <% if (_sd.balayageEnCours) { %><span class="text-blue-600">Balayage en cours</span><% } %>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <%# ── SMS d'accusé de réception (appel manqué) ─────────────────────
        Affiché SEULEMENT quand il y a quelque chose à dire. Le 25/09/2026,
        Ringover a cessé d'accepter les envois : 19 jours et 692 clients plus
        tard, personne ne l'avait vu. C'est cet encart qui aurait prévenu. %>
    <% var _ss = typeof santeSms !== 'undefined' && santeSms ? santeSms : null; %>
    <% if (_ss && _ss.verdict !== 'ok') { %>
      <% var _ssCouleur = _ss.verdict === 'alerte' ? 'red' : 'amber'; %>
      <div class="mt-8 bg-white rounded-2xl border border-<%= _ssCouleur %>-200 p-6">
        <div class="flex items-start gap-3">
          <span class="material-symbols-outlined text-lg text-<%= _ssCouleur %>-600 mt-0.5">sms_failed</span>
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-slate-900">SMS de rappel aux appels manqués</div>
            <p class="mt-1 text-sm text-slate-600"><%= _ss.message %></p>
            <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-xs text-slate-500">
              <span class="text-<%= _ssCouleur %>-600">Échecs : <strong><%= _ss.echecs.toLocaleString('fr-FR') %></strong></span>
              <% if (_ss.clients) { %><span>Clients sans réponse : <strong class="text-slate-700"><%= _ss.clients.toLocaleString('fr-FR') %></strong></span><% } %>
              <% if (_ss.couverts) { %><span class="text-emerald-600">Prévenus via Brevo : <strong><%= _ss.couverts.toLocaleString('fr-FR') %></strong></span><% } %>
              <% if (_ss.jours !== null) { %><span>Dernier envoi : il y a <%= _ss.jours %> j</span><% } %>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Pipeline Clonage Widget -->
    <%
      var _pl = typeof pipeline !== 'undefined' && pipeline ? pipeline : {};
      var _plTotal = (_pl.pendingLabel || 0) + (_pl.labelSent || 0) + (_pl.pieceInTransit || 0) + (_pl.pieceReceived || 0) + (_pl.cloningInProgress || 0) + (_pl.cloningDone || 0) + (_pl.cloningFailed || 0);
    %>
    <% if (_plTotal > 0) { %>
      <div class="mt-8 bg-white rounded-2xl border border-slate-200 p-6">
        <div class="flex items-center gap-2 mb-5">
          <span class="material-symbols-outlined text-lg text-purple-600">science</span>
          <span class="font-semibold text-slate-900">Pipeline Clonage</span>
          <span class="text-xs text-slate-400">(<%= _plTotal %> commande<%= _plTotal > 1 ? 's' : '' %> en cours)</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-<%= _pl.cloningFailed > 0 ? '7' : '6' %> gap-4">
          <a href="/admin/commandes?orderType=exchange_cloning&cloningStatus=pending_label" class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-center hover:bg-amber-100 transition">
            <div class="text-2xl font-bold text-amber-700"><%= _pl.pendingLabel || 0 %></div>
            <div class="mt-1 text-[11px] font-semibold text-amber-600">Étiquette à envoyer</div>
          </a>
          <a href="/admin/commandes?orderType=exchange_cloning&cloningStatus=label_sent" class="rounded-xl border border-orange-200 bg-orange-50 p-4 text-center hover:bg-orange-100 transition">
            <div class="text-2xl font-bold text-orange-700"><%= (_pl.labelSent || 0) + (_pl.pieceInTransit || 0) %></div>
            <div class="mt-1 text-[11px] font-semibold text-orange-600">Pièce en transit</div>
          </a>
          <a href="/admin/commandes?orderType=exchange_cloning&cloningStatus=client_piece_received" class="rounded-xl border border-blue-200 bg-blue-50 p-4 text-center hover:bg-blue-100 transition">
            <div class="text-2xl font-bold text-blue-700"><%= _pl.pieceReceived || 0 %></div>
            <div class="mt-1 text-[11px] font-semibold text-blue-600">Pièce reçue</div>
          </a>
          <a href="/admin/commandes?orderType=exchange_cloning&cloningStatus=cloning_in_progress" class="rounded-xl border border-purple-200 bg-purple-50 p-4 text-center hover:bg-purple-100 transition">
            <div class="text-2xl font-bold text-purple-700"><%= _pl.cloningInProgress || 0 %></div>
            <div class="mt-1 text-[11px] font-semibold text-purple-600">Clonage en cours</div>
          </a>
          <a href="/admin/commandes?orderType=exchange_cloning&cloningStatus=cloning_done" class="rounded-xl border border-green-200 bg-green-50 p-4 text-center hover:bg-green-100 transition">
            <div class="text-2xl font-bold text-green-700"><%= _pl.cloningDone || 0 %></div>
            <div class="mt-1 text-[11px] font-semibold text-green-600">Prêt à expédier</div>
          </a>
          <% if (_pl.cloningFailed > 0) { %>
            <a href="/admin/commandes?orderType=exchange_cloning&cloningStatus=cloning_failed" class="rounded-xl border border-red-300 bg-red-50 p-4 text-center hover:bg-red-100 transition">
              <div class="text-2xl font-bold text-red-700"><%= _pl.cloningFailed %></div>
              <div class="mt-1 text-[11px] font-semibold text-red-600">Échoué<%= _pl.cloningFailed > 1 ? 's' : '' %></div>
            </a>
          <% } %>
        </div>
      </div>
    <% } %>

    <% if (showFinancials) { %>
      <!-- Charts -->
      <%# items-start : le graphique gardait la hauteur de la colonne « Activités » (grand vide blanc). %>
      <div class="mt-8 grid grid-cols-1 xl:grid-cols-3 gap-6 xl:items-start">
        <!-- Weekly Bar Chart -->
        <div class="xl:col-span-2 bg-white rounded-2xl border border-slate-200 p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="font-semibold text-slate-900">Ventes hebdomadaires</div>
            <div class="flex items-center gap-4 text-xs">
              <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-primary inline-block"></span> Cette semaine</span>
              <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-slate-300 inline-block"></span> Semaine précédente</span>
            </div>
          </div>
          <div class="h-64">
            <canvas id="weeklyChart"></canvas>
          </div>
        </div>

        <!-- Activities -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
          <div class="flex items-center justify-between">
            <div class="font-semibold text-slate-900">Activités Récentes</div>
          </div>

          <div class="mt-6 space-y-4">
            <% (activities || []).forEach((a) => { %>
              <%# Ligne cliquable : ouvre la commande (avant : simple texte, il fallait la rechercher). %>
              <a class="flex items-start gap-3 -mx-2 px-2 py-1 rounded-xl hover:bg-slate-50" href="<%= a.id ? '/admin/commandes/' + a.id : '/admin/commandes' %>">
                <div class="w-10 h-10 shrink-0 rounded-full bg-slate-100 flex items-center justify-center">
                  <span class="material-symbols-outlined text-slate-500">shopping_bag</span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2">
                    <div class="font-semibold text-slate-900 whitespace-nowrap"><%= a.number %></div>
                    <div class="flex flex-wrap items-center justify-end gap-1">
                      <% if (a.statusBadge) { %><span class="<%= a.statusBadge.className %>"><%= a.statusBadge.label %></span><% } %>
                      <span class="badge <%= a.accountType === 'pro' ? 'badge-pro' : 'badge-particulier' %>"><%= a.accountType === 'pro' ? 'PRO' : 'PARTICULIER' %></span>
                    </div>
                  </div>
                  <div class="mt-1 text-sm text-slate-500"><%= a.customer %><% if (a.total) { %> · <%= a.total %><% } %></div>
                  <div class="mt-1 text-xs text-slate-400"><%= a.when %></div>
                </div>
              </a>
            <% }) %>

            <% if (!activities || activities.length === 0) { %>
              <div class="text-sm text-slate-500">Aucune activité.</div>
            <% } %>

            <a class="btn btn-secondary btn-block" href="/admin/commandes">
              Voir toutes les activités
            </a>
          </div>
        </div>
      </div>

      <!-- Évolution du C.A. sur la période sélectionnée -->
      <div class="mt-6 bg-white rounded-2xl border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-4 gap-4 flex-wrap">
          <div class="font-semibold text-slate-900">Évolution du C.A. — <%= (typeof period !== 'undefined' && period && period.label) ? period.label : '6 derniers mois' %></div>
          <div class="text-xs font-semibold uppercase tracking-widest text-slate-400"><%= (typeof period !== 'undefined' && period && period.granularity === 'day') ? 'Journalier' : 'Mensuel' %></div>
        </div>
        <% if (typeof periodKpis !== 'undefined' && periodKpis) { %>
          <div class="flex flex-wrap gap-x-10 gap-y-3 mb-5 pb-5 border-b border-slate-100">
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-widest text-slate-400">C.A. encaissé · période</div>
              <div class="text-2xl font-bold text-slate-900"><%= periodKpis.revenue %></div>
            </div>
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-widest text-slate-400">Commandes payées</div>
              <div class="text-2xl font-bold text-slate-900"><%= periodKpis.orders %></div>
            </div>
            <div>
              <div class="text-[11px] font-semibold uppercase tracking-widest text-slate-400">Panier moyen</div>
              <div class="text-2xl font-bold text-slate-900"><%= periodKpis.avgBasket %></div>
            </div>
          </div>
        <% } %>
        <div class="h-64">
          <canvas id="monthlyChart"></canvas>
        </div>
      </div>
    <% } else { %>
      <!-- Activités récentes (vue employé sans graphiques financiers) -->
      <div class="mt-8 bg-white rounded-2xl border border-slate-200 p-6">
        <div class="flex items-center justify-between">
          <div class="font-semibold text-slate-900">Activités Récentes</div>
        </div>

        <div class="mt-6 space-y-4">
          <% (activities || []).forEach((a) => { %>
            <a class="flex items-start gap-3 -mx-2 px-2 py-1 rounded-xl hover:bg-slate-50" href="<%= a.id ? '/admin/commandes/' + a.id : '/admin/commandes' %>">
              <div class="w-10 h-10 shrink-0 rounded-full bg-slate-100 flex items-center justify-center">
                <span class="material-symbols-outlined text-slate-500">shopping_bag</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2">
                  <div class="font-semibold text-slate-900 whitespace-nowrap"><%= a.number %></div>
                  <div class="flex flex-wrap items-center justify-end gap-1">
                    <% if (a.statusBadge) { %><span class="<%= a.statusBadge.className %>"><%= a.statusBadge.label %></span><% } %>
                    <span class="badge <%= a.accountType === 'pro' ? 'badge-pro' : 'badge-particulier' %>"><%= a.accountType === 'pro' ? 'PRO' : 'PARTICULIER' %></span>
                  </div>
                </div>
                <div class="mt-1 text-sm text-slate-500"><%= a.customer %></div>
                <div class="mt-1 text-xs text-slate-400"><%= a.when %></div>
              </div>
            </a>
          <% }) %>

          <% if (!activities || activities.length === 0) { %>
            <div class="text-sm text-slate-500">Aucune activité.</div>
          <% } %>

          <a class="btn btn-secondary btn-block" href="/admin/commandes">
            Voir toutes les activités
          </a>
        </div>
      </div>
    <% } %>

    <%# Bandeau « Maintenance Serveur — dimanche 02:00-04:00 » retiré : texte de modèle jamais
        relié à rien (son bouton « En savoir plus » ne faisait rien), affiché en permanence. %>
  </div>
</main>

<% if (showFinancials) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
  (function () {
    var weeklyData = <%- JSON.stringify(typeof weeklyChart !== 'undefined' ? weeklyChart : { labels: [], values: [], prevValues: [] }) %>;
    var monthlyData = <%- JSON.stringify(typeof monthlyChart !== 'undefined' ? monthlyChart : { labels: [], values: [] }) %>;

    var style = getComputedStyle(document.documentElement);
    var primaryColor = style.getPropertyValue('--color-danger').trim() || '#DC2626';
    var slateColor = style.getPropertyValue('--text-muted').trim() || '#94A3B8';
    var gridColor = style.getPropertyValue('--surface-hover').trim() || '#F1F5F9';
    var tickColor = style.getPropertyValue('--text-muted').trim() || '#94A3B8';

    /* Weekly Bar Chart */
    var weeklyCtx = document.getElementById('weeklyChart');
    if (weeklyCtx) {
      new Chart(weeklyCtx, {
        type: 'bar',
        data: {
          labels: weeklyData.labels,
          datasets: [
            {
              label: 'Cette semaine',
              data: weeklyData.values,
              backgroundColor: primaryColor,
              borderRadius: 6,
              barPercentage: 0.6,
            },
            {
              label: 'Semaine précédente',
              data: weeklyData.prevValues,
              backgroundColor: slateColor,
              borderRadius: 6,
              barPercentage: 0.6,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 800, easing: 'easeOutQuart' },
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function (ctx) { return ctx.dataset.label + ': ' + ctx.parsed.y.toLocaleString('fr-FR') + ' \u20AC'; },
              },
            },
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: { color: gridColor },
              ticks: {
                callback: function (v) { return v.toLocaleString('fr-FR') + ' \u20AC'; },
                font: { size: 11, weight: 'bold' },
                color: tickColor,
              },
            },
            x: {
              grid: { display: false },
              ticks: { font: { size: 11, weight: 'bold' }, color: tickColor },
            },
          },
        },
      });
    }

    /* Monthly Line Chart */
    var monthlyCtx = document.getElementById('monthlyChart');
    if (monthlyCtx) {
      new Chart(monthlyCtx, {
        type: 'line',
        data: {
          labels: monthlyData.labels,
          datasets: [
            {
              label: 'Chiffre d\'affaires',
              data: monthlyData.values,
              borderColor: primaryColor,
              backgroundColor: 'rgba(220, 38, 38, 0.08)',
              fill: true,
              tension: 0.4,
              pointBackgroundColor: primaryColor,
              pointRadius: 5,
              pointHoverRadius: 7,
              borderWidth: 3,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 1000, easing: 'easeOutQuart' },
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function (ctx) { return ctx.parsed.y.toLocaleString('fr-FR') + ' \u20AC'; },
              },
            },
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: { color: gridColor },
              ticks: {
                callback: function (v) { return v.toLocaleString('fr-FR') + ' \u20AC'; },
                font: { size: 11, weight: 'bold' },
                color: tickColor,
              },
            },
            x: {
              grid: { display: false },
              ticks: { font: { size: 11, weight: 'bold' }, color: tickColor },
            },
          },
        },
      });
    }
  })();
</script>
<% } %>

<script>
  (function () {
    function revealPage() {
      var sk = document.getElementById('page-skeleton');
      if (!sk) return;
      sk.classList.add('is-hidden');
      setTimeout(function () { sk.remove(); }, 200);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', revealPage);
    } else {
      revealPage();
    }
  })();
</script>

<%- include('./partials/footer') %>

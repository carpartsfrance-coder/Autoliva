<%
  /* Carte d'un lead — file « À traiter » et onglet « Tous ».
     Ordre voulu : urgence → qui → besoin → où on en est → UN bouton principal.
     Les actions secondaires sont regroupées dans « Autres actions ». */
  var w = c.work || {};
  var ferme = w.stage === 'gagne' || w.stage === 'perdu';
  var bord = ferme ? (w.stage === 'gagne' ? 'border-l-green-500' : 'border-l-slate-300')
    : w.overdue ? 'border-l-red-500'
    : w.stage === 'nouveau' ? 'border-l-blue-500'
    : (w.group === 'rappels' || w.group === 'devis') ? 'border-l-amber-400' : 'border-l-slate-300';
  var pillUrgence = w.overdue ? 'bg-red-600 text-white'
    : w.stage === 'nouveau' ? 'bg-blue-600 text-white'
    : (w.group === 'rappels' || w.group === 'devis') ? 'bg-amber-100 text-amber-900' : 'bg-slate-100 text-slate-700';
  var estAds = c.attribution && (c.attribution.gclid || ['cpc', 'ppc', 'paid'].indexOf(String(c.attribution.medium || '').toLowerCase()) !== -1);
  var nom = c.fullName || c.email || c.phone || 'Client sans nom';
  var besoin = c.showRequestAsPrimary ? (c.requestSummary || '') : (c.itemCount > 0 ? c.itemsSummary : (c.requestSummary || ''));
%>
<li class="lead-row bg-white rounded-xl border border-slate-200 border-l-4 <%= bord %> p-4 shadow-sm hover:shadow transition" data-lead-id="<%= c.id %>">
  <div class="flex flex-col md:flex-row md:items-start gap-3 md:gap-5">

    <div class="flex-1 min-w-0">
      <!-- 1. Urgence · étape · source -->
      <div class="flex flex-wrap items-center gap-1.5">
        <% if (c.urgence && !ferme) { %>
          <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-bold <%= pillUrgence %>">
            <span class="material-symbols-outlined text-[14px]"><%= w.overdue ? 'alarm' : (w.stage === 'nouveau' ? 'bolt' : 'schedule') %></span><%= c.urgence %>
          </span>
        <% } %>
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold <%= w.stageClass %>"><%= w.stageLabel %></span>
        <% if (estAds) { %>
          <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold bg-green-100 text-green-800" title="Demande venue d'une annonce Google Ads (payée)">Google Ads</span>
        <% } %>
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium <%= c.captureBadge.className %>"><%= c.captureBadge.label %></span>
        <% if (c.engineQuoteUrl) { %>
          <a href="<%= c.engineQuoteUrl %>" class="inline-flex items-center gap-0.5 text-[11px] font-semibold text-slate-500 hover:text-primary" title="Ouvrir le dossier devis"><span class="material-symbols-outlined text-[13px]">description</span><%= c.engineRef || 'Dossier devis' %></a>
        <% } %>
        <% if (c.totalAmountCents > 0) { %>
          <span class="ml-auto text-sm font-bold text-slate-900 whitespace-nowrap"><%= c.totalAmount %></span>
        <% } %>
      </div>

      <!-- 2. Qui -->
      <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="text-base font-semibold text-slate-900 break-all"><%= nom %></span>
        <% if (c.phone) { %>
          <button type="button" data-copy-phone="<%= c.phone %>" class="inline-flex items-center gap-1 text-sm font-semibold text-slate-800 hover:text-primary" title="Copier le numéro">
            <span class="material-symbols-outlined text-[16px] text-emerald-600">call</span><%= c.phone %><% if (!c.phoneCallable) { %><span class="text-xs font-normal text-amber-600"> (format ?)</span><% } %>
          </button>
        <% } %>
        <% if (c.email && c.email !== nom) { %>
          <span class="text-sm text-slate-500 truncate max-w-full md:max-w-[280px]" title="<%= c.email %>"><%= c.email %></span>
        <% } %>
      </div>

      <!-- 3. Besoin -->
      <% if (besoin || (c.requested && c.requested.message)) { %>
        <div class="mt-1.5 text-sm text-slate-700">
          <% if (besoin) { %><span class="font-medium"><%= besoin %></span><% } %>
          <% if (c.requested && c.requested.message) { %>
            <div class="text-xs text-slate-500 italic line-clamp-2" title="<%= c.requested.message %>">« <%= c.requested.message.slice(0, 220) %><%= c.requested.message.length > 220 ? '…' : '' %> »</div>
          <% } %>
        </div>
      <% } %>

      <!-- 4. Où on en est -->
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
        <% if (c.takenByName) { %>
          <span class="inline-flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">person</span>Pris par <strong class="text-slate-700"><%= c.takenByName %></strong><%= c.takenAtRel ? ' · ' + c.takenAtRel : '' %></span>
        <% } else if (!ferme) { %>
          <button type="button" class="js-prendre inline-flex items-center gap-1 rounded-full border border-dashed border-slate-300 px-2 py-0.5 font-semibold text-slate-600 hover:border-primary hover:text-primary" data-lead-id="<%= c.id %>" title="Je m'occupe de ce client">
            <span class="material-symbols-outlined text-[14px]">pan_tool</span>Non pris — je m'en occupe
          </button>
        <% } %>
        <% if (c.lastCallOutcome) { %>
          <span>Dernier appel : <strong class="text-slate-700"><%= c.lastCallOutcome.label %></strong><%= c.lastCallOutcome.by ? ' (' + c.lastCallOutcome.by + (c.lastCallOutcome.atRel ? ', ' + c.lastCallOutcome.atRel : '') + ')' : '' %></span>
        <% } else if (!w.firstHumanAt && !ferme) { %>
          <span class="font-semibold text-red-600">Jamais contacté</span>
        <% } else if (c.lastManualContactRel) { %>
          <span>Dernier contact <%= c.lastManualContactRel %><%= c.manualStatusByName ? ' (' + c.manualStatusByName + ')' : '' %></span>
        <% } %>
        <% if (!ferme && w.nextActionLabel) { %>
          <span class="inline-flex items-center gap-1 text-slate-600"><span class="material-symbols-outlined text-[14px]">arrow_forward</span><strong><%= w.nextActionLabel %></strong><%= c.nextActionNote ? ' — ' + c.nextActionNote.slice(0, 90) : '' %></span>
        <% } %>
        <% if (w.stage === 'perdu' && c.lostReasonLabel) { %><span>Motif : <strong><%= c.lostReasonLabel %></strong></span><% } %>
        <span title="<%= c.lastActivityAbsolute %>">Reçu <%= c.receivedRel %></span>
      </div>

      <!-- 5. Contexte client (seulement s'il existe) -->
      <% if (c.recoveredOrderBadge || c.clientHistory || c.savHistory || c.lastNote) { %>
        <div class="mt-2 flex flex-wrap items-center gap-1.5 text-[11.5px]">
          <% if (c.recoveredOrderBadge) { %>
            <a href="<%= c.recoveredOrderBadge.url %>" class="inline-flex items-center gap-1 rounded-md border border-green-300 bg-green-50 px-1.5 py-0.5 font-semibold text-green-800 hover:bg-green-100"><span class="material-symbols-outlined text-[13px]">shopping_bag</span>A commandé<%= c.recoveredOrderBadge.number ? ' n°' + c.recoveredOrderBadge.number : '' %></a>
          <% } %>
          <% if (c.clientHistory) { %>
            <a href="<%= c.clientHistory.lastUrl %>" title="<%= c.clientHistory.title %>" class="inline-flex items-center gap-1 rounded-md border border-indigo-200 bg-indigo-50 px-1.5 py-0.5 font-semibold text-indigo-800 hover:bg-indigo-100"><span class="material-symbols-outlined text-[13px]">loyalty</span>Déjà client · <%= c.clientHistory.count %> cde</a>
          <% } %>
          <% if (c.savHistory) { %>
            <a href="<%= c.savHistory.url %>" title="<%= c.savHistory.title %>" class="inline-flex items-center gap-1 rounded-md border px-1.5 py-0.5 font-semibold <%= c.savHistory.openCount ? 'border-amber-300 bg-amber-50 text-amber-800' : 'border-slate-200 bg-slate-50 text-slate-600' %>"><span class="material-symbols-outlined text-[13px]">build_circle</span><%= c.savHistory.openCount ? 'SAV en cours' : 'SAV clos' %></a>
          <% } %>
          <% if (c.lastNote) { %>
            <span class="inline-flex items-center gap-1 text-slate-500 min-w-0"><span class="material-symbols-outlined text-[13px] text-slate-400">sticky_note_2</span><span class="truncate max-w-[300px] md:max-w-[420px]" title="<%= c.lastNote.text %>"><%= c.lastNote.text %> — <%= c.lastNote.by %></span></span>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Actions : UN bouton principal + secondaires -->
    <div class="flex flex-col gap-2 md:w-60 shrink-0">
      <% var pa = w.primaryAction; var pl = w.primaryLabel; %>
      <% if (pa === 'call' && c.phone) { %>
        <a href="tel:<%= c.phone %>" class="js-appeler inline-flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3 py-2.5 text-sm font-bold text-white shadow-sm" data-lead-id="<%= c.id %>" data-phone="<%= c.phone %>" data-name="<%= nom %>">
          <span class="material-symbols-outlined text-[18px]">call</span><%= pl %>
        </a>
      <% } else if (pa === 'email' && c.email) { %>
        <button type="button" class="lead-action inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary hover:opacity-90 px-3 py-2.5 text-sm font-bold text-white shadow-sm" data-action="email" data-lead-id="<%= c.id %>" data-lead-email="<%= c.email %>" data-lead-name="<%= c.fullName %>">
          <span class="material-symbols-outlined text-[18px]">mail</span><%= pl %>
        </button>
      <% } else if (pa === 'workshop') { %>
        <a href="/admin/devis-moteurs/<%= c.id %>" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-orange-600 hover:bg-orange-700 px-3 py-2.5 text-sm font-bold text-white shadow-sm">
          <span class="material-symbols-outlined text-[18px]">request_quote</span><%= pl %>
        </a>
      <% } else if (pa === 'plan') { %>
        <button type="button" class="js-planifier inline-flex w-full items-center justify-center gap-2 rounded-lg bg-slate-900 hover:bg-slate-800 px-3 py-2.5 text-sm font-bold text-white shadow-sm" data-lead-id="<%= c.id %>">
          <span class="material-symbols-outlined text-[18px]">event</span><%= pl %>
        </button>
      <% } else { %>
        <button type="button" class="lead-detail-btn inline-flex w-full items-center justify-center gap-2 rounded-lg <%= ferme ? 'border border-slate-200 bg-white text-slate-700 hover:bg-slate-50' : 'bg-slate-900 hover:bg-slate-800 text-white' %> px-3 py-2.5 text-sm font-bold shadow-sm" data-lead-id="<%= c.id %>">
          <span class="material-symbols-outlined text-[18px]">visibility</span><%= pl || 'Voir le dossier' %>
        </button>
      <% } %>

      <div class="flex gap-1.5">
        <% if (!ferme && c.phone) { %>
          <button type="button" class="js-resultat flex-1 min-w-0 inline-flex items-center justify-center gap-1 whitespace-nowrap rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-2 py-1.5 text-xs font-semibold text-slate-700" data-lead-id="<%= c.id %>" data-name="<%= nom %>" title="Noter le résultat d'un appel">
            <span class="material-symbols-outlined text-[15px]">call</span>J'ai appelé
          </button>
        <% } %>
        <% if (!ferme) { %>
          <button type="button" class="js-planifier flex-1 min-w-0 inline-flex items-center justify-center gap-1 whitespace-nowrap rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-2 py-1.5 text-xs font-semibold text-slate-700" data-lead-id="<%= c.id %>" title="Prévoir la prochaine action et sa date">
            <span class="material-symbols-outlined text-[15px]">event</span>Planifier
          </button>
        <% } %>
        <details class="lead-menu relative <%= ferme ? 'flex-1' : 'shrink-0' %>">
          <summary class="list-none cursor-pointer inline-flex w-full items-center justify-center gap-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 px-2 py-1.5 text-xs font-semibold text-slate-700" title="Email, SMS, WhatsApp, notes, gagné, perdu…">
            <span class="material-symbols-outlined text-[16px]">more_horiz</span><% if (ferme) { %>Autres actions<% } %>
          </summary>
          <div class="absolute right-0 z-30 mt-1 w-64 rounded-xl border border-slate-200 bg-white p-1 shadow-xl text-sm">
            <% if (c.email) { %>
              <button type="button" class="lead-action w-full text-left rounded-lg px-3 py-2 hover:bg-slate-50 flex items-center gap-2" data-action="email" data-lead-id="<%= c.id %>" data-lead-email="<%= c.email %>" data-lead-name="<%= c.fullName %>"><span class="material-symbols-outlined text-[17px] text-slate-400">mail</span>Écrire un email</button>
            <% } %>
            <% if (c.phone && c.phoneCallable) { %>
              <button type="button" class="lead-action w-full text-left rounded-lg px-3 py-2 hover:bg-slate-50 flex items-center gap-2" data-action="sms" data-lead-id="<%= c.id %>" data-lead-phone="<%= c.phone %>" data-lead-name="<%= c.fullName %>"><span class="material-symbols-outlined text-[17px] text-slate-400">sms</span>Envoyer un SMS</button>
              <button type="button" class="lead-action w-full text-left rounded-lg px-3 py-2 hover:bg-slate-50 flex items-center gap-2" data-action="sms" data-sms-template="sms_tried_to_call" data-lead-id="<%= c.id %>" data-lead-phone="<%= c.phone %>" data-lead-name="<%= c.fullName %>"><span class="material-symbols-outlined text-[17px] text-slate-400">sms</span>SMS « J'ai essayé de vous joindre »</button>
              <button type="button" class="lead-action w-full text-left rounded-lg px-3 py-2 hover:bg-slate-50 flex items-center gap-2" data-action="sms" data-sms-template="sms_compat_ok" data-lead-id="<%= c.id %>" data-lead-phone="<%= c.phone %>" data-lead-name="<%= c.fullName %>"><span class="material-symbols-outlined text-[17px] text-slate-400">check_circle</span>SMS « Compatibilité vérifiée »</button>
              <button type="button" class="lead-action w-full text-left rounded-lg px-3 py-2 hover:bg-slate-50 flex items-center gap-2" data-action="whatsapp" data-lead-id="<%= c.id %>" data-lead-phone="<%= c.phone %>" data-lead-name="<%= c.fullName %>"><span class="material-symbols-outlined text-[17px] text-slate-400">chat</span>WhatsApp</button>
            <% } %>
            <% if (c.canRemind) { %>
              <button type="button" class="lead-remind-btn w-full text-left rounded-lg px-3 py-2 hover:bg-slate-50 flex items-center gap-2" data-lead-id="<%= c.id %>" data-next="<%= c.nextReminderNumber %>"><span class="material-symbols-outlined text-[17px] text-slate-400">forward_to_inbox</span>Envoyer la relance panier n°<%= c.nextReminderNumber %></button>
            <% } %>
            <% if (w.hasWorkshop) { %>
              <a href="/admin/devis-moteurs/<%= c.id %>" class="w-full text-left rounded-lg px-3 py-2 hover:bg-slate-50 flex items-center gap-2"><span class="material-symbols-outlined text-[17px] text-slate-400">request_quote</span>Ouvrir le dossier devis</a>
            <% } %>
            <button type="button" class="lead-detail-btn w-full text-left rounded-lg px-3 py-2 hover:bg-slate-50 flex items-center gap-2" data-lead-id="<%= c.id %>"><span class="material-symbols-outlined text-[17px] text-slate-400">visibility</span>Détail, historique &amp; notes</button>
            <% if (c.sessionId) { %>
              <a href="/admin/visiteurs/<%= c.sessionId %>" class="w-full text-left rounded-lg px-3 py-2 hover:bg-slate-50 flex items-center gap-2"><span class="material-symbols-outlined text-[17px] text-slate-400">route</span>Parcours sur le site</a>
            <% } %>
            <div class="my-1 border-t border-slate-100"></div>
            <% if (!ferme) { %>
              <button type="button" class="js-cloturer w-full text-left rounded-lg px-3 py-2 hover:bg-green-50 text-green-800 flex items-center gap-2" data-lead-id="<%= c.id %>" data-issue="gagne"><span class="material-symbols-outlined text-[17px]">verified</span>Gagné (le client a payé)</button>
              <button type="button" class="js-cloturer w-full text-left rounded-lg px-3 py-2 hover:bg-slate-100 text-slate-700 flex items-center gap-2" data-lead-id="<%= c.id %>" data-issue="perdu"><span class="material-symbols-outlined text-[17px]">block</span>Perdu…</button>
            <% } else { %>
              <button type="button" class="js-cloturer w-full text-left rounded-lg px-3 py-2 hover:bg-slate-50 text-slate-700 flex items-center gap-2" data-lead-id="<%= c.id %>" data-issue="rouvrir"><span class="material-symbols-outlined text-[17px]">undo</span>Rouvrir le dossier</button>
            <% } %>
          </div>
        </details>
      </div>
    </div>
  </div>
</li>

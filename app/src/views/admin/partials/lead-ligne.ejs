<%
  /* Ligne de la liste de gauche : QUI, QUAND c'est arrivé, QUOI, COMBIEN,
     d'où ça vient et qui s'en occupe. Un clic ouvre la fiche à droite (sur
     téléphone : en plein écran).

     Refaite le 20/11/2026, dans le style de la fiche : un point de couleur au
     lieu de la barre, l'heure d'arrivée en haut à droite (là où étaient les
     comptes à rebours), trois lignes calmes. « attend 1 h 04 », qui tournait
     sur chaque ligne, est parti avec : l'heure d'arrivée dit la même chose,
     et c'est ce que le patron avait demandé en premier. */
  var w = c.work || {};
  var ferme = w.stage === 'gagne' || w.stage === 'perdu';
  /* Simple passage (panier, newsletter) jamais travaillé : pas une demande, donc ni échéance ni retard. */
  var faible = w.intent === 'weak' || w.intent === 'archived';
  /* Le rouge est réservé aux heures qu'un humain a promises (et à la première
     réponse due dans l'heure). Une relance que la file déduit passe en ambre. */
  var ton = faible ? 'slate' : ferme ? (w.stage === 'gagne' ? 'green' : 'slate')
    : (w.overdue && w.promesse) ? 'red'
    : w.stage === 'nouveau' ? 'blue'
    : (w.overdue || w.group === 'rappels' || w.group === 'devis' || w.group === 'relances') ? 'amber' : 'slate';
  var point = { red: 'bg-red-500', blue: 'bg-blue-500', amber: 'bg-amber-400', green: 'bg-green-500', slate: 'bg-slate-300' }[ton];
  var nom = c.fullName || c.email || c.telAffiche || c.phone || 'Client sans nom';
  var d = c.demande || {};
  /* Pour un appel manqué, la « pièce » n'est que le début du SMS du client :
     on l'affiche comme une citation, pas comme une pièce. */
  var quoi = d.pieceDuSms
    ? '« ' + d.piece + (d.piece.length >= 90 ? '…' : '') + ' »'
    : [d.piece, d.vehicule || d.plaque].filter(Boolean).join(' · ');
  var estAds = c.attribution && (c.attribution.gclid || ['cpc', 'ppc', 'paid'].indexOf(String(c.attribution.medium || '').toLowerCase()) !== -1);

  /* En haut à droite : l'heure d'arrivée. Seule exception, la date d'un
     rendez-vous fixé un autre jour : dans « Planifiés », c'est elle qu'on
     vient chercher — sauf quand l'onglet est trié par date de la demande :
     le coin montre alors la date qui fait l'ordre. */
  var rdv = w.group === 'plus_tard' && !ferme && !faible && !locals.triDate && !!c.urgenceCourte;
  var coin = rdv ? c.urgenceCourte : c.recuCourt;
  var coinTitre = rdv ? 'Rendez-vous prévu'
    : (c.recuExact ? (faible ? 'Dernière visite le ' : 'Demande reçue le ') + c.recuExact : '');

  var meta = [];
  if (ferme) meta.push(w.stageLabel);
  if (estAds) meta.push('Google Ads');
  if (c.captureBadge && c.captureBadge.label) meta.push(c.captureBadge.label);
  if (c.takenByName) meta.push(c.takenByName);
  else if (!ferme && !faible) meta.push('non attribuée');
  /* « Je l'ai déjà contacté » : sans ça, un dossier appelé trois fois
     ressemblait mot pour mot à une demande fraîche. */
  var suivi = (c.suivi && !ferme && !faible)
    ? 'contacté' + (c.suivi.nombre > 1 ? ' ' + c.suivi.nombre + '×' : '') + (c.suivi.sansNouvellesCourt ? ' · ' + c.suivi.sansNouvellesCourt : '')
    : '';

  /* Pastilles : seulement ce qui change la façon d'aborder le client. Un
     seul signal de devis, le plus avancé. */
  var pastilles = [];
  var ds = c.devisSuivi;
  if (ds && ds.paiementClique) pastilles.push(['A cliqué payer', 'bg-green-50 text-green-800', 'Le client a cliqué sur « payer » dans le devis : à rappeler tout de suite.']);
  else if (ds && ds.pdfVu) pastilles.push(['Devis vu', 'bg-slate-100 text-slate-700', 'Le client a ouvert le PDF du devis.']);
  else if (ds && ds.ouvert) pastilles.push(['Devis ouvert', 'bg-slate-100 text-slate-700', 'Le client a ouvert l’email du devis, sans aller voir le PDF.']);
  if (c.clientHistory) pastilles.push(['Déjà client', 'bg-slate-100 text-slate-700', c.clientHistory.count + ' commande' + (c.clientHistory.count > 1 ? 's' : '') + ' · ' + c.clientHistory.title]);
  if (c.savHistory && c.savHistory.openCount) pastilles.push(['SAV en cours', 'bg-amber-50 text-amber-800', c.savHistory.title]);
%>
<li>
  <button type="button" class="lead-ligne relative w-full border-b border-slate-100 px-3.5 py-2.5 text-left hover:bg-slate-50 focus:outline-none focus-visible:bg-slate-50"
          data-lead-id="<%= c.id %>" aria-selected="false"
          data-due="<%= c.dueIso || '' %>" data-retard="<%= c.retardMin || 0 %>" data-attente="<%= c.attenteMin >= 0 ? c.attenteMin : -1 %>"
          data-promesse="<%= w.promesse ? 1 : 0 %>">
    <%/* Case de sélection : visible seulement en mode « Sélectionner ».
          Placement dans la feuille de style de la page. */%>
    <span class="lead-case" aria-hidden="true">
      <span class="material-symbols-outlined text-[20px]">check_box_outline_blank</span>
    </span>
    <span class="flex items-baseline gap-2">
      <%/* Le point porte l'urgence ; l'horloge de la page le recolore quand
            une heure passe (data-role="barre", nom historique). */%>
      <span class="h-2 w-2 shrink-0 -translate-y-px rounded-full <%= point %>" data-role="barre" aria-hidden="true"></span>
      <span class="lead-ligne-nom min-w-0 flex-1 truncate text-sm font-medium text-slate-900"><%= nom %></span>
      <% if (coin) { %><span class="shrink-0 text-xs text-slate-400" title="<%= coinTitre %>"><%= coin %></span><% } %>
    </span>
    <% if (quoi || c.prixAffiche) { %>
      <span class="ml-4 mt-0.5 flex items-baseline gap-2 text-xs text-slate-500">
        <span class="min-w-0 flex-1 truncate"><%= quoi %></span>
        <% if (c.prixAffiche) { %>
          <span class="shrink-0 text-slate-700" title="<%= c.prixAffiche.origine === 'devis' ? 'Prix du devis envoyé' : 'Montant du panier' %>"><%= c.prixAffiche.montant %></span>
        <% } %>
      </span>
    <% } %>
    <span class="ml-4 mt-1 flex items-center gap-1.5 text-[11px] text-slate-400">
      <% pastilles.forEach(function (p) { %>
        <span class="shrink-0 rounded-full px-1.5 py-px <%= p[1] %>" title="<%= p[2] || '' %>"><%= p[0] %></span>
      <% }) %>
      <span class="min-w-0 truncate"><%= meta.join(' · ') %><% if (suivi) { %> · <span title="Dernier geste de notre côté<%= c.suivi.dernierExact ? ' le ' + c.suivi.dernierExact : '' %><%= c.suivi.sansNouvelles ? ' — le client est sans nouvelles depuis ' + c.suivi.sansNouvelles : '' %>." data-role="suivi"><%= suivi %></span><% } %></span>
      <% if (c.lastNote && c.lastNote.text) { %>
        <%/* Pas de compteur : la file ne charge que les 6 dernières notes. */%>
        <span class="material-symbols-outlined ml-auto shrink-0 text-[14px] text-slate-400"
              title="Dernière note (<%= c.lastNote.by %><%= c.lastNote.atRel ? ', ' + c.lastNote.atRel : '' %>) : <%= c.lastNote.text %><%= c.lastNote.tronque ? '…' : '' %>">sticky_note_2</span>
      <% } %>
    </span>
  </button>
</li>

<%- include('./partials/head') %>

<%- include('./partials/sidebar', { active: 'orders' }) %>

<%
  /* Liste des commandes — conçue pour TRAITER une série de commandes, pas pour
     en chercher une : files de traitement, une action suivante par commande,
     annulation pendant 6 secondes, raccourcis clavier. Maquette :
     design_handoff_admin_commandes (16/09/2026). La logique vit dans
     src/services/commandesFiles.js, le comportement dans
     public/js/admin-commandes.js. */
  const _view = typeof view !== 'undefined' ? view : 'active';
  const _filters = typeof filters !== 'undefined' && filters ? filters : {};
  const isDraftView = _filters.status === 'draft' && _view === 'active';
  const isArchivedView = _view === 'archived';
  const isTrashView = _view === 'trash';
  const isActiveView = _view === 'active' && !isDraftView;
  const _vueLigne = isTrashView ? 'trash' : isArchivedView ? 'archived' : isDraftView ? 'draft' : 'active';
  const _vueFiles = typeof vueFiles !== 'undefined' && vueFiles;
  const _fileActive = typeof fileActive !== 'undefined' ? fileActive : 'all';
  const _files = typeof filesCommandes !== 'undefined' ? filesCommandes : [];
  const _fileInfo = _files.find(function (f) { return f.id === _fileActive; }) || null;
  const _enFile = _vueFiles && _fileActive !== 'all';
  const _autres = typeof autresSuivis !== 'undefined' ? autresSuivis : [];
  const _draftsCount = typeof draftsCount !== 'undefined' ? draftsCount : 0;
  const _archivedCount = typeof archivedCount !== 'undefined' ? archivedCount : 0;
  const _trashCount = typeof trashCount !== 'undefined' ? trashCount : 0;
  const _pagination = typeof pagination !== 'undefined' && pagination ? pagination : { totalItems: 0, totalPages: 1, page: 1 };
  const _avances = ['type', 'source', 'utmCampaign', 'utmSource', 'returnFilter', 'status', 'orderType', 'cloningStatus', 'sourcing', 'period', 'product', 'category'];
  const _nbFiltres = _avances.filter(function (k) { return _filters[k]; }).length;

  /* Adresse courante (retour après restaurer/désarchiver). */
  const _qp = [];
  if (isArchivedView) _qp.push('view=archived');
  if (isTrashView) _qp.push('view=trash');
  ['q', 'status', 'type', 'orderType', 'cloningStatus', 'returnFilter', 'source', 'period', 'product', 'category', 'sourcing', 'utmCampaign', 'utmSource'].forEach(function (k) {
    if (_filters[k]) _qp.push(k + '=' + encodeURIComponent(_filters[k]));
  });
  if (_vueFiles) _qp.push('file=' + encodeURIComponent(_fileActive));
  if (_pagination.page > 1) _qp.push('page=' + _pagination.page);
  const _returnTo = '/admin/commandes' + (_qp.length ? '?' + _qp.join('&') : '');

  let _sousTitre = 'Gérez et suivez les commandes clients.';
  if (_vueFiles && typeof resumeFiles !== 'undefined' && resumeFiles) _sousTitre = resumeFiles;
  if (isDraftView) _sousTitre = 'Commandes en cours de saisie, pas encore validées.';
  if (isArchivedView) _sousTitre = 'Masquées de la liste principale et exclues des statistiques. Réversible.';
  if (isTrashView) _sousTitre = 'Restaurables pendant 30 jours.';

  const _titreTableau = isDraftView ? 'Brouillons' : isArchivedView ? 'Commandes archivées' : isTrashView ? 'Corbeille'
    : (_fileInfo && _fileActive !== 'all' ? _fileInfo.label : (_filters.q ? 'Résultats pour « ' + _filters.q + ' »' : 'Toutes les commandes'));
  const _nbLignes = _enFile ? (orders || []).length : _pagination.totalItems;
%>

<link rel="stylesheet" href="/admin/commandes.css?v=<%= (typeof assetVersions !== 'undefined' && assetVersions.adminCommandesCss) || '' %>" />

<main class="flex-1 relative cmd-page" data-file-active="<%= _fileActive %>" data-vue="<%= _vueLigne %>">
  <%- include('./partials/skeleton-table') %>
  <div class="cmd-conteneur">

    <div class="cmd-entete">
      <div>
        <%- include('./partials/breadcrumb', { breadcrumbs: [{ label: 'Commandes' }] }) %>
        <h1 class="cmd-titre">Commandes</h1>
        <p class="cmd-sous-titre" data-resume><%= _sousTitre %></p>
      </div>
      <div class="cmd-entete-actions">
        <form action="/admin/commandes/sync-suivi" method="POST" data-confirmer="Synchroniser les statuts d'expédition depuis Jumingo maintenant ?">
          <button type="submit" class="cmd-bouton" title="Met à jour les statuts depuis le suivi Jumingo : « Étiquette créée » → « Expédiée » au scan transporteur.">
            <span class="ms" aria-hidden="true">sync</span>Synchroniser les suivis
          </button>
        </form>
        <a href="/admin/commandes/nouvelle" class="cmd-bouton is-primaire">
          <span class="ms" aria-hidden="true">add</span>Nouvelle commande
        </a>
      </div>
    </div>

    <% if (_vueFiles) { %>
      <nav class="cmd-files" aria-label="Files de traitement">
        <% _files.forEach(function (f) { %>
          <a class="cmd-file<%= f.id === _fileActive ? ' is-active' : '' %>" href="/admin/commandes?file=<%= f.id %>" data-file="<%= f.id %>"<%= f.id === _fileActive ? ' aria-current="page"' : '' %>>
            <span class="ms" aria-hidden="true"><%= f.icon %></span><%= f.label %>
            <span class="cmd-file-n" data-file-total><%= f.total %></span>
            <span class="cmd-file-r" data-file-retard<%= f.enRetard > 0 ? '' : ' hidden' %>><span class="ms" aria-hidden="true">error</span><span data-file-retard-n><%= f.enRetard %></span> en retard</span>
          </a>
        <% }) %>
      </nav>
      <% if (_autres.length) { %>
        <div class="cmd-autres">
          <span class="cmd-autres-titre">Autres suivis</span>
          <% _autres.forEach(function (a) { %>
            <a class="cmd-autre is-<%= a.ton %>" href="<%= a.href %>"><span class="ms" aria-hidden="true"><%= a.icon %></span><%= a.texte %></a>
          <% }) %>
        </div>
      <% } %>
    <% } %>

    <form id="cmdRecherche" class="cmd-recherche" action="/admin/commandes" method="GET" role="search">
      <% if (isArchivedView || isTrashView) { %><input type="hidden" name="view" value="<%= _view %>" /><% } %>
      <% if (isDraftView) { %><input type="hidden" name="status" value="draft" /><% } %>
      <% if (_vueFiles) { %><input type="hidden" name="file" value="all" /><% } %>
      <div class="cmd-recherche-l">
        <label class="cmd-recherche-champ">
          <span class="ms" aria-hidden="true">search</span>
          <span class="sr-only">Rechercher une commande</span>
          <input id="cmdRechercheInput" type="search" name="q" value="<%= _filters.q || '' %>" autocomplete="off"
            placeholder="Rechercher : n° commande, client, réf OE, n° de suivi…" />
          <kbd class="cmd-kbd" aria-hidden="true">/</kbd>
        </label>
        <button type="button" class="cmd-bouton" id="cmdFiltresToggle" aria-expanded="<%= _nbFiltres ? 'true' : 'false' %>" aria-controls="cmdFiltres">
          <span class="ms" aria-hidden="true">tune</span>Filtres avancés<% if (_nbFiltres) { %><span class="cmd-pastille"><%= _nbFiltres %></span><% } %>
        </button>
        <% if (_nbFiltres || _filters.q) { %>
          <a class="cmd-lien-discret" href="/admin/commandes<%= isArchivedView ? '?view=archived' : isTrashView ? '?view=trash' : isDraftView ? '?status=draft' : '' %>"><span class="ms" aria-hidden="true">restart_alt</span>Réinitialiser</a>
        <% } %>
      </div>
      <p class="cmd-recherche-aide" id="cmdRechercheAide" hidden></p>

      <div id="cmdFiltres" class="cmd-filtres"<%= _nbFiltres ? '' : ' hidden' %>>
        <select name="status" aria-label="Statut">
          <option value="">Tous les statuts</option>
          <% [['pending_payment', 'En attente paiement'], ['paid', 'Payée'], ['processing', 'En préparation'], ['label_created', 'Étiquette créée'], ['shipped', 'Expédiée'], ['delivered', 'Livrée'], ['completed', 'Terminée'], ['cancelled', 'Annulée'], ['refunded', 'Remboursée']].forEach(function (s) { %>
            <option value="<%= s[0] %>"<%= _filters.status === s[0] ? ' selected' : '' %>><%= s[1] %></option>
          <% }) %>
        </select>
        <select name="orderType" aria-label="Type de commande">
          <option value="">Type de commande</option>
          <% [['standard', 'Vente simple'], ['exchange', 'Échange standard'], ['exchange_cloning', 'Échange + Clonage'], ['standalone_cloning', 'Service Clonage TCU']].forEach(function (s) { %>
            <option value="<%= s[0] %>"<%= _filters.orderType === s[0] ? ' selected' : '' %>><%= s[1] %></option>
          <% }) %>
        </select>
        <select name="cloningStatus" aria-label="Statut clonage">
          <option value="">Statut clonage</option>
          <% [['pending_label', 'Attente étiquette'], ['label_sent', 'Étiquette envoyée'], ['client_piece_in_transit', 'Pièce en transit'], ['client_piece_received', 'Pièce reçue'], ['cloning_in_progress', 'Clonage en cours'], ['cloning_done', 'Clonage terminé'], ['cloning_failed', 'Clonage échoué']].forEach(function (s) { %>
            <option value="<%= s[0] %>"<%= _filters.cloningStatus === s[0] ? ' selected' : '' %>><%= s[1] %></option>
          <% }) %>
        </select>
        <select name="sourcing" aria-label="Appro pièce">
          <option value="">Appro pièce</option>
          <% [['a_verifier', 'À vérifier'], ['a_commander', 'À commander'], ['commandee', 'Commandée (fournisseur)'], ['overdue', 'Commandée — en retard'], ['en_stock', 'En stock / reçue']].forEach(function (s) { %>
            <option value="<%= s[0] %>"<%= _filters.sourcing === s[0] ? ' selected' : '' %>><%= s[1] %></option>
          <% }) %>
        </select>
        <select name="category" aria-label="Catégorie de produit">
          <option value="">Toutes les catégories</option>
          <% (typeof productCategories !== 'undefined' ? productCategories : []).forEach(function (c) { %>
            <option value="<%= c %>"<%= _filters.category === c ? ' selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
        <select name="type" aria-label="Type de client">
          <option value="">Tous les clients</option>
          <option value="particulier"<%= _filters.type === 'particulier' ? ' selected' : '' %>>Particulier</option>
          <option value="pro"<%= _filters.type === 'pro' ? ' selected' : '' %>>Professionnel</option>
        </select>
        <select name="period" aria-label="Période">
          <option value="">Toutes périodes</option>
          <% [['7d', '7 derniers jours'], ['30d', '30 derniers jours'], ['90d', '90 derniers jours'], ['365d', '12 derniers mois']].forEach(function (s) { %>
            <option value="<%= s[0] %>"<%= _filters.period === s[0] ? ' selected' : '' %>><%= s[1] %></option>
          <% }) %>
        </select>
        <select name="source" aria-label="Source">
          <option value="">Toutes les sources</option>
          <% [['website', 'Site web'], ['phone', 'Téléphone'], ['email', 'Email'], ['whatsapp', 'WhatsApp'], ['leboncoin', 'Leboncoin'], ['marketplace', 'Marketplace'], ['salon', 'Salon'], ['other', 'Autre']].forEach(function (s) { %>
            <option value="<%= s[0] %>"<%= _filters.source === s[0] ? ' selected' : '' %>><%= s[1] %></option>
          <% }) %>
        </select>
        <select name="returnFilter" aria-label="Retour">
          <option value="">Retour (tous)</option>
          <option value="pending"<%= _filters.returnFilter === 'pending' ? ' selected' : '' %>>Retour attendu</option>
          <option value="overdue"<%= _filters.returnFilter === 'overdue' ? ' selected' : '' %>>Retour en retard</option>
        </select>
        <select name="utmSource" aria-label="Origine publicitaire">
          <option value="">Toute origine pub</option>
          <% ['google', 'facebook', 'instagram', 'bing', 'newsletter'].forEach(function (s) { %>
            <option value="<%= s %>"<%= _filters.utmSource === s ? ' selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
          <% }) %>
        </select>
        <input type="text" name="product" value="<%= _filters.product || '' %>" placeholder="Nom de produit…" aria-label="Nom de produit" />
        <input type="text" name="utmCampaign" value="<%= _filters.utmCampaign || '' %>" placeholder="Campagne (utm_campaign)" aria-label="Campagne" />
        <% if (!_enFile) { %>
          <select name="limit" aria-label="Commandes par page">
            <% [20, 50, 100].forEach(function (n) { %>
              <option value="<%= n %>"<%= Number(_filters.limit || 20) === n ? ' selected' : '' %>><%= n %> par page</option>
            <% }) %>
          </select>
        <% } %>
      </div>
    </form>

    <div class="cmd-vues">
      <a href="/admin/commandes" class="cmd-vue<%= isActiveView ? ' is-active' : '' %>">Commandes actives</a>
      <a href="/admin/commandes?status=draft" class="cmd-vue<%= isDraftView ? ' is-active' : '' %>">Brouillons<% if (_draftsCount > 0) { %><span class="cmd-pastille"><%= _draftsCount %></span><% } %></a>
      <a href="/admin/commandes?view=archived" class="cmd-vue<%= isArchivedView ? ' is-active' : '' %>"><span class="ms" aria-hidden="true">inventory_2</span>Archivées<% if (_archivedCount > 0) { %><span class="cmd-pastille"><%= _archivedCount %></span><% } %></a>
      <a href="/admin/commandes?view=trash" class="cmd-vue<%= isTrashView ? ' is-active is-danger' : '' %>"><span class="ms" aria-hidden="true">delete</span>Corbeille<% if (_trashCount > 0) { %><span class="cmd-pastille"><%= _trashCount %></span><% } %></a>
    </div>

    <div class="cmd-tableau" role="table" aria-label="<%= _titreTableau %>">
      <div class="cmd-tableau-tete">
        <div class="cmd-tableau-titre"><%= _titreTableau %></div>
        <div class="cmd-tableau-compte" data-compte-lignes><%= _nbLignes %> commande<%= _nbLignes > 1 ? 's' : '' %></div>
        <% if (isActiveView) { %>
          <%/* Par-dessus l'en-tête, pas au-dessus du tableau : cocher une case ne
              décale aucune ligne (sinon le clic suivant tombe à côté). */%>
          <div class="cmd-selection" id="cmdSelection" hidden>
            <button type="button" class="cmd-act" data-groupe="avancer"><span class="ms" aria-hidden="true">done_all</span>Avancer d’une étape</button>
            <button type="button" class="cmd-bouton is-petit" data-groupe="etiquettes"><span class="ms" aria-hidden="true">print</span>Imprimer les étiquettes</button>
            <button type="button" class="cmd-bouton is-petit is-avis" data-groupe="avis"><span class="ms" aria-hidden="true">reviews</span>Demander un avis</button>
            <button type="button" class="cmd-bouton is-petit is-danger" data-groupe="corbeille" title="Met à la corbeille, restaurable 30 jours"><span class="ms" aria-hidden="true">delete</span>Supprimer</button>
            <span class="cmd-selection-n" data-selection-n>0 sélectionnée</span>
          </div>
        <% } %>
      </div>

      <div class="cmd-grille cmd-colonnes" role="row">
        <div class="cmd-c cmd-c-check" role="columnheader">
          <% if (isActiveView) { %><input type="checkbox" id="cmdToutCocher" aria-label="Tout sélectionner" /><% } %>
        </div>
        <div class="cmd-c" role="columnheader">Commande</div>
        <div class="cmd-c" role="columnheader">Client</div>
        <div class="cmd-c" role="columnheader">Pièces</div>
        <div class="cmd-c" role="columnheader">Statut</div>
        <div class="cmd-c" role="columnheader">Appro pièce</div>
        <div class="cmd-c cmd-c-actions" role="columnheader">Actions</div>
      </div>

      <div class="cmd-lignes" id="cmdLignes" role="rowgroup">
        <% (orders || []).forEach(function (o) { %>
          <%- include('./partials/commande-ligne', { o: o, contexteListe: { vue: _vueLigne, fileActive: _fileActive, returnTo: _returnTo } }) %>
        <% }) %>
      </div>

      <% if (!dbConnected) { %>
        <div class="cmd-vide">
          <span class="ms is-attention" aria-hidden="true">cloud_off</span>
          <p class="cmd-vide-titre">Base de données indisponible</p>
          <p class="cmd-vide-texte">La liste des commandes reviendra dès que la base répond.</p>
        </div>
      <% } else { %>
        <div class="cmd-vide" id="cmdVide"<%= (orders || []).length ? ' hidden' : '' %>>
          <% if (_enFile) { %>
            <span class="ms" aria-hidden="true">task_alt</span>
            <p class="cmd-vide-titre">Rien à traiter dans cette file</p>
            <p class="cmd-vide-texte">Passe à la file suivante, tout est à jour ici.</p>
          <% } else { %>
            <span class="ms is-neutre" aria-hidden="true">inbox</span>
            <p class="cmd-vide-titre">Aucune commande</p>
            <p class="cmd-vide-texte"><%= _nbFiltres || _filters.q ? 'Aucune commande ne correspond à cette recherche.' : 'Les commandes apparaîtront ici.' %></p>
          <% } %>
        </div>
        <div class="cmd-vide" id="cmdVideRecherche" hidden>
          <span class="ms is-neutre" aria-hidden="true">search_off</span>
          <p class="cmd-vide-titre">Aucune commande de cette liste ne correspond</p>
          <p class="cmd-vide-texte">Appuie sur Entrée pour chercher dans toutes les commandes.</p>
        </div>
      <% } %>

      <% if (!_enFile && _pagination.totalPages > 1) { %>
        <%
          const _base = '/admin/commandes?' + _qp.filter(function (p) { return p.indexOf('page=') !== 0; }).concat(Number(_filters.limit || 20) !== 20 ? ['limit=' + _filters.limit] : []).join('&');
          const _url = function (p) { return _base + (_base.slice(-1) === '?' ? '' : '&') + 'page=' + p; };
          const _items = (function (cur, tot) {
            if (tot <= 7) { const r = []; for (let i = 1; i <= tot; i++) r.push({ type: 'page', page: i }); return r; }
            const lo = Math.max(2, cur - 1); const hi = Math.min(tot - 1, cur + 1);
            const r = [{ type: 'page', page: 1 }];
            if (lo > 2) r.push({ type: 'ellipsis' });
            for (let p = lo; p <= hi; p++) r.push({ type: 'page', page: p });
            if (hi < tot - 1) r.push({ type: 'ellipsis' });
            r.push({ type: 'page', page: tot });
            return r;
          })(_pagination.page, _pagination.totalPages);
          const _urls = {}; _items.forEach(function (i) { if (i.type === 'page') _urls[i.page] = _url(i.page); });
        %>
        <div class="cmd-pagination">
          <%- include('./partials/pagination', { pb: { pagination: _pagination, totalLabel: _pagination.totalItems + ' commande' + (_pagination.totalItems > 1 ? 's' : ''), pageItems: _items, pageUrls: _urls, prevUrl: _url(_pagination.prevPage), nextUrl: _url(_pagination.nextPage) } }) %>
        </div>
      <% } %>
    </div>

    <% if (isActiveView && dbConnected) { %>
      <div class="cmd-clavier" aria-label="Raccourcis clavier">
        <span><kbd>/</kbd>rechercher</span>
        <span><kbd>J</kbd><kbd>K</kbd>naviguer</span>
        <span><kbd>Entrée</kbd>ouvrir le panneau</span>
        <span><kbd>A</kbd>action suivante</span>
        <span><kbd>Échap</kbd>fermer</span>
      </div>
    <% } %>
  </div>

  <% if (isActiveView) { %>
    <div class="cmd-voile" id="cmdVoile" hidden></div>
    <aside class="cmd-panneau" id="cmdPanneau" aria-labelledby="cmdPanneauTitre" role="dialog" aria-modal="false" hidden>
      <div class="cmd-panneau-tete">
        <div>
          <div class="cmd-panneau-titre-l">
            <h2 id="cmdPanneauTitre" data-p="number"></h2>
            <span class="cmd-statut" data-p="statut"></span>
          </div>
          <p class="cmd-panneau-sous" data-p="subline"></p>
        </div>
        <button type="button" class="cmd-ico" data-fermer aria-label="Fermer le panneau"><span class="ms" aria-hidden="true">close</span></button>
      </div>

      <div class="cmd-panneau-corps" data-p="corps"></div>

      <div class="cmd-panneau-pied">
        <button type="button" class="cmd-bouton is-petit" data-panneau-nav="-1"><span class="ms" aria-hidden="true">keyboard_arrow_up</span>Précédente</button>
        <div class="cmd-panneau-pied-c">
          <span class="cmd-panneau-position" data-p="position"></span>
          <button type="button" class="cmd-bouton is-primaire" data-p="primaire" hidden></button>
        </div>
        <button type="button" class="cmd-bouton is-petit" data-panneau-nav="1">Suivante<span class="ms" aria-hidden="true">keyboard_arrow_down</span></button>
      </div>
    </aside>
  <% } %>

  <div class="cmd-toast" id="cmdToast" role="status" aria-live="polite" hidden>
    <span class="ms" data-toast-icone aria-hidden="true">check_circle</span>
    <span data-toast-texte></span>
    <button type="button" class="cmd-toast-annuler" data-toast-annuler hidden><span class="ms" aria-hidden="true">undo</span>Annuler</button>
  </div>
</main>

<script>
  (function () {
    var sk = document.getElementById('page-skeleton');
    function reveler() { if (!sk) return; sk.classList.add('is-hidden'); setTimeout(function () { sk.remove(); }, 200); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveler); else reveler();
  })();
</script>
<script src="/js/admin-commandes.js?v=<%= (typeof assetVersions !== 'undefined' && assetVersions.adminCommandesJs) || '' %>" defer></script>

<%- include('./partials/footer') %>

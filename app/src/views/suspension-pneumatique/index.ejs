<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%/*
  Landing « Suspension pneumatique » — refonte nov. 2026.
  Page de pub Google Ads (mobile d'abord) : le formulaire doit arriver vite, la pièce
  cherchée doit se voir tout de suite, et chaque preuve doit être vraie.
  - ?piece=ressort|jambe|compresseur|bloc_valves&vehicule=<clé> : titre et pièce
    préremplis selon l'annonce (listes fermées dans le contrôleur, buildHero).
  - Images de pièces et d'atelier : illustrations générées par IA, présentées
    comme telles (légendes). Les seules photos « réelles » sont celles de
    /images/temoignages, légendées comme photos de l'activité Autoliva.
*/%>
<%
  var _hero = (typeof hero !== 'undefined' && hero) ? hero : null;
  var _heroImg = _hero && _hero.image ? _hero.image : '';
  var _vehicules = (typeof vehicules !== 'undefined' && Array.isArray(vehicules)) ? vehicules : [];
  var _img = '/images/suspension/';
  var _pieces = [
    { key: 'ressort', img: 'ressort', title: 'Ressorts pneumatiques', desc: 'Coussins et soufflets d’air, avant ou arrière, selon votre véhicule.' },
    { key: 'jambe', img: 'jambe', title: 'Jambes pneumatiques', desc: 'Jambes et amortisseurs complets, avec ou sans amortissement piloté.' },
    { key: 'compresseur', img: 'compresseur', title: 'Compresseurs', desc: 'Compresseurs et blocs d’alimentation en air, avec leur support.' },
    { key: 'bloc_valves', img: 'valves', title: 'Blocs de valves', desc: 'Blocs qui répartissent l’air vers chaque roue.' }
  ];
  var _ico = {
    check: 'M5 13l4 4L19 7',
    phone: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11 11 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
    arrow: 'M14 5l7 7m0 0l-7 7m7-7H3',
    chev: 'M19 9l-7 7-7-7'
  };
%>

<style>
  html { scroll-behavior: smooth; }
  /* Anti-zoom iOS Safari : un champ < 16px déclenche un zoom auto au focus. */
  @media (max-width: 1023px) {
    input:not([type="radio"]):not([type="checkbox"]), select, textarea { font-size: 16px !important; }
  }
  /* Bandeau d'images (mobile) : fond des photos fondu dans le bleu du haut de page. */
  .sp-fade { -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, #000 70%, transparent 100%); mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, #000 70%, transparent 100%); }
  #formulaire, #quote-form { scroll-margin-top: 84px; }
</style>

<!-- ═══════════ 1. HAUT DE PAGE : offre + formulaire ═══════════ -->
<section class="bg-brand-dark text-white">
<div class="max-w-[1260px] mx-auto px-5 sm:px-8 pt-6 pb-10 lg:pt-14 lg:pb-16 grid grid-cols-1 lg:grid-cols-12 gap-y-6 lg:gap-x-12 lg:items-start">

<div class="lg:col-span-7">
<p class="text-brand-red font-bold text-xs tracking-wider uppercase mb-2"><%= copy.eyebrow %></p>
<div class="flex items-start gap-4">
<h1 class="flex-1 text-[27px] leading-[1.15] sm:text-4xl lg:text-5xl font-bold tracking-tight">
<% if (_hero) { %><%= _hero.title %> <span class="block text-brand-red text-xl sm:text-2xl lg:text-3xl mt-1.5"><%= _hero.accent %></span><% } else { %><%- copy.h1Html %><% } %>
</h1>
<% if (_heroImg) { %>
<img src="<%= _img + _heroImg %>-carre-240.webp" alt="" width="240" height="240" class="lg:hidden w-[84px] h-[84px] rounded-xl border border-white/10 object-cover shrink-0" fetchpriority="high">
<% } %>
</div>
<p class="text-brand-textgray text-[15px] lg:text-lg mt-3 max-w-xl"><% if (_hero && _hero.vehicule) { %>On vérifie la référence exacte pour votre <%= _hero.vehicule %> avec votre plaque ou votre VIN, avant toute commande.<% } else { %><%= copy.sub %><% } %></p>
<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5 text-[13px] lg:text-sm font-medium text-white/90">
<% ['Compatibilité vérifiée', 'Devis sous 24 h ouvrées', 'Garantie 2 ans', 'Sans engagement'].forEach(function (t) { %>
<li class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="<%= _ico.check %>" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg><%= t %></li>
<% }) %>
</ul>
<% if (!_heroImg) { %>
<!-- Mobile : petit bandeau des 4 pièces -->
<img src="<%= _img %>gamme-960.webp" alt="Ressort, jambe, compresseur et bloc de valves de suspension pneumatique" width="960" height="503" class="lg:hidden sp-fade mt-3 w-full h-[130px] object-contain" fetchpriority="high">
<% } %>
<!-- Ordinateur : grande image de la gamme -->
<figure class="hidden lg:block mt-8">
<img src="<%= _img %>gamme-1600.webp" srcset="<%= _img %>gamme-960.webp 960w, <%= _img %>gamme-1600.webp 1600w" sizes="(min-width:1024px) 700px, 100vw" alt="Ressort, jambe, compresseur et bloc de valves de suspension pneumatique" width="1600" height="839" class="w-full h-auto rounded-2xl border border-white/10">
<figcaption class="mt-2 text-[11px] text-white/40">Illustration. La pièce exacte (référence, côté, version) est confirmée sur votre devis.</figcaption>
</figure>
</div>

<div id="formulaire" class="lg:col-span-5 lg:sticky lg:top-24">
<div id="quote-form" class="bg-white rounded-2xl p-5 sm:p-7 shadow-2xl text-gray-800">

<% if (successMessage) { %>
<h2 class="text-2xl font-bold mb-2">Demande envoyée ✓</h2>
<div class="rounded-lg bg-emerald-50 border border-emerald-200 p-4 text-emerald-900 mt-4">
<p class="text-sm"><%= successMessage %></p>
</div>
<p class="text-sm text-gray-500 mt-4">Une question d’ici là ? <a class="font-semibold text-brand-red" href="tel:<%= brand.PHONE_MOTEUR_INTL %>"><%= brand.PHONE_MOTEUR %></a></p>
<% } else { %>

<div class="mb-5">
<div class="flex items-center justify-between mb-2.5">
<h2 class="text-xl sm:text-2xl font-bold">Votre devis gratuit</h2>
<span class="text-xs font-semibold text-gray-400 tabular-nums" data-step-counter>1 / 2</span>
</div>
<div class="flex items-center gap-2">
<div class="flex-1 h-1.5 rounded-full bg-brand-red transition-all" data-step-bar="1"></div>
<div class="flex-1 h-1.5 rounded-full bg-gray-200 transition-all" data-step-bar="2"></div>
</div>
<p class="text-sm text-gray-500 mt-2.5" data-step-subtitle>Étape 1 — Votre véhicule et votre pièce</p>
</div>

<% if (errorMessage) { %>
<div class="rounded-lg bg-red-50 border border-red-200 p-3 mb-4 text-red-800 text-sm"><%= errorMessage %></div>
<% } %>

<form id="quote-multistep" class="space-y-5" action="<%= copy.formAction %>" method="post" novalidate>
<input type="text" name="website" value="" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true">

<!-- ─────── ÉTAPE 1 : VÉHICULE + PIÈCE ─────── -->
<div data-step="1" class="space-y-5">
<div>
<label for="sp-plate" class="block text-sm font-semibold text-gray-800 mb-1.5">Plaque, VIN ou référence de la pièce</label>
<input id="sp-plate" type="text" name="plate" required value="<%= form.plate || '' %>" data-step1-field autocomplete="off" autocapitalize="characters" class="w-full rounded-xl border-gray-300 px-4 py-3 text-base focus:border-brand-red focus:ring-brand-red/30" placeholder="AB-123-CD">
<p class="text-xs text-gray-500 mt-1.5">Une seule suffit. Pas sous la main ? Écrivez la marque et le modèle (ex. ML W164 2008).</p>
</div>

<div>
<p class="text-sm font-semibold text-gray-800 mb-2" id="sp-part-label">Pièce recherchée</p>
<div class="grid grid-cols-2 gap-2" role="radiogroup" aria-labelledby="sp-part-label">
<% var ptKeys = Object.keys(partTypes); %>
<% ptKeys.forEach(function (key, i) { %>
<label class="cursor-pointer<%= (i === ptKeys.length - 1 && ptKeys.length % 2 === 1) ? ' col-span-2' : '' %>">
<input type="radio" name="partType" value="<%= key %>" class="peer sr-only" <%= form.partType === key ? 'checked' : '' %>>
<span class="block text-center text-[13px] font-semibold border border-gray-300 rounded-lg py-2.5 px-1.5 text-gray-700 peer-checked:border-brand-red peer-checked:bg-brand-red/5 peer-checked:text-brand-red peer-focus-visible:ring-2 peer-focus-visible:ring-brand-red/40 transition"><%= partTypes[key] %></span>
</label>
<% }) %>
</div>
</div>

<button type="button" data-step1-next class="w-full bg-brand-red hover:bg-brand-redhover text-white font-bold py-3.5 rounded-xl flex justify-center items-center gap-2 transition">
Continuer
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="<%= _ico.arrow %>" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
</button>
<p data-step1-error class="text-xs text-red-600 text-center hidden">Merci d’indiquer votre plaque, votre VIN, une référence ou la marque et le modèle.</p>
<p class="text-xs text-gray-500 text-center">Ensuite, votre téléphone : Lucas vous rappelle pour confirmer la référence et vous envoyer le devis.</p>
</div>

<!-- ─────── ÉTAPE 2 : COORDONNÉES ─────── -->
<div data-step="2" class="space-y-4 hidden">
<div>
<label for="sp-phone" class="block text-sm font-semibold text-gray-800 mb-1.5">Téléphone</label>
<input id="sp-phone" type="tel" name="phone" required value="<%= form.phone || '' %>" data-step2-field autocomplete="tel" inputmode="tel" class="w-full rounded-xl border-gray-300 px-4 py-3 text-base focus:border-brand-red focus:ring-brand-red/30" placeholder="06 12 34 56 78">
<p class="text-xs text-gray-500 mt-1.5">Lucas vous rappelle pour confirmer la référence et vous présenter le devis. Pas de démarchage.</p>
</div>
<div>
<label for="sp-email" class="block text-sm font-semibold text-gray-800 mb-1.5">Email <span class="font-normal text-gray-400">(pour recevoir le devis, facultatif)</span></label>
<input id="sp-email" type="email" name="email" value="<%= form.email || '' %>" autocomplete="email" inputmode="email" class="w-full rounded-xl border-gray-300 px-4 py-3 text-base focus:border-brand-red focus:ring-brand-red/30" placeholder="nom@exemple.fr">
</div>
<div>
<label for="sp-name" class="block text-sm font-semibold text-gray-800 mb-1.5">Nom <span class="font-normal text-gray-400">(facultatif)</span></label>
<input id="sp-name" type="text" name="fullName" value="<%= form.fullName || '' %>" autocomplete="name" class="w-full rounded-xl border-gray-300 px-4 py-3 text-base focus:border-brand-red focus:ring-brand-red/30">
</div>

<div class="bg-gray-50 rounded-xl p-3 flex items-center justify-between text-xs">
<div class="flex items-center gap-2 text-gray-600 min-w-0">
<svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="<%= _ico.check %>" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"></path></svg>
<span data-step1-recap class="font-medium truncate"></span>
</div>
<button type="button" data-step2-back class="text-brand-red font-semibold hover:underline shrink-0 ml-2">Modifier</button>
</div>

<div class="flex items-stretch gap-2 pt-1">
<button type="button" data-step2-back class="px-4 border border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition text-sm flex items-center" aria-label="Retour">
<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 19l-7-7m0 0l7-7m-7 7h18" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
</button>
<button type="submit" class="flex-1 bg-brand-red hover:bg-brand-redhover text-white font-bold py-3.5 rounded-xl flex justify-center items-center gap-2 transition">
Envoyer ma demande de devis
</button>
</div>
<p class="text-[11px] text-gray-400 text-center">Vos coordonnées servent uniquement à traiter votre demande. <a class="underline" href="/legal/confidentialite">Confidentialité</a></p>
</div>
</form>

<script>
(function () {
  var form = document.getElementById('quote-multistep');
  if (!form) return;
  var step1 = form.querySelector('[data-step="1"]');
  var step2 = form.querySelector('[data-step="2"]');
  var nextBtn = form.querySelector('[data-step1-next]');
  var backBtns = form.querySelectorAll('[data-step2-back]');
  var plateInput = form.querySelector('input[name="plate"]');
  var phoneInput = form.querySelector('input[name="phone"]');
  var errMsg = form.querySelector('[data-step1-error]');
  var bar1 = document.querySelector('[data-step-bar="1"]');
  var bar2 = document.querySelector('[data-step-bar="2"]');
  var counter = document.querySelector('[data-step-counter]');
  var subtitle = document.querySelector('[data-step-subtitle]');
  var recap = form.querySelector('[data-step1-recap]');

  // ── Tracking funnel (GTM dataLayer) ──
  window.dataLayer = window.dataLayer || [];
  function track(ev, extra) {
    try { window.dataLayer.push(Object.assign({ event: ev, funnel: '<%= copy.funnelName %>' }, extra || {})); } catch (e) {}
  }
  var _formStarted = false;
  form.addEventListener('focusin', function () {
    if (_formStarted) return;
    _formStarted = true;
    track('form_start');
  });

  function partLabel() {
    var r = form.querySelector('input[name="partType"]:checked');
    if (!r) return '';
    var s = r.parentNode.querySelector('span');
    return s ? s.textContent.trim() : '';
  }

  function goStep(n, focus) {
    if (n === 1) {
      step1.classList.remove('hidden'); step2.classList.add('hidden');
      bar2.classList.remove('bg-brand-red'); bar2.classList.add('bg-gray-200');
      if (counter) counter.textContent = '1 / 2';
      if (subtitle) subtitle.textContent = 'Étape 1 — Votre véhicule et votre pièce';
      if (focus !== false) setTimeout(function(){ plateInput && plateInput.focus(); }, 50);
    } else {
      step1.classList.add('hidden'); step2.classList.remove('hidden');
      bar2.classList.add('bg-brand-red'); bar2.classList.remove('bg-gray-200');
      if (counter) counter.textContent = '2 / 2';
      if (subtitle) subtitle.textContent = 'Étape 2 — Comment vous joindre';
      track('funnel_step2_view');
      var plate = plateInput ? plateInput.value.trim() : '';
      var part = partLabel();
      if (recap) recap.textContent = (plate || 'Véhicule renseigné') + (part ? ' · ' + part : '');
      setTimeout(function(){ phoneInput && phoneInput.focus(); }, 50);
    }
  }
  window.__spGoStep = goStep;

  nextBtn.addEventListener('click', function () {
    if (!plateInput.value.trim()) {
      errMsg.classList.remove('hidden');
      plateInput.focus();
      return;
    }
    errMsg.classList.add('hidden');
    track('funnel_step1_complete', { part_type: (form.querySelector('input[name="partType"]:checked') || {}).value || '' });
    goStep(2);
  });
  plateInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); nextBtn.click(); }
  });

  backBtns.forEach(function (btn) {
    btn.addEventListener('click', function () { goStep(1); });
  });

  form.addEventListener('submit', function (e) {
    if (!plateInput.value.trim()) {
      e.preventDefault();
      goStep(1);
      errMsg.classList.remove('hidden');
      return;
    }
    if (!phoneInput.value.trim()) {
      e.preventDefault();
      goStep(2);
      phoneInput.focus();
    }
  });

  // Boutons « choisir cette pièce » plus bas dans la page : coche la pièce et remonte au formulaire.
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('[data-pick-part]') : null;
    if (!a) return;
    var key = a.getAttribute('data-pick-part');
    var r = form.querySelector('input[name="partType"][value="' + key + '"]');
    if (r) r.checked = true;
    goStep(1, false);
    track('part_pick', { part_type: key });
  });

  // Erreur serveur avec coordonnées déjà remplies : on reste à l'étape 2
  <% if (errorMessage && (form.phone || form.email || form.fullName)) { %>
  goStep(2);
  <% } %>
})();
</script>
<% } %>
</div>
</div>

</div>
</section>

<!-- ═══════════ 2. LES PIÈCES ═══════════ -->
<section class="bg-white py-12 lg:py-20 px-5 sm:px-8">
<div class="max-w-[1260px] mx-auto">
<h2 class="text-2xl lg:text-3xl font-bold text-gray-900">Quelle pièce recherchez-vous ?</h2>
<p class="text-gray-500 mt-2 max-w-2xl">Touchez une pièce : on la note dans votre demande.</p>
<div class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-5">
<% _pieces.forEach(function (p) { %>
<a href="#formulaire" data-pick-part="<%= p.key %>" data-cta="piece-<%= p.key %>" class="group rounded-2xl overflow-hidden bg-brand-dark border border-gray-200 hover:border-brand-red/60 hover:shadow-lg transition flex flex-col">
<img src="<%= _img + p.img %>-600.webp" alt="<%= p.title %> de suspension pneumatique (illustration)" width="600" height="448" loading="lazy" class="w-full aspect-[4/3] object-cover">
<div class="bg-white p-3 lg:p-4 flex-1 flex flex-col">
<h3 class="font-bold text-[15px] lg:text-base text-gray-900"><%= p.title %></h3>
<p class="hidden sm:block text-xs text-gray-500 mt-1 flex-1"><%= p.desc %></p>
<span class="mt-2 text-[13px] font-semibold text-brand-red inline-flex items-center gap-1">Demander un devis <svg class="w-3.5 h-3.5 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="<%= _ico.arrow %>" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg></span>
</div>
</a>
<% }) %>
</div>
<p class="text-[11px] text-gray-400 mt-3">Illustrations. La pièce exacte (référence, côté, version) est confirmée sur votre devis.</p>

<% if (_vehicules.length) { %>
<div class="mt-10 lg:mt-14">
<h3 class="text-lg lg:text-xl font-bold text-gray-900">Pour quel véhicule ?</h3>
<p class="text-sm text-gray-500 mt-1 max-w-3xl">Les modèles les plus demandés. Votre véhicule n’est pas dans la liste ? Faites quand même la demande : on cherche la référence pour vous.</p>
<ul class="mt-4 flex flex-wrap gap-2">
<% _vehicules.forEach(function (v) { %>
<li class="text-[13px] font-medium text-gray-700 bg-brand-gray border border-gray-200 rounded-full px-3 py-1.5"><%= v %></li>
<% }) %>
</ul>
<p class="text-xs text-gray-400 mt-3">La bonne pièce dépend de la version et des options du véhicule : on la confirme avec votre plaque, votre VIN ou la référence d’origine.</p>
</div>
<% } %>
</div>
</section>

<!-- ═══════════ 3. NEUF OU RECONDITIONNÉ ═══════════ -->
<section class="bg-brand-gray py-12 lg:py-20 px-5 sm:px-8 border-y border-gray-100">
<div class="max-w-[1260px] mx-auto">
<h2 class="text-2xl lg:text-3xl font-bold text-gray-900">Neuf ou reconditionné : que recevez-vous ?</h2>
<p class="text-gray-500 mt-2 max-w-2xl">Selon votre référence et la disponibilité, on vous propose l’un ou l’autre. Le devis dit clairement lequel.</p>

<div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
<div class="bg-white rounded-2xl border border-gray-200 p-5 lg:p-7">
<p class="text-xs font-bold uppercase tracking-wider text-brand-red">Pièce neuve</p>
<h3 class="text-lg font-bold mt-1 text-gray-900">Jamais montée, prête à poser</h3>
<ul class="mt-4 space-y-2.5 text-sm text-gray-600">
<% ['Pièce qui n’a jamais roulé', 'Référence et contenu (joints, clips, support) indiqués au devis', 'Pas d’ancienne pièce à renvoyer', 'Garantie 2 ans'].forEach(function (t) { %>
<li class="flex gap-2"><svg class="w-4 h-4 mt-0.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="<%= _ico.check %>" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg><%= t %></li>
<% }) %>
</ul>
</div>
<div class="bg-white rounded-2xl border border-gray-200 p-5 lg:p-7">
<p class="text-xs font-bold uppercase tracking-wider text-brand-red">Pièce reconditionnée</p>
<h3 class="text-lg font-bold mt-1 text-gray-900">Remise en état et testée</h3>
<ul class="mt-4 space-y-2.5 text-sm text-gray-600">
<li class="flex gap-2"><svg class="w-4 h-4 mt-0.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="<%= _ico.check %>" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg>Reconditionnée par un atelier partenaire certifié ISO 9001</li>
<% ['Pièces d’usure remplacées, étanchéité et fonctionnement testés avant expédition', 'En échange standard : une consigne, remboursée au retour de votre ancienne pièce', 'Garantie 2 ans'].forEach(function (t) { %>
<li class="flex gap-2"><svg class="w-4 h-4 mt-0.5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="<%= _ico.check %>" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path></svg><%= t %></li>
<% }) %>
</ul>
</div>
</div>

<div class="mt-6 grid grid-cols-2 gap-3 lg:gap-6">
<figure class="rounded-2xl overflow-hidden bg-gray-200">
<img src="<%= _img %>banc-900.webp" alt="Technicien contrôlant une jambe pneumatique sur un banc de test (illustration)" width="900" height="672" loading="lazy" class="w-full aspect-[4/3] object-cover">
</figure>
<figure class="rounded-2xl overflow-hidden bg-gray-200">
<img src="<%= _img %>etancheite-900.webp" alt="Contrôle d’étanchéité d’un ressort pneumatique sous pression (illustration)" width="900" height="672" loading="lazy" class="w-full aspect-[4/3] object-cover">
</figure>
</div>
<p class="text-[11px] text-gray-400 mt-2">Illustrations : test au banc et contrôle d’étanchéité, les étapes suivies pour une pièce reconditionnée.</p>


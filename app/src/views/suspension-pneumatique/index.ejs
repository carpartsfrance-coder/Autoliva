<!-- Barre d'action — apparaît quand le formulaire n'est plus visible -->
<% if (!successMessage) { %>
<div id="sticky-cta" class="opacity-0 pointer-events-none transition-opacity duration-300">
<div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur border-t border-gray-200 px-4 py-3 shadow-[0_-4px_20px_rgba(0,0,0,0.08)]">
<div class="flex gap-2">
<a href="#formulaire" data-cta="sticky-mobile" class="flex-1 inline-flex items-center justify-center bg-brand-red text-white font-bold py-3 rounded-xl text-sm">Demander mon devis gratuit</a>
<a href="tel:<%= brand.PHONE_MOTEUR_INTL %>" data-cta="sticky-call" class="inline-flex items-center justify-center gap-1.5 px-4 shrink-0 border-2 border-gray-200 text-gray-900 font-bold rounded-xl text-sm" aria-label="Appeler le <%= brand.PHONE_MOTEUR %>">
<svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="<%= _ico.phone %>" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path></svg>Appeler
</a>
</div>
</div>
<a href="#formulaire" data-cta="sticky-desktop" class="hidden lg:inline-flex fixed bottom-6 right-6 z-40 items-center gap-2 bg-brand-red hover:bg-brand-redhover text-white font-bold py-4 px-7 rounded-full shadow-xl shadow-brand-red/30 transition">Demander mon devis gratuit</a>
</div>
<script>
(function () {
  var sticky = document.getElementById('sticky-cta');
  var form = document.getElementById('quote-form');
  if (!sticky || !form) return;
  var typing = false;
  form.addEventListener('focusin', function () { typing = true; onScroll(); });
  form.addEventListener('focusout', function () { typing = false; setTimeout(onScroll, 50); });
  function onScroll() {
    var r = form.getBoundingClientRect();
    var visible = r.bottom > 80 && r.top < window.innerHeight;
    var show = !visible && !typing;
    sticky.classList.toggle('opacity-0', !show);
    sticky.classList.toggle('pointer-events-none', !show);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  onScroll();
})();
</script>

<!-- Tracking clics CTA (quel emplacement convertit le mieux) -->
<script>
(function () {
  window.dataLayer = window.dataLayer || [];
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest ? e.target.closest('a[data-cta]') : null;
    if (!a) return;
    try {
      window.dataLayer.push({
        event: 'cta_click',
        funnel: '<%= copy.funnelName %>',
        cta_location: a.getAttribute('data-cta') || 'unknown'
      });
    } catch (err) {}
  }, true);
})();
</script>
<% } %>

<!-- Confirmation lead : dataLayer (GTM) + conversion Google Ads (gtag, avec suivi avancé) -->
<% if (successMessage) { %>
<script>
(function () {
  var c = <%- JSON.stringify(typeof conversion !== 'undefined' && conversion ? conversion : null).replace(/</g, '\\u003c') %>;
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    event: 'lead_submitted',
    lead_source: '<%= copy.funnelName %>',
    lead_category: '<%= copy.leadCategory %>',
    lead_ref: (c && c.ref) || '',
    page_path: window.location.pathname
  });
  // Conversion Google Ads "Envoi form" — UNIQUEMENT pour un vrai lead (c.ref présent),
  // jamais pour le honeypot (faux succès bot). Suivi avancé : email + téléphone (E.164).
  if (c && c.ref && typeof gtag === 'function') {
    if (c.email || c.phone) {
      gtag('set', 'user_data', {
        email: c.email || undefined,
        phone_number: c.phone || undefined
      });
    }
    gtag('event', 'conversion', {
      send_to: 'AW-16778404215/kK_sCIiYu70bEPfCyMA-',
      value: c.value || 1.0,
      currency: 'EUR',
      transaction_id: c.ref
    });
  }
})();
</script>
<% } %>

